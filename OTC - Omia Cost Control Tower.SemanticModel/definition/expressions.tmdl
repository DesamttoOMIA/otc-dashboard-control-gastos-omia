expression stg_solicitud_de_pedido = ```
		let
		    Origen = Fact_solicitud_de_pedido,
		    Pendientes = Table.SelectRows(Origen, each 
		        [#"Status de la línea"] = "O"
		        and [Cancelado] = "N"
		        and [#"Línea cerrada manualmente"] = "N"
		        and [#"Clase de documento de destino"] = -1),
		    ConTipo = Table.AddColumn(Pendientes, "Tipo de documento", each "SOLPED", type text),
		    ConEstado = Table.AddColumn(ConTipo, "Estado", each "Pendiente por ordenar", type text),
		    ConOrden = Table.AddColumn(ConEstado, "Orden etapa", each 1, Int64.Type),
		    ConOrigen = Table.AddColumn(ConOrden, "SOLPED origen", each [#"Número de documento"]),
		    ConOC = Table.AddColumn(ConOrigen, "OC asociada", each null, Int64.Type),
		    ConFactura = Table.AddColumn(ConOC, "Factura asociada", each null, Int64.Type),
		    ConProveedor = Table.AddColumn(ConFactura, "Proveedor", each null, type text),
		    ConDias = Table.AddColumn(ConProveedor, "Días en la etapa", each Duration.Days(Date.From(DateTime.LocalNow()) - Date.From([#"Fecha de creación"])), Int64.Type),
		    Seleccion = Table.SelectColumns(ConDias, {
		        "Tipo de documento", "Estado", "Orden etapa",
		        "Número de documento", "SOLPED origen", "OC asociada", "Factura asociada",
		        "Fecha de creación", "Días en la etapa",
		        "Proveedor", "Número de artículo", "Descripción artículo/serv.",
		        "Cantidad", "Unidad", "Total líneas",
		        "Nombre de usuario",
		        "Código del cálculo del costo 3", "Código de proyecto",
		        "Fecha necesaria", "Prioridad", "Comprador", "Comentarios", "Adjudicacion Directa"}),
		    Renombradas = Table.RenameColumns(Seleccion, {
		        {"Número de documento", "N° documento"},
		        {"Fecha de creación", "Fecha documento"},
		        {"Número de artículo", "Artículo"},
		        {"Descripción artículo/serv.", "Descripción"},
		        {"Cantidad", "Cantidad pendiente"},
		        {"Total líneas", "Valor"},
		        {"Nombre de usuario", "Responsable"},
		        {"Código del cálculo del costo 3", "Subseco"},
		        {"Código de proyecto", "Proyecto"},
		        {"Comprador", "Comprador asignado"}}),
		    Tipos = Table.TransformColumnTypes(Renombradas, {
		        {"N° documento", Int64.Type}, {"SOLPED origen", Int64.Type},
		        {"Fecha documento", type date}, {"Fecha necesaria", type date},
		        {"Artículo", type text}, {"Descripción", type text}, {"Unidad", type text},
		        {"Cantidad pendiente", type number}, {"Valor", type number},
		        {"Responsable", type text}, {"Comprador asignado", type text},
		        {"Subseco", Int64.Type}, {"Proyecto", type text}})
		in
		    Tipos
		```
	lineageTag: 9bcb61f1-b80f-4172-a2ba-6832d98e31d1

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

expression stg_entrada_de_mercancia_factura_conformada =
		let
		    Origen = Fact_entrada_de_mercancia_factura_conformada,
		
		    // Marca si la EM viene sin orden de compra (factura conformada)
		    ConMarca = Table.AddColumn(Origen, "EsConformada",
		        each [#"Orden de Compra"] = null or [#"Orden de Compra"] = "", type logical),
		
		    // Conformadas (todas) + EM con OC abiertas y sin factura destino
		    Filtradas = Table.SelectRows(ConMarca, each
		        [EsConformada]
		        or ([#"Status de documento"] = "O" and [#"Clase de documento de destino"] = -1)),
		
		    ConTipo = Table.AddColumn(Filtradas, "Tipo de documento",
		        each if [EsConformada] then "Factura conformada" else "Entrada de mercancía", type text),
		    ConEstado = Table.AddColumn(ConTipo, "Estado",
		        each if [EsConformada] then "Recibido sin OC" else "Pendiente por facturar", type text),
		    ConOrden = Table.AddColumn(ConEstado, "Orden etapa",
		        each if [EsConformada] then 3 else 4, Int64.Type),
		
		    ConOC = Table.AddColumn(ConOrden, "OC asociada",
		        each if [EsConformada] then null else [#"Orden de Compra"]),
		    ConFactura = Table.AddColumn(ConOC, "Factura asociada", each null, Int64.Type),
		
		    ConDias = Table.AddColumn(ConFactura, "Días en la etapa",
		        each Duration.Days(Date.From(DateTime.LocalNow()) - Date.From([#"Fecha de contabilización"])), Int64.Type),
		
		    Seleccion = Table.SelectColumns(ConDias, {
		        "Tipo de documento", "Estado", "Orden etapa",
		        "Entrada mercancías", "Solicitud de compra", "OC asociada", "Factura asociada",
		        "Fecha de contabilización", "Días en la etapa",
		        "Nombre de cliente/proveedor", "Número de artículo", "Descripción artículo/serv.",
		        "Cantidad", "Unidad", "Total líneas",
		        "Creador EM",
		        "Código del cálculo del costo 3", "Proyecto",
		        "Código de cuenta", "Comentarios"
		    }),
		
		    Renombradas = Table.RenameColumns(Seleccion, {
		        {"Entrada mercancías", "N° documento"},
		        {"Solicitud de compra", "SOLPED origen"},
		        {"Fecha de contabilización", "Fecha documento"},
		        {"Nombre de cliente/proveedor", "Proveedor"},
		        {"Número de artículo", "Artículo"},
		        {"Descripción artículo/serv.", "Descripción"},
		        {"Cantidad", "Cantidad pendiente"},
		        {"Total líneas", "Valor"},
		        {"Creador EM", "Responsable"},
		        {"Código del cálculo del costo 3", "Subseco"}
		    }),
		
		    Tipos = Table.TransformColumnTypes(Renombradas, {
		        {"N° documento", Int64.Type}, {"SOLPED origen", Int64.Type}, {"OC asociada", Int64.Type},
		        {"Fecha documento", type date},
		        {"Proveedor", type text}, {"Artículo", type text}, {"Descripción", type text}, {"Unidad", type text},
		        {"Cantidad pendiente", type number}, {"Valor", type number},
		        {"Responsable", type text}, {"Subseco", Int64.Type}, {"Proyecto", type text},
		        {"Código de cuenta", type text}
		    }),
		    #"Filas filtradas" = Table.SelectRows(Tipos, each true)
		in
		    #"Filas filtradas"
	lineageTag: 067ea0f1-1236-4422-ae39-c9d3ae10c7d6

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

expression stg_orden_de_compra =
		let
		    Origen = Fact_ordenes_de_compra,
		
		    // Solo líneas de OC con saldo pendiente por recibir
		    Abiertas = Table.SelectRows(Origen, each [#"Status de la línea"] = "O"),
		
		    // Valor pendiente = cantidad abierta × precio (saldo real, incluye recepciones parciales)
		    ConValor = Table.AddColumn(Abiertas, "Valor", each [#"Cantidad abierta restante"] * [Precio], type number),
		
		    // Columnas de clasificación
		    ConTipo   = Table.AddColumn(ConValor,  "Tipo de documento", each "Orden de compra", type text),
		    ConEstado = Table.AddColumn(ConTipo,   "Estado", each "Pendiente por recibir", type text),
		    ConOrden  = Table.AddColumn(ConEstado, "Orden etapa", each 2, Int64.Type),
		
		    // Trazabilidad: la OC es su propia "OC asociada"; aún no tiene factura
		    ConOC      = Table.AddColumn(ConOrden, "OC asociada", each [#"Número de documento"]),
		    ConFactura = Table.AddColumn(ConOC, "Factura asociada", each null, Int64.Type),
		
		    // Días desde que se creó la OC hasta hoy (se recalcula en cada actualización)
		    ConDias = Table.AddColumn(ConFactura, "Días en la etapa",
		        each Duration.Days(Date.From(DateTime.LocalNow()) - Date.From([#"Fecha de creación"])), Int64.Type),
		
		    // Columnas comunes + columnas propias para el tooltip
		    Seleccion = Table.SelectColumns(ConDias, {
		        "Tipo de documento", "Estado", "Orden etapa",
		        "Número de documento", "No. Solped", "OC asociada", "Factura asociada",
		        "Fecha de creación", "Días en la etapa",
		        "Nombre de cliente/proveedor", "Número de artículo", "Descripción artículo/serv.",
		        "Cantidad abierta restante", "Unidad", "Valor",
		        "Nombre de empleado del departamento de ventas",
		        "Código del cálculo del costo 3", "Código de proyecto",
		        "Fecha de entrega de la línea", "Código de condiciones de pago_1", "Número Cto Marco",
		        "Tipo de OC (Uso Exclusivo de A&L-OC)", "Ind.: Días p/ entrega Prov.", "Indic.:% Entrega",
		        "Comentarios"
		    }),
		
		    Renombradas = Table.RenameColumns(Seleccion, {
		        {"Número de documento", "N° documento"},
		        {"No. Solped", "SOLPED origen"},
		        {"Fecha de creación", "Fecha documento"},
		        {"Nombre de cliente/proveedor", "Proveedor"},
		        {"Número de artículo", "Artículo"},
		        {"Descripción artículo/serv.", "Descripción"},
		        {"Cantidad abierta restante", "Cantidad pendiente"},
		        {"Nombre de empleado del departamento de ventas", "Responsable"},
		        {"Código del cálculo del costo 3", "Subseco"},
		        {"Código de proyecto", "Proyecto"},
		        {"Fecha de entrega de la línea", "Fecha entrega OC"},
		        {"Código de condiciones de pago_1", "Condiciones de pago"},
		        {"Número Cto Marco", "Contrato marco"},
		        {"Tipo de OC (Uso Exclusivo de A&L-OC)", "Tipo de OC"},
		        {"Ind.: Días p/ entrega Prov.", "Días para entrega proveedor"},
		        {"Indic.:% Entrega", "% entrega"}
		    }),
		
		    Tipos = Table.TransformColumnTypes(Renombradas, {
		        {"N° documento", Int64.Type}, {"SOLPED origen", Int64.Type}, {"OC asociada", Int64.Type},
		        {"Fecha documento", type date}, {"Fecha entrega OC", type date},
		        {"Artículo", type text}, {"Cantidad pendiente", type number},
		        {"Subseco", Int64.Type}, {"Proyecto", type text}, {"Responsable", type text},
		        {"Proveedor", type text}, {"Descripción", type text}, {"Unidad", type text}
		    })
		in
		    Tipos
	lineageTag: 8d791f10-6b96-4132-98ef-ee0915ecaf0c

