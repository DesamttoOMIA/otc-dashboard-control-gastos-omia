expression 'Errores en Fact_ordenes_de_compra' =
		let
		Origen = Fact_ordenes_de_compra,
		    #"Tipo cambiado1" = Table.TransformColumnTypes(Origen,{{"Código de condiciones de pago_1", type text}}),
		  #"Errores de coincidencia detectados" = let
