expression stg_solped_oc_fc_em_fp_pe =
		let
		    Origen = Fact_stg_solped_oc_fc_em_fp_pe,
		
		    // Solo líneas que ya tienen factura de proveedor
		    ConFactura = Table.SelectRows(Origen, each
		        [#"No.Factura SAP"] <> null and [#"No.Factura SAP"] <> ""),
		
		    // Marca si la factura ya fue pagada
		    ConMarca = Table.AddColumn(ConFactura, "EsPagada",
		        each [#"No. Pago SAP"] <> null and [#"No. Pago SAP"] <> "", type logical),
		
		    ConTipo = Table.AddColumn(ConMarca, "Tipo de documento",
		        each if [EsPagada] then "Pago efectuado" else "Factura de proveedor", type text),
		    ConEstado = Table.AddColumn(ConTipo, "Estado",
		        each if [EsPagada] then "Desembolsado" else "Pendiente por pagar", type text),
		    ConOrden = Table.AddColumn(ConEstado, "Orden etapa",
		        each if [EsPagada] then 6 else 5, Int64.Type),
		
		    // Documento y fecha según la etapa
		    ConDoc = Table.AddColumn(ConOrden, "N° documento",
		        each if [EsPagada] then [#"No. Pago SAP"] else [#"No.Factura SAP"]),
		    ConFecha = Table.AddColumn(ConDoc, "Fecha documento",
		        each if [EsPagada] then [#"Fecha de contabilización"] else [#"Fecha de creación_20"]),
		    ConDias = Table.AddColumn(ConFecha, "Días en la etapa",
		        each Duration.Days(Date.From(DateTime.LocalNow()) - Date.From([Fecha documento])), Int64.Type),
		    ConResp = Table.AddColumn(ConDias, "Responsable", each null, type text),
		
		    Seleccion = Table.SelectColumns(ConResp, {
		        "Tipo de documento", "Estado", "Orden etapa",
		        "N° documento", "No. Solped", "No. Orden de Compra", "No.Factura SAP",
		        "Fecha documento", "Días en la etapa",
		        "Nombre de cliente/proveedor", "Número de artículo_14", "Descripción artículo/serv._15",
		        "Cantidad_16", "Unidad_17", "Total líneas_19",
		        "Responsable",
		        "Subceco SC", "Código Proyecto SC",
		        "Código de condiciones de pago"
		    }),
		
		    Renombradas = Table.RenameColumns(Seleccion, {
		        {"No. Solped", "SOLPED origen"},
		        {"No. Orden de Compra", "OC asociada"},
		        {"No.Factura SAP", "Factura asociada"},
		        {"Nombre de cliente/proveedor", "Proveedor"},
		        {"Número de artículo_14", "Artículo"},
		        {"Descripción artículo/serv._15", "Descripción"},
		        {"Cantidad_16", "Cantidad pendiente"},
		        {"Unidad_17", "Unidad"},
		        {"Total líneas_19", "Valor"},
		        {"Subceco SC", "Subseco"},
		        {"Código Proyecto SC", "Proyecto"},
		        {"Código de condiciones de pago", "Condiciones de pago"}
		    }),
		
		    Tipos = Table.TransformColumnTypes(Renombradas, {
		        {"N° documento", Int64.Type}, {"SOLPED origen", Int64.Type},
		        {"OC asociada", Int64.Type}, {"Factura asociada", Int64.Type},
		        {"Fecha documento", type date},
		        {"Proveedor", type text}, {"Artículo", type text}, {"Descripción", type text}, {"Unidad", type text},
		        {"Cantidad pendiente", type number}, {"Valor", type number},
		        {"Subseco", Int64.Type}, {"Proyecto", type text},
		        {"Condiciones de pago", type text}
		    })
		in
		    Tipos
	lineageTag: 1a1c924f-8677-4f1b-8fba-a27a802d280f

