	partition Dim_proyecto = m
		mode: import
		source =
				let
				    Origen = Excel.Workbook(Web.Contents("https://omiacolombia.sharepoint.com/sites/sgdingenieriamantenimiento/Documentos%20compartidos/2.Documentos%20Compartidos/Proyecto%20control%20de%20gastos/Lista%20de%20Proyectos%20(1).xlsx"), null, true),
				    Tabla = Origen{[Item="Tabla1",Kind="Table"]}[Data],
				    #"Tipo cambiado" = Table.TransformColumnTypes(Tabla,{
				        {"Id proyecto", Int64.Type}, {"Código de proyecto", type text}, {"Nombre de proyecto", type text},
				        {"Fecha inicio contrato", type date}, {"Plazo meses", Int64.Type}}),
				    #"Nombre conservado" = Table.RenameColumns(#"Tipo cambiado", {{"Fecha inicio contrato", "FechaInicioContrato"}}),
				    #"Fecha fin contrato" = Table.AddColumn(#"Nombre conservado", "FechaFinContrato", each
				        if [FechaInicioContrato] = null or [Plazo meses] = null then null
				        else Date.AddDays(Date.AddMonths([FechaInicioContrato], [Plazo meses]), -1), type nullable date)
				in
				    #"Fecha fin contrato"

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

