	partition Dim_proyecto = m
		mode: import
		source =
				let
				    Origen = Excel.Workbook(Web.Contents("https://omiacolombia.sharepoint.com/sites/sgdingenieriamantenimiento/Documentos%20compartidos/2.Documentos%20Compartidos/Proyecto%20control%20de%20gastos/Lista%20de%20Proyectos%20(1).xlsx"), null, true),
				    Sheet1_Sheet = Origen{[Item="Sheet1",Kind="Sheet"]}[Data],
				    #"Encabezados promovidos" = Table.PromoteHeaders(Sheet1_Sheet, [PromoteAllScalars=true]),
				    #"Tipo cambiado" = Table.TransformColumnTypes(#"Encabezados promovidos",{{"Id proyecto", Int64.Type}, {"Código de proyecto", type text}, {"Nombre de proyecto", type text}}),
				    #"Filas filtradas" = Table.SelectRows(#"Tipo cambiado", each true),
				    #"Columna agregada FechaInicioContrato" = Table.AddColumn(#"Filas filtradas", "FechaInicioContrato", each
				        if [Código de proyecto] = "COOGO&MNDTPL5361" then #date(2026, 8, 1)
				        else if [Código de proyecto] = "COMIMANCCCG5058" then #date(2025, 12, 1)
				        else null, type nullable date)
				in
				    #"Columna agregada FechaInicioContrato"

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

