				    #"Personalizada agregada" = Table.AddColumn(#"Valor reemplazado", "Nivel", each List.Count(Text.Split([Codigo], "."))),
				    #"Personalizada agregada1" = Table.AddColumn(#"Personalizada agregada", "Codigo padre", each let 
				    parts = Text.Split([Codigo], "."),
				    parentParts = if List.Count(parts) <= 1 then null else List.FirstN(parts, List.Count(parts)-1),
				    parent = if parentParts = null then null else Text.Combine(parentParts, ".")
				in
				    parent),
				    #"Personalizada agregada2" = Table.AddColumn(#"Personalizada agregada1", "Id categoria", each Text.Upper(Text.Trim([Tipo costo])) & "|" & Text.Trim([Codigo])),
