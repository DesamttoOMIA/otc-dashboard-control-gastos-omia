				    #"Filas filtradas" = Table.SelectRows(#"Tipo cambiado1", each ([Column1] <> null and [Column1] <> "COSTOS DIRECTOS" and [Column1] <> "COSTOS INDIRECTOS")),
				    #"Columnas quitadas2" = Table.RemoveColumns(#"Filas filtradas",{"Incidencia", "COP", "US$"}),
				    #"Dividir columna por delimitador" = Table.SplitColumn(#"Columnas quitadas2", "Column1", Splitter.SplitTextByEachDelimiter({" "}, QuoteStyle.Csv, false), {"Column1.1", "Column1.2"}),
				    #"Columnas con nombre cambiado" = Table.RenameColumns(#"Dividir columna por delimitador",{{"Column1.1", "Codigo"}, {"Column1.2", "Descripción"}, {"TIPO COSTO", "Tipo costo"}}),
