table _Medidas
	lineageTag: 4083414b-79ed-4e5c-8305-daebc257801b

	measure 'Consumo Total' = [SOLPED pendiente por ordenar] + [OC pendiente por recibir] + [FC pendiente por facturar] + [EM pendiente por facturar] + [FP pendiente por pagar] + [Pago efectuado]
		formatString: \$\ #,0.###############;-\$\ #,0.###############;\$\ #,0.###############
		displayFolder: Vista general
		lineageTag: 670411b9-5073-45c2-ac7b-7b9f70fe0fbc

		annotation PBI_FormatHint = {"currencyCulture":"es-CO"}

	measure 'OC pendiente por recibir' =
			
			SUMX (
			    FILTER (
			        Fact_ordenes_de_compra,
			        Fact_ordenes_de_compra[Status de la línea] = "O"
			    ),
			    Fact_ordenes_de_compra[Cantidad abierta restante] * Fact_ordenes_de_compra[Precio]
			)
		formatString: \$\ #,0.###############;-\$\ #,0.###############;\$\ #,0.###############
		displayFolder: Vista general
		lineageTag: 8f0a5b2e-6c3d-4a1f-9e7b-2d5c4a1f6e30

		annotation PBI_FormatHint = {"currencyCulture":"es-CO"}

	measure 'FC pendiente por facturar' =
			
			CALCULATE (
			    SUM ( Fact_entrada_de_mercancia_factura_conformada[Total líneas] ),
			    ISBLANK ( Fact_entrada_de_mercancia_factura_conformada[Orden de Compra] )
			)
		formatString: \$\ #,0.###############;-\$\ #,0.###############;\$\ #,0.###############
		displayFolder: Vista general
		lineageTag: 3c7e1a9d-4f2b-4e8a-b1c6-7a9d2e4f5b81

		annotation PBI_FormatHint = {"currencyCulture":"es-CO"}

	measure 'Meses Transcurridos' = MONTH(TODAY())
		formatString: 0
		displayFolder: Vista general
		lineageTag: 2b6d8e4a-1f3c-4d9e-a5b7-8c1d3e6f2a94

	measure 'Presupuesto YTD' =
			SUMX(
			    VALUES(Dim_proyecto[Id proyecto]),
			    VAR FechaInicio = CALCULATE(MIN(Dim_proyecto[FechaInicioContrato]))
			    VAR MesesTranscurridos = DATEDIFF(FechaInicio, TODAY(), MONTH) + 1
			    VAR PresupuestoMensualProyecto = CALCULATE(SUM(Fact_presupuesto_final[COP]))
			    RETURN PresupuestoMensualProyecto * MesesTranscurridos
			)
		formatString: \$\ #,0.###############;-\$\ #,0.###############;\$\ #,0.###############
		displayFolder: Vista general
		lineageTag: 4e8b1d6a-9c3f-4b7e-a2d5-1f6c8a3e9b52

		annotation PBI_FormatHint = {"currencyCulture":"es-CO"}

	measure 'Consumo dentro presupuesto' =
			
			MIN (
			    [Consumo Total],
			    [Presupuesto Anual]
			)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: Vista general
		lineageTag: 1c3f2ff4-de6d-4225-b8e6-65568f734d8e

	measure 'Disponible dentro presupuesto' =
			
			MAX (
			    [Presupuesto Anual] - [Consumo Total],
			    0
			)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: Vista general
		lineageTag: 938ed00c-7383-4052-8cbc-3ab05f4fd7a4

	measure 'Exceso presupuesto' =
			
			MAX (
			    [Consumo Total] - [Presupuesto Anual],
			    0
			)
		displayFolder: Vista general
		lineageTag: a03d6d17-045d-4b7b-9e95-7de5ddf080b0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Presupuesto Anual' =
			
			SUMX (
			    VALUES ( Dim_proyecto[Id proyecto] ),
			    CALCULATE (
			        SUM ( Fact_presupuesto_final[COP] )
			    ) * 12
			)
		formatString: \$\ #,0;-\$\ #,0;\$\ #,0
		displayFolder: Vista general
		lineageTag: 8c198d23-94a6-4059-8cd7-69a30ee28493

		annotation PBI_FormatHint = {"currencyCulture":"es-CO"}

	measure 'Disponible Anual' =
			
			[Presupuesto Anual] - [Consumo Total]
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: Vista general
		lineageTag: 3f6e0ef4-cb6e-4941-bb12-f3e69c945a5f

	measure 'SOLPED pendiente por ordenar' =
			
			CALCULATE (
			    SUM ( 'Fact_solicitud_de_pedido'[Total líneas] ),
			    'Fact_solicitud_de_pedido'[Status de la línea] = "O",
			    'Fact_solicitud_de_pedido'[Cancelado] = "N",
			    'Fact_solicitud_de_pedido'[Línea cerrada manualmente] = "N",
			    'Fact_solicitud_de_pedido'[Clase de documento de destino] = -1
			)
		formatString: \$\ #,0.###############;-\$\ #,0.###############;\$\ #,0.###############
		displayFolder: Vista general
		lineageTag: b3a80cd9-824c-423b-ba1a-6256e30e515f

		annotation PBI_FormatHint = {"currencyCulture":"es-CO"}

	measure 'EM pendiente por facturar' =
			
			CALCULATE (
			    SUM ( 'Fact_entrada_de_mercancia_factura_conformada'[Total líneas] ),
			    'Fact_entrada_de_mercancia_factura_conformada'[Status de documento] = "O",
			    'Fact_entrada_de_mercancia_factura_conformada'[Clase de documento de destino] = -1,
			    NOT ISBLANK ( 'Fact_entrada_de_mercancia_factura_conformada'[Orden de Compra] )
			)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: Vista general
		lineageTag: fa641be4-2fdd-4ac9-b8a5-5d432beb4cff

	measure 'FP pendiente por pagar' =
			
			CALCULATE (
			    SUM ( 'Fact_stg_solped_oc_fc_em_fp_pe'[Total líneas_19] ),
			    NOT ISBLANK ( 'Fact_stg_solped_oc_fc_em_fp_pe'[No.Factura SAP] ),
			    ISBLANK ( 'Fact_stg_solped_oc_fc_em_fp_pe'[No. Pago SAP] )
			)
		formatString: \$\ #,0.###############;-\$\ #,0.###############;\$\ #,0.###############
		displayFolder: Vista general
		lineageTag: 67cb2ad0-3c24-47ac-92de-44cca1ac0036

		annotation PBI_FormatHint = {"currencyCulture":"es-CO"}

	measure 'Pago efectuado' =
			
			CALCULATE (
			    SUM ( 'Fact_stg_solped_oc_fc_em_fp_pe'[Total líneas_19] ),
			    NOT ISBLANK ( 'Fact_stg_solped_oc_fc_em_fp_pe'[No. Pago SAP] )
			)
		formatString: \$\ #,0.###############;-\$\ #,0.###############;\$\ #,0.###############
		displayFolder: Vista general
		lineageTag: 065323f5-3aa3-4986-8118-1c352b0b9025

		annotation PBI_FormatHint = {"currencyCulture":"es-CO"}

	measure 'Consumo detalle' = SUM ( Fact_bitacora_documental[Valor total] )
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: Detalle documental
		lineageTag: 18a48220-c5ad-4ffd-bc94-8d84cb5d8ac9

	measure 'Lineas detalle' = COUNTROWS ( Fact_bitacora_documental )
		formatString: 0
		displayFolder: Detalle documental
		lineageTag: 567db425-36b5-4afd-8c82-37a53388c16a

	measure 'Documentos detalle' = COUNTROWS ( SUMMARIZE ( Fact_bitacora_documental, Fact_bitacora_documental[Tipo de documento], Fact_bitacora_documental[N° documento] ) )
		formatString: 0
		displayFolder: Detalle documental
		lineageTag: 61cc8449-ddad-4638-a373-ddfd0a2947d7

	measure '% consumo detalle' = DIVIDE ( [Consumo detalle], CALCULATE ( [Consumo detalle], REMOVEFILTERS ( Fact_bitacora_documental ), VALUES ( Dim_proyecto ) ) )
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: Detalle documental
		lineageTag: b06b5f98-3d5a-4614-871b-c600dcce28a2

	measure 'Titulo detalle' = VAR _sub = SELECTEDVALUE ( Dim_subseco[Descripción] ) VAR _dist = SELECTEDVALUE ( Dim_subseco[Distribución Costos] ) RETURN "Detalle documental · " & COALESCE ( _sub, _dist, "Todo el consumo" )
		displayFolder: Detalle documental
		lineageTag: be1df01f-5ced-4a4c-a019-947ff74fbb7c

	measure 'Ruta detalle' = VAR _sub = SELECTEDVALUE ( Dim_subseco[Descripción] ) VAR _cod = SELECTEDVALUE ( Dim_subseco[Subseco] ) VAR _dist = SELECTEDVALUE ( Dim_subseco[Distribución Costos] ) RETURN "Consumo por distribución de costos" & IF ( NOT ISBLANK ( _dist ), "  ›  " & _dist ) & IF ( NOT ISBLANK ( _sub ), "  ›  " & _cod & " · " & _sub )
		displayFolder: Detalle documental
		lineageTag: dbd73759-7b94-4812-9e94-98839d1704d7

	measure 'Etiqueta tarjeta detalle' = SWITCH ( TRUE (), NOT ISBLANK ( SELECTEDVALUE ( Dim_subseco[Descripción] ) ), "CONSUMO DEL SUBSECCO", NOT ISBLANK ( SELECTEDVALUE ( Dim_subseco[Distribución Costos] ) ), "CONSUMO DE LA DISTRIBUCIÓN", "CONSUMO TOTAL" )
		displayFolder: Detalle documental
		lineageTag: 2b4b8749-5ba8-455d-b1b0-7b9820329df8

	measure 'Resumen detalle' = VAR _l = [Lineas detalle] VAR _d = [Documentos detalle] RETURN FORMAT ( _l, "#,0" ) & IF ( _l = 1, " línea · ", " líneas · " ) & FORMAT ( _d, "#,0" ) & IF ( _d = 1, " documento · ", " documentos · " ) & FORMAT ( [% consumo detalle], "0.0%" ) & " del consumo"
		displayFolder: Detalle documental
		lineageTag: 960ec410-d7c8-4e35-9209-bfa195fead32

	measure '% etapa detalle' = DIVIDE ( [Consumo detalle], CALCULATE ( [Consumo detalle], REMOVEFILTERS ( Dim_etapa ) ) )
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: Detalle documental
		lineageTag: efafff4c-4f8d-441d-8e41-c2f89547bcdf

	measure 'Pie etapa detalle' = IF ( ISBLANK ( [Consumo detalle] ), "Sin documentos", FORMAT ( [% etapa detalle], "0.0%" ) & " del total" )
		displayFolder: Detalle documental
		lineageTag: 878f8098-e12d-4263-91ee-b64f7e3c902c

	measure 'Barra etapa detalle' = VAR _p = COALESCE ( [% etapa detalle], 0 ) VAR _w = IF ( _p > 0, MAX ( 4, ROUND ( _p * 200, 0 ) ), 0 ) RETURN IF ( ISBLANK ( [Consumo detalle] ), BLANK (), "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='200' height='8' viewBox='0 0 200 8'><rect x='0' y='0' width='200' height='8' rx='4' fill='%23EDF0F4'/><rect x='0' y='0' width='" & FORMAT ( _w, "0" ) & "' height='8' rx='4' fill='%231B4379'/></svg>" )
		displayFolder: Detalle documental
		lineageTag: cd2feec4-cc98-40f9-a21a-b03ecf4dabff
		dataCategory: ImageUrl

	measure 'Barra texto etapa' = VAR _p = COALESCE ( [% etapa detalle], 0 ) VAR _n = IF ( _p > 0, MAX ( 1, ROUND ( _p * 12, 0 ) ), 0 ) RETURN IF ( ISBLANK ( [Consumo detalle] ), BLANK (), REPT ( "█", _n ) & REPT ( "░", 12 - _n ) )
		displayFolder: Detalle documental
		lineageTag: 1844cb05-c281-458f-953b-943b69efb2a2

	measure 'Pasos recorrido' = VAR _c = "%231B4379" VAR _circ = "<circle cx='{x}' cy='16' r='12' fill='" & _c & "'/><text x='{x}' y='20.5' font-family='Segoe UI, Arial' font-size='13' font-weight='700' fill='white' text-anchor='middle'>{n}</text>" VAR _xs = { ( 1, 93 ), ( 2, 281 ), ( 3, 470 ), ( 4, 659 ), ( 5, 848 ), ( 6, 1037 ) } VAR _circles = CONCATENATEX ( _xs, SUBSTITUTE ( SUBSTITUTE ( _circ, "{x}", [Value2] ), "{n}", [Value1] ), "", [Value1], ASC ) RETURN "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='1130' height='32' viewBox='0 0 1130 32'><line x1='93' y1='16' x2='1037' y2='16' stroke='" & _c & "' stroke-width='2' stroke-opacity='0.35'/>" & _circles & "</svg>"
		lineageTag: 5a27941a-9d68-477a-8feb-c98a1ea8289b
		dataCategory: ImageUrl

	measure 'TT html' = ```
			
			VAR _tipo = SELECTEDVALUE ( Fact_bitacora_documental[Tipo de documento] )
			VAR _dias = SELECTEDVALUE ( Fact_bitacora_documental[Días en la etapa] )
			VAR _f    = SELECTEDVALUE ( Fact_bitacora_documental[Fecha necesaria] )
			VAR _hoy  = TODAY ()
			VAR _venc =
			    IF ( ISBLANK ( _f ), "",
			        IF ( _hoy > _f, "Vencida · " & DATEDIFF ( _f, _hoy, DAY ) & " días",
			            IF ( _hoy = _f, "Vence hoy", "Faltan " & DATEDIFF ( _hoy, _f, DAY ) & " días" ) ) )
			VAR _prio =
			    SWITCH ( SELECTEDVALUE ( Fact_bitacora_documental[Prioridad] ),
			        1, "Normal", 2, "Urgente", 3, "Emergencia", 4, "Hecho cumplido", 5, "Donación", "" )
			VAR _resp = SELECTEDVALUE ( Fact_bitacora_documental[Responsable] )
			VAR _comp = SELECTEDVALUE ( Fact_bitacora_documental[Comprador asignado] )
			VAR _adj  = SELECTEDVALUE ( Fact_bitacora_documental[Adjudicacion Directa] )
			VAR _com  = SELECTEDVALUE ( Fact_bitacora_documental[Comentarios] )
			VAR _pago = SELECTEDVALUE ( Fact_bitacora_documental[Condiciones de pago] )
			VAR _estAct = SELECTEDVALUE ( Fact_bitacora_documental[Estado] )
			VAR _sol  = SELECTEDVALUE ( Fact_bitacora_documental[SOLPED origen] )
			VAR _oc   = SELECTEDVALUE ( Fact_bitacora_documental[OC asociada] )
			VAR _fac  = SELECTEDVALUE ( Fact_bitacora_documental[Factura asociada] )
			
			// Campos de OC
			VAR _pct0 = SELECTEDVALUE ( Fact_bitacora_documental[% entrega] )
			VAR _pct  = IF ( _pct0 > 1, _pct0 / 100, _pct0 )
			VAR _pend = ISBLANK ( _pct ) || _pct < 1
			VAR _toc  =
			    SWITCH ( SELECTEDVALUE ( Fact_bitacora_documental[Tipo de OC] ),
			        1, "Normal", 2, "Cto. marco / Ac. global", 3, "Larga vigencia", "" )
			
			// Campos de EM / facturas
			VAR _sinFac = ISBLANK ( _fac ) || _fac = 0
			
			VAR _est =
			    SWITCH ( _tipo,
			        "SOLPED", "Solicitud aprobada, pendiente de convertir en OC",
			        "Orden de compra", IF ( _pend, "Costo comprometido pendiente de convertir en EM", _estAct ),
			        "Entrada de mercancía", IF ( _sinFac, "Costo recibido pendiente de facturar", _estAct ),
			        _estAct
			    )
			
			VAR _a = "<tr><td style='color:#575756;padding:3px 0;white-space:nowrap;vertical-align:top'>"
			VAR _b = "</td><td style='text-align:right;font-weight:600;padding:3px 0 3px 12px;white-space:nowrap'>"
			VAR _c = "</td></tr>"
			
			VAR _filasSol =
			    IF ( NOT ISBLANK ( _dias ), _a & "Días sin ordenar" & _b & _dias & " días" & _c, "" )
			    & IF ( NOT ISBLANK ( _f ), _a & "Requerida" & _b & FORMAT ( _f, "dd/MM/yyyy" ) & _c, "" )
			    & IF ( _venc <> "", _a & "Vencimiento" & _b
			        & "<span style='color:" & IF ( _hoy > _f, "#C62828", "#1B4379" ) & "'>" & _venc & "</span>" & _c, "" )
			    & IF ( _prio <> "", _a & "Prioridad" & _b
			        & "<span style='color:" & IF ( _prio = "Normal", "#1B4379", "#F8AA00" ) & "'>" & _prio & "</span>" & _c, "" )
			    & IF ( NOT ISBLANK ( _resp ), _a & "Solicitante" & _b & _resp & _c, "" )
			    & IF ( NOT ISBLANK ( _comp ), _a & "Comprador" & _b & _comp & _c, "" )
			    & IF ( NOT ISBLANK ( _adj ),  _a & "A. directa" & _b & _adj & _c, "" )
			
			VAR _filasOC =
			    IF ( NOT ISBLANK ( _dias ), _a & "Días sin recibir" & _b & _dias & " días" & _c, "" )
			    & IF ( NOT ISBLANK ( _pct ), _a & "% entrega" & _b & FORMAT ( _pct, "0%" ) & _c, "" )
			    & IF ( _toc <> "", _a & "Tipo de OC" & _b & _toc & _c, "" )
			    & IF ( NOT ISBLANK ( _comp ), _a & "Comprador" & _b & _comp & _c, "" )
			    & IF ( NOT ISBLANK ( _sol ), _a & "SOLPED origen" & _b & _sol & _c, "" )
			
			VAR _filasEM =
			    IF ( NOT ISBLANK ( _dias ), _a & "Días sin facturar" & _b & _dias & " días" & _c, "" )
			    & IF ( NOT ISBLANK ( _oc ),   _a & "OC asociada" & _b & _oc & _c, "" )
			    & IF ( NOT ISBLANK ( _sol ),  _a & "SOLPED origen" & _b & _sol & _c, "" )
			    & IF ( NOT ISBLANK ( _resp ), _a & "Solicitante" & _b & _resp & _c, "" )
			    & IF ( NOT ISBLANK ( _pago ), _a & "Cond. de pago" & _b & _pago & _c, "" )
			    & IF ( NOT ISBLANK ( _comp ), _a & "Comprador" & _b & _comp & _c, "" )
			
			VAR _filasFC =
			    IF ( NOT ISBLANK ( _dias ), _a & "Días en la etapa" & _b & _dias & " días" & _c, "" )
			    & IF ( NOT ISBLANK ( _oc ),   _a & "OC asociada" & _b & _oc & _c, "" )
			    & IF ( NOT ISBLANK ( _sol ),  _a & "SOLPED origen" & _b & _sol & _c, "" )
			    & IF ( NOT ISBLANK ( _resp ), _a & "Solicitante" & _b & _resp & _c, "" )
			    & IF ( NOT _sinFac, _a & "Factura" & _b & _fac & _c, "" )
			    & IF ( NOT ISBLANK ( _comp ), _a & "Comprador" & _b & _comp & _c, "" )
			
			VAR _filasFP =
			    IF ( NOT ISBLANK ( _dias ), _a & "Días en la etapa" & _b & _dias & " días" & _c, "" )
			    & IF ( NOT ISBLANK ( _sol ),  _a & "SOLPED origen" & _b & _sol & _c, "" )
			    & IF ( NOT ISBLANK ( _oc ),   _a & "OC asociada" & _b & _oc & _c, "" )
			    & IF ( NOT _sinFac,           _a & "Factura asociada" & _b & _fac & _c, "" )
			    & IF ( NOT ISBLANK ( _resp ), _a & "Solicitante" & _b & _resp & _c, "" )
			    & IF ( NOT ISBLANK ( _pago ), _a & "Cond. de pago" & _b & _pago & _c, "" )
			    & IF ( NOT ISBLANK ( _comp ), _a & "Comprador" & _b & _comp & _c, "" )
			
			VAR _filasPG =
			    IF ( NOT ISBLANK ( _sol ),  _a & "SOLPED origen" & _b & _sol & _c, "" )
			    & IF ( NOT ISBLANK ( _oc ),   _a & "OC asociada" & _b & _oc & _c, "" )
			    & IF ( NOT _sinFac,           _a & "Factura asociada" & _b & _fac & _c, "" )
			    & IF ( NOT ISBLANK ( _resp ), _a & "Solicitante" & _b & _resp & _c, "" )
			    & IF ( NOT ISBLANK ( _comp ), _a & "Comprador" & _b & _comp & _c, "" )
			    
			VAR _filas =
			    SWITCH ( _tipo,
			        "SOLPED", _filasSol,
			        "Orden de compra", _filasOC,
			        "Entrada de mercancía", _filasEM,
			        "Factura conformada", _filasFC,
			        "Factura de proveedor", _filasFP,
			        "Pago efectuado", _filasPG,
			        "Pago", _filasPG,
			        "" )
			
			RETURN
			"<div style='font-family:Segoe UI,sans-serif;font-size:12px;color:#333'>"
			& "<div style='background:#1B4379;color:#fff;padding:7px 10px;border-radius:4px 4px 0 0'>"
			& "<div style='font-size:14px;font-weight:700'>" & _tipo & " " & SELECTEDVALUE ( Fact_bitacora_documental[N° documento] ) & "</div>"
			& "<div style='font-size:11px;opacity:.85'>" & _est & "</div></div>"
			& "<div style='padding:4px 12px 8px;border:1px solid #ddd;border-top:none;border-radius:0 0 4px 4px'>"
			& IF ( _filas <> "", "<table style='width:100%;border-collapse:collapse'>" & _filas & "</table>", "" )
			& IF ( NOT ISBLANK ( _com ), "<div style='margin-top:6px;font-size:11px;color:#575756;line-height:1.3'>"
			    & "<b>Comentarios</b><br>" & _com & "</div>", "" )
			& "</div></div>"
			```
		lineageTag: 2a39a321-dc55-4f96-a477-834e16167f80

	measure 'Alertas franja html' =
			
			VAR _t =
			    ADDCOLUMNS (
			        FILTER ( ALL ( Dim_categoria ), UPPER ( Dim_categoria[TieneHijos] & "" ) = "FALSE" ),
			        "@c", [Consumo Total],
			        "@p", [Presupuesto Anual]
			    )
			VAR _e =
			    ADDCOLUMNS (
			        _t,
			        "@e",
			            IF ( [@p] > 0 && [@c] >= [@p], "S",
			            IF ( [@p] > 0 && [@c] >= 0.8 * [@p], "C",
			            IF ( NOT ( [@p] > 0 ) && [@c] > 0, "P",
			            IF ( [@p] > 0 && ( ISBLANK ( [@c] ) || [@c] = 0 )
			                 && NOT ( TRIM ( Dim_categoria[Cod_N2] ) IN { "1.2", "2.1" } ), "G", "" ) ) ) )
			    )
			VAR _k =
			    ADDCOLUMNS (
			        FILTER ( _e, [@e] <> "" ),
			        "@k", SWITCH ( [@e], "S", [@c] - [@p], "C", DIVIDE ( [@c], [@p] ), "P", [@c], [@p] )
			    )
			VAR _total = COUNTROWS ( _k ) + 0
			VAR _m = "#,##0.0"
			VAR _estados =
			    DATATABLE (
			        "Est", STRING, "Orden", INTEGER, "Etiqueta", STRING, "Borde", STRING, "Texto", STRING,
			        {
			            { "S", 1, "Sobrepresupuestadas", "#E7344C", "#C4213A" },
			            { "C", 2, "Cerca del límite", "#F8AA00", "#9A6700" },
			            { "P", 3, "Sin presupuesto", "#EE7600", "#A85300" },
			            { "G", 4, "Con presupuesto, sin gastar", "#2B79BA", "#1F5F95" }
			        }
			    )
			VAR _cards =
			    CONCATENATEX (
			        _estados,
			        VAR _st = [Est]
			        VAR _bd = [Borde]
			        VAR _tx = [Texto]
			        VAR _f = FILTER ( _k, [@e] = _st )
			        VAR _n = COUNTROWS ( _f ) + 0
			        VAR _top = TOPN ( 1, _f, [@k], DESC )
			        VAR _nom = MAXX ( _top, TRIM ( Dim_categoria[Descripción] ) )
			        VAR _ruta = MAXX ( _top, Dim_categoria[Tipo costo] & " › " & TRIM ( Dim_categoria[Desc_N2] ) )
			        VAR _c = MAXX ( _top, [@c] ) + 0
			        VAR _p = MAXX ( _top, [@p] ) + 0
			        VAR _pct = IF ( _st = "P", "Sin ppto", FORMAT ( DIVIDE ( _c, _p ) + 0, "0%" ) )
			        VAR _monto =
			            SWITCH ( _st,
			                "S", "+$ " & FORMAT ( ( _c - _p ) / 1E6, _m ) & " mill. sobre el presupuesto",
			                "C", "Disponible $ " & FORMAT ( ( _p - _c ) / 1E6, _m ) & " mill.",
			                "P", "$ " & FORMAT ( _c / 1E6, _m ) & " mill. sin presupuesto asignado",
			                "$ " & FORMAT ( _p / 1E6, _m ) & " mill. sin ningún consumo" )
			        VAR _cab =
			            "<div style='display:flex;align-items:center;justify-content:space-between;gap:6px'>"
			            & "<span style='display:inline-flex;align-items:center;gap:5px;font-size:10px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:#3A4352;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>"
			            & "<span style='width:8px;height:8px;border-radius:50%;flex:none;background:" & _bd & "'></span>" & [Etiqueta] & "</span>"
			            & "<span style='font-size:11px;font-weight:700;color:#3A4352;background:#EEF1F5;border-radius:999px;padding:0 8px'>" & _n & "</span></div>"
			        VAR _cuerpo =
			            IF ( _n = 0,
			                "<div style='font-size:13px;font-weight:700;color:#1B2433'>Sin líneas en este estado</div>"
			                    & "<div style='font-size:11.5px;color:#5A6475'>Ninguna línea del REE cumple esta condición.</div>",
			                "<div style='display:flex;justify-content:space-between;gap:8px'>"
			                    & "<span style='font-size:13px;font-weight:700;color:#1B2433;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>" & _nom & "</span>"
			                    & "<span style='font-size:13px;font-weight:700;white-space:nowrap;color:" & _tx & "'>" & _pct & "</span></div>"
			                    & "<div style='font-size:11.5px;color:#5A6475;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>" & _ruta & "</div>"
			                    & "<div style='font-size:11.5px;font-weight:600;color:" & _tx & "'>" & _monto & "</div>" )
			        RETURN
			            "<div style='flex:1 1 0;min-width:0;background:#FFFFFF;border:1px solid " & _bd
			                & ";border-radius:8px;padding:4px 10px'>"
			                & _cab & _cuerpo & "</div>",
			        "",
			        [Orden], ASC
			    )
			VAR _bell = "<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#E7344C' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9'/><path d='M13.7 21a2 2 0 0 1-3.4 0'/></svg>"
			RETURN
			    "<div style='font-family:Segoe UI,sans-serif'>"
			    & "<div style='display:flex;align-items:center;gap:8px;margin-bottom:5px'>" & _bell
			    & "<span style='font-size:14px;font-weight:700;color:#1B2433'>Alertas de presupuesto</span>"
			    & "<span style='font-size:13px;color:#5A6475'>· " & _total & IF ( _total = 1, " alerta", " alertas" ) & "</span></div>"
			    & "<div style='display:flex;gap:10px'>" & _cards & "</div></div>"
		lineageTag: 86aa6f86-4b2f-4e86-aef2-f51f35e13ba5

	measure 'Alertas cantidad' =
			
			VAR _t =
			    ADDCOLUMNS (
			        FILTER ( ALL ( Dim_categoria ), UPPER ( Dim_categoria[TieneHijos] & "" ) = "FALSE" ),
			        "@c", [Consumo Total],
			        "@p", [Presupuesto Anual]
			    )
			RETURN
			    COUNTROWS ( FILTER ( _t, ( [@p] > 0 && [@c] >= 0.8 * [@p] ) || ( NOT ( [@p] > 0 ) && [@c] > 0 ) ) ) + 0
		formatString: 0
		lineageTag: b20c2cda-599c-4790-bc2f-efa28811e488

	measure 'Alertas centro html' =
			
			VAR _t =
			    ADDCOLUMNS (
			        FILTER ( ALL ( Dim_categoria ), UPPER ( Dim_categoria[TieneHijos] & "" ) = "FALSE" ),
			        "@c", [Consumo Total],
			        "@p", [Presupuesto Anual]
			    )
			VAR _e =
			    ADDCOLUMNS (
			        _t,
			        "@e",
			            IF ( [@p] > 0 && [@c] >= [@p], "S",
			                IF ( [@p] > 0 && [@c] >= 0.8 * [@p], "C",
			                    IF ( NOT ( [@p] > 0 ) && [@c] > 0, "P", "" ) ) )
			    )
			VAR _a = FILTER ( _e, [@e] <> "" )
			VAR _k =
			    ADDCOLUMNS (
			        _a,
			        "@x", IF ( [@e] = "S", [@c] - [@p], IF ( [@e] = "P", [@c], 0 ) ),
			        "@k", IF ( [@e] = "S", 1E13 + [@c] - [@p], IF ( [@e] = "P", 1E13 + [@c], DIVIDE ( [@c], [@p] ) ) )
			    )
			VAR _nS = COUNTROWS ( FILTER ( _k, [@e] = "S" ) ) + 0
			VAR _nP = COUNTROWS ( FILTER ( _k, [@e] = "P" ) ) + 0
			VAR _nC = COUNTROWS ( FILTER ( _k, [@e] = "C" ) ) + 0
			VAR _vS = SUMX ( FILTER ( _k, [@e] = "S" ), [@x] ) + 0
			VAR _vP = SUMX ( FILTER ( _k, [@e] = "P" ), [@x] ) + 0
			VAR _vC = SUMX ( FILTER ( _k, [@e] = "C" ), [@p] - [@c] ) + 0
			VAR _m = "#,##0.0"
			VAR _box = "border:1px solid #E3E8EF;border-radius:6px;padding:12px 16px;flex:1 1 0"
			VAR _cont =
			    "<div style='display:flex;gap:14px;margin-bottom:16px'>"
			    & "<div style='" & _box & ";border-top:4px solid #C62828'><div style='font-size:13px;color:#5A6475'>Sobrepresupuestadas</div>"
			    & "<div><span style='font-size:28px;font-weight:700;color:#C62828'>" & _nS & "</span>"
			    & "<span style='font-size:13px;color:#5A6475;margin-left:10px'>$ " & FORMAT ( _vS / 1E6, _m ) & " mill. sobre el presupuesto</span></div></div>"
			    & "<div style='" & _box & ";border-top:4px solid #7B1E3A'><div style='font-size:13px;color:#5A6475'>Sin presupuesto y gastando</div>"
			    & "<div><span style='font-size:28px;font-weight:700;color:#7B1E3A'>" & _nP & "</span>"
			    & "<span style='font-size:13px;color:#5A6475;margin-left:10px'>$ " & FORMAT ( _vP / 1E6, _m ) & " mill. sin presupuesto asignado</span></div></div>"
			    & "<div style='" & _box & ";border-top:4px solid #F8AA00'><div style='font-size:13px;color:#5A6475'>Cerca del límite (80% – 99%)</div>"
			    & "<div><span style='font-size:28px;font-weight:700;color:#9A6700'>" & _nC & "</span>"
			    & "<span style='font-size:13px;color:#5A6475;margin-left:10px'>"
			    & IF ( _nC = 0, "Sin líneas en este rango", "$ " & FORMAT ( _vC / 1E6, _m ) & " mill. disponibles" )
			    & "</span></div></div></div>"
			VAR _th = "<th style='text-align:left;padding:9px 10px;font-weight:600;white-space:nowrap'>"
			VAR _thr = "<th style='text-align:right;padding:9px 10px;font-weight:600;white-space:nowrap'>"
			VAR _td = "<td style='padding:10px;border-bottom:1px solid #E3E8EF;vertical-align:top'>"
			VAR _tdr = "<td style='padding:10px;border-bottom:1px solid #E3E8EF;text-align:right;white-space:nowrap;vertical-align:top'>"
			VAR _rows =
			    CONCATENATEX (
			        _k,
			        VAR _st = [@e]
			        VAR _col = SWITCH ( _st, "S", "#C62828", "P", "#7B1E3A", "#9A6700" )
			        VAR _lab = SWITCH ( _st, "S", "Sobrepresupuestada", "P", "Sin presupuesto", "Cerca del límite" )
			        VAR _id = Dim_categoria[Id categoria]
			        VAR _nom = TRIM ( Dim_categoria[Descripción] )
			        VAR _ruta =
			            Dim_categoria[Tipo costo] & " › " & TRIM ( Dim_categoria[Desc_N2] )
			            & IF ( Dim_categoria[Nivel] = 3, " › " & _nom, "" )
			        VAR _docs =
			            CALCULATETABLE (
			                ADDCOLUMNS (
			                    SUMMARIZE ( Fact_bitacora_documental, Fact_bitacora_documental[Tipo de documento], Fact_bitacora_documental[N° documento] ),
			                    "@v", [Consumo detalle]
			                ),
			                REMOVEFILTERS ( Dim_categoria ),
			                Dim_subseco[Id categoria] = _id
			            )
			        VAR _nd = COUNTROWS ( _docs ) + 0
			        VAR _drv =
			            MAXX (
			                TOPN ( 1, _docs, [@v], DESC ),
			                Fact_bitacora_documental[Tipo de documento] & " " & Fact_bitacora_documental[N° documento]
			                    & " · $ " & FORMAT ( [@v] / 1E6, _m ) & " mill."
			            )
			        RETURN
			            "<tr>"
			            & _td & "<span style='display:inline-flex;align-items:center;gap:6px;font-weight:600;color:" & _col & ";white-space:nowrap'>"
			            & "<span style='width:9px;height:9px;border-radius:50%;background:" & _col & ";display:inline-block'></span>" & _lab & "</span></td>"
			            & _td & "<b>" & Dim_categoria[Codigo] & " " & _nom & "</b></td>"
			            & _td & "<span style='color:#5A6475'>" & _ruta & "</span></td>"
			            & _tdr & "$ " & FORMAT ( [@c] / 1E6, _m ) & " mill.</td>"
			            & _tdr & "<span style='color:#6156A1'>$ " & FORMAT ( [@p] / 1E6, _m ) & " mill.</span></td>"
			            & _tdr & "<b style='color:" & _col & "'>" & IF ( _st = "P", "—", FORMAT ( DIVIDE ( [@c], [@p] ), "0%" ) ) & "</b></td>"
			            & _tdr & "<b style='color:" & _col & "'>" & IF ( _st = "C", "Disponible $ " & FORMAT ( ( [@p] - [@c] ) / 1E6, _m ) & " mill.", "+$ " & FORMAT ( [@x] / 1E6, _m ) & " mill." ) & "</b></td>"
			            & _td & IF ( _nd = 0, "<span style='color:#5A6475'>Sin documentos en la bitácora</span>",
			                    _drv & "<br><span style='color:#5A6475;font-size:12px'>Mayor de " & _nd & IF ( _nd = 1, " documento", " documentos" ) & "</span>" ) & "</td>"
			            & "</tr>",
			        "",
			        [@k], DESC
			    )
			VAR _tabla =
			    "<table style='width:100%;border-collapse:collapse;font-size:13px;color:#1B2433'>"
			    & "<thead><tr style='background:#164479;color:#FFFFFF'>"
			    & _th & "Estado</th>" & _th & "Línea REE</th>" & _th & "Ruta en la gráfica</th>"
			    & _thr & "Consumo</th>" & _thr & "Presupuesto</th>" & _thr & "%</th>" & _thr & "Por fuera del ppto</th>"
			    & _th & "Lo explica</th></tr></thead><tbody>" & _rows & "</tbody></table>"
			RETURN
			    "<div style='font-family:Segoe UI,sans-serif;color:#1B2433'>" & _cont
			    & IF ( _nS + _nP + _nC = 0,
			        "<div style='font-size:14px;color:#2F7A17;font-weight:600;padding:16px'>Sin alertas de presupuesto en este corte.</div>",
			        _tabla
			        & "<div style='font-size:12px;color:#5A6475;margin-top:10px'>Ordenadas por el monto que está por fuera del presupuesto. La ruta es el camino en la gráfica &quot;Consumo presupuesto por categoría REE&quot; para llegar a la barra en rojo.</div>" )
			    & "</div>"
		lineageTag: ef1042ec-03e4-41db-a586-9ec99afdb107

	measure 'Estado alerta' =
			
			VAR _hoja =
			    HASONEVALUE ( Dim_categoria[Id categoria] )
			        && UPPER ( SELECTEDVALUE ( Dim_categoria[TieneHijos] ) & "" ) = "FALSE"
			VAR _c = [Consumo Total]
			VAR _p = [Presupuesto Anual]
			VAR _nomina = TRIM ( SELECTEDVALUE ( Dim_categoria[Cod_N2] ) ) IN { "1.2", "2.1" }
			RETURN
			    IF ( _hoja,
			        SWITCH ( TRUE (),
			            _p > 0 && _c >= _p, "Sobrepresupuestada",
			            _p > 0 && _c >= 0.8 * _p, "Cerca del límite",
			            NOT ( _p > 0 ) && _c > 0, "Sin presupuesto",
			            _p > 0 && ( ISBLANK ( _c ) || _c = 0 ) && NOT _nomina, "Con presupuesto, sin gastar"
			        )
			    )
		lineageTag: c0aeba3d-b633-4fe9-877e-0f136d61ddb2

	measure 'Punto estado' = IF ( NOT ISBLANK ( [Estado alerta] ), "●" )
		lineageTag: 0188347c-a544-4fdc-9bb4-bb09b673dad9

	measure 'Color estado' =
			
			SWITCH ( [Estado alerta],
			    "Sobrepresupuestada", "#E7344C",
			    "Cerca del límite", "#F8AA00",
			    "Sin presupuesto", "#EE7600",
			    "Con presupuesto, sin gastar", "#2B79BA" )
		lineageTag: fd646d69-1a22-4af2-8fc7-ee7bba4a7113

	measure 'Color texto estado' =
			
			SWITCH ( [Estado alerta],
			    "Sobrepresupuestada", "#C4213A",
			    "Cerca del límite", "#9A6700",
			    "Sin presupuesto", "#A85300",
			    "Con presupuesto, sin gastar", "#1F5F95" )
		lineageTag: bb17541f-138e-4848-bead-f6eb0e4b4aa3

	measure '% consumo ppto' =
			
			IF ( NOT ISBLANK ( [Estado alerta] ) && [Presupuesto Anual] > 0,
			    DIVIDE ( [Consumo Total], [Presupuesto Anual] ) + 0 )
		formatString: 0\ %;-0\ %;0\ %
		lineageTag: 5412a2dc-98e4-4fa2-ad6b-e9606bfc1e14

	measure 'Por fuera ppto' =
			
			SWITCH ( [Estado alerta],
			    "Sobrepresupuestada", [Consumo Total] - [Presupuesto Anual],
			    "Sin presupuesto", [Consumo Total] )
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 358512ba-796f-4ff0-afa0-27f84d164d11

		annotation PBI_FormatHint = {"currencyCulture":"es-US"}

	measure 'Filtro estado alerta' =
			
			VAR _e = [Estado alerta]
			RETURN
			    IF ( NOT ISBLANK ( _e )
			        && ( NOT ISFILTERED ( 'Estados alerta'[Estado] ) || _e IN VALUES ( 'Estados alerta'[Estado] ) ), 1 )
		lineageTag: d54678cf-c13e-4b14-ac84-f14b508ee8fe

	measure 'Notif gestion visible' = ```
			
			        VAR _p = VALUES ( Dim_proyecto[Código de proyecto] )
			        RETURN
			            IF ( NOT ISEMPTY ( FILTER ( 'Notificaciones gestion', 'Notificaciones gestion'[Proyecto] IN _p ) ), 1 )
			```
		formatString: 0
		lineageTag: d47a9e7d-710c-4bf3-8614-626ba3aa461f

	measure 'Notif gestion cantidad' = ```
			
			        COUNTROWS ( FILTER ( 'Notificaciones gestion', 'Notificaciones gestion'[Proyecto] IN VALUES ( Dim_proyecto[Código de proyecto] ) ) ) + 0
			```
		formatString: 0
		lineageTag: 24e7a692-dfeb-4e76-aedf-65e3950d2ab8

	measure 'Notif gestion encabezado' = ```
			
			        VAR _n = [Notif gestion cantidad]
			        RETURN
			            "Notificaciones de gestión · "
			                & SWITCH ( TRUE (), _n = 0, "sin notificaciones en este corte", _n = 1, "1 notificación", _n & " notificaciones" )
			```
		lineageTag: 473b6b93-3b1d-4e5b-af95-fc52123e1534

	measure 'Notif gestion vacio' = ```
			
