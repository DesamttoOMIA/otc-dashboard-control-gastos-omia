	measure '% Incidencia' =
			
			DIVIDE(
			    [Presupuesto total Visible],
			    CALCULATE(
			        [Presupuesto total Visible],
			        REMOVEFILTERS('Dim_categoria')
			    ),
			    0
			)
		displayFolder: Medidas tarjeta presupuesto total
		lineageTag: 3854fc2f-9265-438c-9874-fa6b060c03e0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Consumo SOLPED' = SUM('Fact_solicitud_de_pedido'[Total líneas])
		formatString: \$\ #,0.###############;-\$\ #,0.###############;\$\ #,0.###############
		displayFolder: Resumen Gerencial
		lineageTag: 7a100001-0001-4a00-8000-000000000001

		annotation PBI_FormatHint = {"currencyCulture":"es-CO"}

	measure 'Consumo ODC' = SUM('Fact_ordenes_de_compra'[Total Líneas OC $Cop])
		formatString: \$\ #,0.###############;-\$\ #,0.###############;\$\ #,0.###############
		displayFolder: Resumen Gerencial
		lineageTag: 7a100001-0002-4a00-8000-000000000002

		annotation PBI_FormatHint = {"currencyCulture":"es-CO"}

	measure 'Consumo Facturas' = SUM('Fact_facturas_conformadas'[Total líneas])
		formatString: \$\ #,0.###############;-\$\ #,0.###############;\$\ #,0.###############
		displayFolder: Resumen Gerencial
		lineageTag: 7a100001-0003-4a00-8000-000000000003

		annotation PBI_FormatHint = {"currencyCulture":"es-CO"}

	measure 'Total consumido' =
			[Consumo SOLPED] + [Consumo ODC] + [Consumo Facturas]
		formatString: \$\ #,0.###############;-\$\ #,0.###############;\$\ #,0.###############
		displayFolder: Resumen Gerencial
		lineageTag: 7a100001-0004-4a00-8000-000000000004

		annotation PBI_FormatHint = {"currencyCulture":"es-CO"}

	measure 'Presupuesto disponible' =
			[Presupuesto total] - [Total consumido]
		formatString: \$\ #,0.###############;-\$\ #,0.###############;\$\ #,0.###############
		displayFolder: Resumen Gerencial
		lineageTag: 7a100001-0005-4a00-8000-000000000005

		annotation PBI_FormatHint = {"currencyCulture":"es-CO"}

	measure '% consumido' =
			DIVIDE([Total consumido], [Presupuesto total])
		formatString: 0.0%
		displayFolder: Resumen Gerencial
		lineageTag: 7a100001-0006-4a00-8000-000000000006

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Card HTML - Presupuesto' =

			VAR IncidenciaReal = [% Incidencia]
			VAR Incidencia = FORMAT(IncidenciaReal, "0.0%")
			VAR BarraWidth = SUBSTITUTE(FORMAT(MIN(IncidenciaReal, 1) * 100, "0.0"), ",", ".")
			RETURN
			"
			<div style='font-family:Segoe UI,Arial,sans-serif;background:#FFFFFF;border:1px solid #E2E8F0;border-left:5px solid #164379;border-radius:10px;padding:12px 14px 11px;width:100%;height:100%;box-sizing:border-box;'>
			  <div style='display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;'>
			    <div style='display:flex;align-items:center;gap:8px;'><span style='font-size:20px;'>🏦</span><span style='font-size:10px;color:#164379;font-weight:700;letter-spacing:1.2px;text-transform:uppercase;'>Presupuesto disponible</span></div>
			    <span style='font-size:10px;color:#164379;background:#EAF0F7;border-radius:999px;padding:4px 7px;font-weight:700;'>" & Incidencia & "</span>
			  </div>
			  <div style='font-size:30px;color:#164379;font-weight:800;line-height:1;margin-bottom:10px;'>" & FORMAT([Presupuesto total] / 1000000, "$ #,0.00") & " mill.</div>
			  <div style='height:7px;background:#E2E8F0;border-radius:999px;overflow:hidden;margin-bottom:7px;'><div style='height:100%;width:" & BarraWidth & "%;background:#164379;border-radius:999px;'></div></div>
			  <div style='font-size:11px;color:#575756;'>Base total para controlar el consumo</div>
			</div>
			"
		displayFolder: Resumen Gerencial
		lineageTag: 7a100001-0007-4a00-8000-000000000007

	measure 'Card HTML - SOLPED' =

			VAR Participacion = DIVIDE([Consumo SOLPED], [Total consumido])
			VAR ParticipacionTexto = FORMAT(Participacion, "0.0%")
			VAR BarraWidth = SUBSTITUTE(FORMAT(MIN(Participacion, 1) * 100, "0.0"), ",", ".")
			VAR Cantidad = FORMAT(DISTINCTCOUNT('Fact_solicitud_de_pedido'[ID de documento interno]), "0")
			RETURN
			"
			<div style='font-family:Segoe UI,Arial,sans-serif;background:#FFFFFF;border:1px solid #E2E8F0;border-left:5px solid #2679BA;border-radius:10px;padding:12px 14px 11px;width:100%;height:100%;box-sizing:border-box;'>
			  <div style='display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;'><div style='display:flex;align-items:center;gap:8px;'><span style='font-size:20px;'>📝</span><span style='font-size:10px;color:#2679BA;font-weight:700;letter-spacing:1.2px;text-transform:uppercase;'>SOLPED</span></div><span style='font-size:10px;color:#2679BA;background:#EAF4FB;border-radius:999px;padding:4px 7px;font-weight:700;'>" & ParticipacionTexto & " del consumo</span></div>
			  <div style='font-size:30px;color:#1E293B;font-weight:800;line-height:1;margin-bottom:10px;'>" & FORMAT([Consumo SOLPED] / 1000000, "$ #,0.00") & " mill.</div>
			  <div style='height:7px;background:#E2E8F0;border-radius:999px;overflow:hidden;margin-bottom:7px;'><div style='height:100%;width:" & BarraWidth & "%;background:#2679BA;border-radius:999px;'></div></div>
			  <div style='font-size:11px;color:#575756;'><b style='color:#2679BA;'>" & Cantidad & "</b> solicitudes de pedido</div>
			</div>
			"
		displayFolder: Resumen Gerencial
		lineageTag: 7a100001-0008-4a00-8000-000000000008

	measure 'Card HTML - ODC' =

			VAR Participacion = DIVIDE([Consumo ODC], [Total consumido])
			VAR ParticipacionTexto = FORMAT(Participacion, "0.0%")
			VAR BarraWidth = SUBSTITUTE(FORMAT(MIN(Participacion, 1) * 100, "0.0"), ",", ".")
			VAR Cantidad = FORMAT(DISTINCTCOUNT('Fact_ordenes_de_compra'[Orden de Compra]), "0")
			RETURN
			"
			<div style='font-family:Segoe UI,Arial,sans-serif;background:#FFFFFF;border:1px solid #E2E8F0;border-left:5px solid #F8AA00;border-radius:10px;padding:12px 14px 11px;width:100%;height:100%;box-sizing:border-box;'>
			  <div style='display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;'><div style='display:flex;align-items:center;gap:8px;'><span style='font-size:20px;'>🛒</span><span style='font-size:10px;color:#575756;font-weight:700;letter-spacing:1.2px;text-transform:uppercase;'>ODC</span></div><span style='font-size:10px;color:#575756;background:#FFF5D9;border-radius:999px;padding:4px 7px;font-weight:700;'>" & ParticipacionTexto & " del consumo</span></div>
			  <div style='font-size:30px;color:#1E293B;font-weight:800;line-height:1;margin-bottom:10px;'>" & FORMAT([Consumo ODC] / 1000000, "$ #,0.00") & " mill.</div>
			  <div style='height:7px;background:#E2E8F0;border-radius:999px;overflow:hidden;margin-bottom:7px;'><div style='height:100%;width:" & BarraWidth & "%;background:#F8AA00;border-radius:999px;'></div></div>
			  <div style='font-size:11px;color:#575756;'><b style='color:#EE7600;'>" & Cantidad & "</b> órdenes de compra</div>
			</div>
			"
		displayFolder: Resumen Gerencial
		lineageTag: 7a100001-0009-4a00-8000-000000000009

	measure 'Card HTML - Facturas' =

			VAR Participacion = DIVIDE([Consumo Facturas], [Total consumido])
			VAR ParticipacionTexto = FORMAT(Participacion, "0.0%")
			VAR BarraWidth = SUBSTITUTE(FORMAT(MIN(Participacion, 1) * 100, "0.0"), ",", ".")
			VAR Cantidad = FORMAT(DISTINCTCOUNT('Fact_facturas_conformadas'[Número interno]), "0")
			RETURN
			"
			<div style='font-family:Segoe UI,Arial,sans-serif;background:#FFFFFF;border:1px solid #E2E8F0;border-left:5px solid #6156A1;border-radius:10px;padding:12px 14px 11px;width:100%;height:100%;box-sizing:border-box;'>
			  <div style='display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;'><div style='display:flex;align-items:center;gap:8px;'><span style='font-size:20px;'>🧾</span><span style='font-size:10px;color:#6156A1;font-weight:700;letter-spacing:1.2px;text-transform:uppercase;'>Facturas conformadas</span></div><span style='font-size:10px;color:#6156A1;background:#F0EEFA;border-radius:999px;padding:4px 7px;font-weight:700;'>" & ParticipacionTexto & " del consumo</span></div>
			  <div style='font-size:30px;color:#1E293B;font-weight:800;line-height:1;margin-bottom:10px;'>" & FORMAT([Consumo Facturas] / 1000000, "$ #,0.00") & " mill.</div>
			  <div style='height:7px;background:#E2E8F0;border-radius:999px;overflow:hidden;margin-bottom:7px;'><div style='height:100%;width:" & BarraWidth & "%;background:#6156A1;border-radius:999px;'></div></div>
			  <div style='font-size:11px;color:#575756;'><b style='color:#6156A1;'>" & Cantidad & "</b> facturas conformadas</div>
			</div>
			"
		displayFolder: Resumen Gerencial
		lineageTag: 7a100001-000a-4a00-8000-00000000000a

	measure 'Card HTML - Disponible' =

			VAR Disponible = [Presupuesto disponible]
			VAR ValorPrincipal = FORMAT(Disponible / 1000000, "$ #,0.00") & " mill."
			VAR PorcentajeReal = [% consumido]
			VAR PorcentajeTexto = FORMAT(PorcentajeReal, "0.0%")
			VAR ConsumoWidth = SUBSTITUTE(FORMAT(MIN(PorcentajeReal, 1) * 100, "0.0"), ",", ".")
			VAR ColorEstado =
			    SWITCH(
			        TRUE(),
			        PorcentajeReal < 0.8, "#71B73A",
			        PorcentajeReal < 1, "#EE7600",
			        "#E7344C"
			    )
			VAR Estado =
			    SWITCH(
			        TRUE(),
			        PorcentajeReal < 0.8, "EN RANGO",
			        PorcentajeReal < 1, "EN ALERTA",
			        "SOBREGASTO"
			    )
			RETURN
			"
			<div style='font-family:Segoe UI,Arial,sans-serif;background:#164379;border-radius:10px;padding:12px 14px 11px;width:100%;height:100%;box-sizing:border-box;'>
			  <div style='display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;'><div style='display:flex;align-items:center;gap:8px;'><span style='font-size:20px;'>💰</span><span style='font-size:10px;color:#FFFFFF;font-weight:700;letter-spacing:1.2px;text-transform:uppercase;'>Disponible</span></div><span style='font-size:10px;color:#FFFFFF;background:" & ColorEstado & ";border-radius:999px;padding:4px 7px;font-weight:700;'>" & Estado & "</span></div>
			  <div style='font-size:30px;color:#FFFFFF;font-weight:800;line-height:1;margin-bottom:10px;'>" & ValorPrincipal & "</div>
			  <div style='display:flex;justify-content:space-between;margin-bottom:5px;font-size:11px;color:#FFFFFF;font-weight:600;'><span>Consumido</span><span>" & PorcentajeTexto & "</span></div>
			  <div style='height:8px;background:#FFFFFF;border-radius:999px;overflow:hidden;margin-bottom:7px;'><div style='height:100%;width:" & ConsumoWidth & "%;background:" & ColorEstado & ";border-radius:999px;'></div></div>
			  <div style='font-size:11px;color:#FFFFFF;'>Saldo disponible después del consumo</div>
			</div>
			"
		displayFolder: Resumen Gerencial
		lineageTag: 7a100001-000b-4a00-8000-00000000000b

	partition _Medidas = m
		mode: import
		source =
				let
				    Origen = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Columna1 = _t]),
				    #"Tipo cambiado" = Table.TransformColumnTypes(Origen,{{"Columna1", type text}}),
				    #"Columnas quitadas" = Table.RemoveColumns(#"Tipo cambiado",{"Columna1"})
				in
				    #"Columnas quitadas"

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

