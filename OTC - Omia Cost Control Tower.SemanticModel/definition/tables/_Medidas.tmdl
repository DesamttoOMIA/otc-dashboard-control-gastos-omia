table _Medidas
	lineageTag: 4083414b-79ed-4e5c-8305-daebc257801b

	measure 'Presupuesto total' = SUM(Presupuesto[COP])
		formatString: \$\ #,0.###############;-\$\ #,0.###############;\$\ #,0.###############
		displayFolder: Medidas principales
		lineageTag: 9c723d8d-3af9-4f4a-a9c1-a9a45983b868

		annotation PBI_FormatHint = {"currencyCulture":"es-CO"}

	measure 'Costo ejecutado' = ```
			
			    //SUM('Ordenes de Compra'[Total Líneas OC $Cop]) +
			    SUM('Facturas Conformadas'[Total líneas])
			```
		displayFolder: Medidas principales
		lineageTag: 670411b9-5073-45c2-ac7b-7b9f70fe0fbc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Costo comprometido' = SUM('Solicitud de Pedido'[Total líneas])
		formatString: \$\ #,0.###############;-\$\ #,0.###############;\$\ #,0.###############
		displayFolder: Medidas principales
		lineageTag: 115d40b4-d7a4-4b72-9a80-e2b510b714ac

		annotation PBI_FormatHint = {"currencyCulture":"es-CO"}

	measure 'Costo entrante' =
			
			// SUM('Facturas Conformadas'[Total líneas])
		displayFolder: Medidas principales
		lineageTag: 5c8612ec-d952-440c-b356-5c9eba9fd166

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Consumo total' =
			
			[Costo ejecutado] + [Costo comprometido] + [Costo entrante]
		lineageTag: 1c34b461-159d-46f3-84af-58e1452edbca

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% Consumo' =
			
			DIVIDE([Consumo total], [Presupuesto total])
		lineageTag: 81f50075-b213-415b-9f1a-b0041466271d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Color semaforo' =
			
			SWITCH(
			    TRUE(),
			    [% Consumo] >= 1, "#D32F2F",        -- rojo: se pasó
			    [% Consumo] >= 0.9, "#FBC02D",      -- amarillo: cerca
			    "#388E3C"                           -- verde: ok
			)
		lineageTag: 9594ec3e-7a78-49e9-b775-153811bcc080

	measure 'Presupuesto remanente' = ```
			
			[Presupuesto total] 
			- [Costo ejecutado] 
			- [Costo comprometido] 
			// - [Costo entrante]
			```
		displayFolder: Medidas principales
		lineageTag: bc2eb378-484f-4c0b-9712-be1bceee3dfe

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% Ejecución' = ```
			
			DIVIDE(
			    [Costo ejecutado] + [Costo comprometido],
			    [Presupuesto total]
			)
			
			```
		lineageTag: b719cd37-7b6e-45d0-ac6f-4c581759b5e4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Costo ejecutado 2' = ```
			
			    SUM('Ordenes de Compra'[Total Líneas OC $Cop]) +
			    SUM('Facturas Conformadas'[Total líneas])
			```
		lineageTag: f3dab431-5775-4bd3-bb39-d8793999172a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Presupuesto remanente 2' = ```
			
			[Presupuesto total] 
			- [Costo ejecutado 2] 
			- [Costo comprometido] 
			// - [Costo entrante]
			```
		lineageTag: 9979becc-96f2-4c78-9190-89345e7db557

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition _Medidas = m
		mode: import
		source =
				let
				    Origen = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Columna1 = _t]),
				    #"Tipo cambiado" = Table.TransformColumnTypes(Origen,{{"Columna1", type text}}),
				    #"Columnas quitadas" = Table.RemoveColumns(#"Tipo cambiado",{"Columna1"})
				in
				    #"Columnas quitadas"

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

