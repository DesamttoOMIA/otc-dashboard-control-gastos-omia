	measure 'Presupuesto Anual' =
			
			SUMX (
			    VALUES ( Dim_proyecto[Id proyecto] ),
			    CALCULATE (
			        SUM ( Fact_presupuesto_final[COP] )
			    ) * 12
			)
		formatString: \$\ #,0.###############;-\$\ #,0.###############;\$\ #,0.###############
		lineageTag: 8c198d23-94a6-4059-8cd7-69a30ee28493

		annotation PBI_FormatHint = {"currencyCulture":"es-CO"}

	measure 'Disponible Anual' =
			
			[Presupuesto Anual] - [Consumo Total]
		lineageTag: 3f6e0ef4-cb6e-4941-bb12-f3e69c945a5f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% Consumo Anual' =
			
			DIVIDE (
			    [Consumo Total],
			    [Presupuesto Anual],
			    0
			)
		lineageTag: 577141a2-3edb-41f4-8e16-e37898642c09

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Estado Alerta Presupuesto' =
			
			VAR Presupuesto = [Presupuesto Anual]
			VAR Consumo = [Consumo Total]
			VAR Porcentaje = DIVIDE ( Consumo, Presupuesto )
			RETURN
			    SWITCH (
			        TRUE (),
			        Consumo <= 0, BLANK (),
			        Presupuesto <= 0 && Consumo > 0, "🔴 Sin presupuesto",
			        Porcentaje > 1, "🔴 Sobrepresupuesto",
			        Porcentaje >= 0.8, "🟠 Próximo al límite",
			        BLANK ()
			    )
		lineageTag: 599dd7b9-cd58-4a69-a66c-dedfc1af29b8

	measure 'Alerta Activa' =
			
			VAR Presupuesto = [Presupuesto Anual]
			VAR Consumo = [Consumo Total]
			VAR Porcentaje = DIVIDE ( Consumo, Presupuesto )
			RETURN
			    IF (
			        Consumo > 0
			            && (
			                Presupuesto <= 0
			                || Porcentaje >= 0.8
			            ),
			        1,
			        0
			    )
		formatString: 0
		lineageTag: 40dab425-bcf1-48c1-9a90-0217a06ebca2

	measure 'Cantidad Alertas Presupuesto' =
			
			SUMX (
			    VALUES ( Dim_categoria[Id categoria] ),
			    CALCULATE ( [Alerta Activa] )
			)
		formatString: 0
		lineageTag: 8d3334a7-92ad-4a52-a5fa-98d14e4f373b

	measure 'Card HTML - Alertas Banner' =
			
			VAR Base = ADDCOLUMNS(SUMMARIZE('Dim_categoria', 'Dim_categoria'[Id categoria], 'Dim_categoria'[Descripción], 'Dim_categoria'[Tipo costo]), "__Presu", CALCULATE([Presupuesto Anual]), "__Consumo", CALCULATE([Consumo Total]), "__Pct", DIVIDE(CALCULATE([Consumo Total]), CALCULATE([Presupuesto Anual])))
			
			VAR Activos = FILTER(Base, [__Presu] > 0 || [__Consumo] > 0)
			
			VAR ConPresu = FILTER(Activos, [__Presu] > 0)
			
			VAR SinPresu = FILTER(Activos, [__Presu] <= 0)
			
			VAR Sobre = COUNTROWS(FILTER(ConPresu, [__Pct] >= 1))
			
			VAR Alerta = COUNTROWS(FILTER(ConPresu, [__Pct] >= 0.8 && [__Pct] < 1))
			
			VAR NopSin = COUNTROWS(SinPresu)
			
			VAR Total = Sobre + Alerta + NopSin
			
			VAR MaxPct = COALESCE(MAXX(ConPresu, [__Pct]), 0)
			
			VAR MaxPctTexto = FORMAT(MaxPct, "0%")
			
			VAR TopFinal = TOPN(3, UNION(ADDCOLUMNS(SinPresu, "__Sev", 2), ADDCOLUMNS(FILTER(ConPresu, [__Pct] >= 1), "__Sev", 2), ADDCOLUMNS(FILTER(ConPresu, [__Pct] >= 0.8 && [__Pct] < 1), "__Sev", 1)), [__Sev], DESC, [__Consumo], DESC)
			
			VAR Items = CONCATENATEX(TopFinal, IF(ISBLANK([__Pct]), "<span style='display:inline-flex;align-items:center;gap:5px;font-size:11px;color:#E7344C;font-weight:600;white-space:nowrap;'><span style='width:6px;height:6px;border-radius:50%;background:#E7344C;display:inline-block;'></span>" & TRIM('Dim_categoria'[Descripción]) & " · sin presupuesto</span>", "<span style='display:inline-flex;align-items:center;gap:5px;font-size:11px;color:" & IF([__Pct] >= 1, "#E7344C", "#EE7600") & ";font-weight:600;white-space:nowrap;'><span style='width:6px;height:6px;border-radius:50%;background:" & IF([__Pct] >= 1, "#E7344C", "#EE7600") & ";display:inline-block;'></span>" & TRIM('Dim_categoria'[Descripción]) & " · " & FORMAT([__Pct], "0%") & "</span>"), "<span style='color:#D1D5DB;'>|</span>")
			
			VAR ColorConteo = IF(Sobre + NopSin > 0, "#E7344C", IF(Alerta > 0, "#EE7600", "#71B73A"))
			
			VAR ColorFondo = IF(Sobre + NopSin > 0, "#FEF2F2", IF(Alerta > 0, "#FFF7ED", "#F0FDF4"))
			
			VAR Resumen = IF(Total = 0, "<span style='font-size:12px;color:#71B73A;font-weight:700;'>SIN ALERTAS</span><span style='font-size:11px;color:#575756;font-weight:400;'> · máx consumo " & MaxPctTexto & "</span>", "<span style='font-size:20px;color:" & ColorConteo & ";font-weight:700;line-height:1;'>" & FORMAT(Total, "0") & "</span><span style='font-size:11px;color:#575756;font-weight:400;'>" & FORMAT(Sobre + NopSin, "0") & " sobregasto · " & FORMAT(Alerta, "0") & " en alerta" & IF(NopSin > 0, " · " & FORMAT(NopSin, "0") & " sin presupuesto", "") & "</span>")
			
			RETURN "<div style='font-family:Segoe UI,Arial,sans-serif;background:" & ColorFondo & ";border:1px solid " & ColorConteo & ";border-radius:10px;padding:12px 16px;width:100%;height:100%;box-sizing:border-box;display:flex;align-items:center;gap:16px;'>" & "<div style='display:flex;align-items:center;gap:8px;flex:0 0 auto;'><span style='width:20px;height:2px;background:#E7344C;display:inline-block;'></span><span style='font-size:10px;color:#575756;font-weight:500;letter-spacing:1.4px;text-transform:uppercase;'>ALERTAS</span></div>" & "<div style='display:flex;align-items:baseline;gap:6px;flex:0 0 auto;'>" & Resumen & "</div>" & "<div style='flex:1;min-width:0;display:flex;align-items:center;gap:10px;overflow:hidden;'>" & Items & "</div>" & "</div>"
		formatString: 0
		displayFolder: Resumen ejecutivo
		lineageTag: 6a000001-0020-4a00-8000-000000000020

	partition _Medidas = m
		mode: import
		source =
				let
				    Origen = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Columna1 = _t]),
				    #"Tipo cambiado" = Table.TransformColumnTypes(Origen,{{"Columna1", type text}}),
				    #"Columnas quitadas" = Table.RemoveColumns(#"Tipo cambiado",{"Columna1"})
				in
				    #"Columnas quitadas"

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

