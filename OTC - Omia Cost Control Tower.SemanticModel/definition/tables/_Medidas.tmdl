table _Medidas
	lineageTag: 4083414b-79ed-4e5c-8305-daebc257801b

	measure 'Consumo Total' = [SOLPED pendiente por ordenar] + [OC pendiente por recibir] + [FC pendiente por facturar] + [EM pendiente por facturar] + [FP pendiente por pagar] + [Pago efectuado]
		formatString: \$\ #,0.###############;-\$\ #,0.###############;\$\ #,0.###############
		displayFolder: Vista general
		lineageTag: 670411b9-5073-45c2-ac7b-7b9f70fe0fbc

		annotation PBI_FormatHint = {"currencyCulture":"es-CO"}

	measure 'OC pendiente por recibir' =
			
			SUMX (
			    FILTER (
			        Fact_ordenes_de_compra,
			        Fact_ordenes_de_compra[Status de la línea] = "O"
			    ),
			    Fact_ordenes_de_compra[Cantidad abierta restante] * Fact_ordenes_de_compra[Precio]
			)
		formatString: \$\ #,0.###############;-\$\ #,0.###############;\$\ #,0.###############
		displayFolder: Vista general
		lineageTag: 8f0a5b2e-6c3d-4a1f-9e7b-2d5c4a1f6e30

		annotation PBI_FormatHint = {"currencyCulture":"es-CO"}

	measure 'FC pendiente por facturar' =
			
			CALCULATE (
			    SUM ( Fact_entrada_de_mercancia_factura_conformada[Total líneas] ),
			    ISBLANK ( Fact_entrada_de_mercancia_factura_conformada[Orden de Compra] )
			)
		formatString: \$\ #,0.###############;-\$\ #,0.###############;\$\ #,0.###############
		displayFolder: Vista general
		lineageTag: 3c7e1a9d-4f2b-4e8a-b1c6-7a9d2e4f5b81

		annotation PBI_FormatHint = {"currencyCulture":"es-CO"}

	measure 'Meses Transcurridos' = MONTH(TODAY())
		formatString: 0
		displayFolder: Vista general
		lineageTag: 2b6d8e4a-1f3c-4d9e-a5b7-8c1d3e6f2a94

	measure 'Presupuesto YTD' =
			SUMX(
			    VALUES(Dim_proyecto[Id proyecto]),
			    VAR FechaInicio = CALCULATE(MIN(Dim_proyecto[FechaInicioContrato]))
			    VAR MesesTranscurridos = DATEDIFF(FechaInicio, TODAY(), MONTH) + 1
			    VAR PresupuestoMensualProyecto = CALCULATE(SUM(Fact_presupuesto_final[COP]))
			    RETURN PresupuestoMensualProyecto * MesesTranscurridos
			)
		formatString: \$\ #,0.###############;-\$\ #,0.###############;\$\ #,0.###############
		displayFolder: Vista general
		lineageTag: 4e8b1d6a-9c3f-4b7e-a2d5-1f6c8a3e9b52

		annotation PBI_FormatHint = {"currencyCulture":"es-CO"}

	measure 'Consumo dentro presupuesto' =
			
			MIN (
			    [Consumo Total],
			    [Presupuesto Anual]
			)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: Vista general
		lineageTag: 1c3f2ff4-de6d-4225-b8e6-65568f734d8e

	measure 'Disponible dentro presupuesto' =
			
			MAX (
			    [Presupuesto Anual] - [Consumo Total],
			    0
			)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: Vista general
		lineageTag: 938ed00c-7383-4052-8cbc-3ab05f4fd7a4

	measure 'Exceso presupuesto' =
			
			MAX (
			    [Consumo Total] - [Presupuesto Anual],
			    0
			)
		displayFolder: Vista general
		lineageTag: a03d6d17-045d-4b7b-9e95-7de5ddf080b0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Presupuesto Anual' =
			
			SUMX (
			    VALUES ( Dim_proyecto[Id proyecto] ),
			    CALCULATE (
			        SUM ( Fact_presupuesto_final[COP] )
			    ) * 12
			)
		formatString: \$\ #,0.###############;-\$\ #,0.###############;\$\ #,0.###############
		displayFolder: Vista general
		lineageTag: 8c198d23-94a6-4059-8cd7-69a30ee28493

		annotation PBI_FormatHint = {"currencyCulture":"es-CO"}

	measure 'Disponible Anual' =
			
			[Presupuesto Anual] - [Consumo Total]
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: Vista general
		lineageTag: 3f6e0ef4-cb6e-4941-bb12-f3e69c945a5f

	measure 'SOLPED pendiente por ordenar' =
			
			CALCULATE (
			    SUM ( 'Fact_solicitud_de_pedido'[Total líneas] ),
			    'Fact_solicitud_de_pedido'[Status de la línea] = "O",
			    'Fact_solicitud_de_pedido'[Cancelado] = "N",
			    'Fact_solicitud_de_pedido'[Línea cerrada manualmente] = "N",
			    'Fact_solicitud_de_pedido'[Clase de documento de destino] = -1
			)
		formatString: \$\ #,0.###############;-\$\ #,0.###############;\$\ #,0.###############
		displayFolder: Vista general
		lineageTag: b3a80cd9-824c-423b-ba1a-6256e30e515f

		annotation PBI_FormatHint = {"currencyCulture":"es-CO"}

	measure 'EM pendiente por facturar' =
			
			CALCULATE (
			    SUM ( 'Fact_entrada_de_mercancia_factura_conformada'[Total líneas] ),
			    'Fact_entrada_de_mercancia_factura_conformada'[Status de documento] = "O",
			    'Fact_entrada_de_mercancia_factura_conformada'[Clase de documento de destino] = -1,
			    NOT ISBLANK ( 'Fact_entrada_de_mercancia_factura_conformada'[Orden de Compra] )
			)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: Vista general
		lineageTag: fa641be4-2fdd-4ac9-b8a5-5d432beb4cff

	measure 'FP pendiente por pagar' =
			
			CALCULATE (
			    SUM ( 'Fact_stg_solped_oc_fc_em_fp_pe'[Total líneas_19] ),
			    NOT ISBLANK ( 'Fact_stg_solped_oc_fc_em_fp_pe'[No.Factura SAP] ),
			    ISBLANK ( 'Fact_stg_solped_oc_fc_em_fp_pe'[No. Pago SAP] )
			)
		formatString: \$\ #,0.###############;-\$\ #,0.###############;\$\ #,0.###############
		displayFolder: Vista general
		lineageTag: 67cb2ad0-3c24-47ac-92de-44cca1ac0036

		annotation PBI_FormatHint = {"currencyCulture":"es-CO"}

	measure 'Pago efectuado' =
			
			CALCULATE (
			    SUM ( 'Fact_stg_solped_oc_fc_em_fp_pe'[Total líneas_19] ),
			    NOT ISBLANK ( 'Fact_stg_solped_oc_fc_em_fp_pe'[No. Pago SAP] )
			)
		formatString: \$\ #,0.###############;-\$\ #,0.###############;\$\ #,0.###############
		displayFolder: Vista general
		lineageTag: 065323f5-3aa3-4986-8118-1c352b0b9025

		annotation PBI_FormatHint = {"currencyCulture":"es-CO"}

	measure 'Consumo detalle' = SUM ( Fact_bitacora_documental[Valor] )
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: Detalle documental
		lineageTag: 18a48220-c5ad-4ffd-bc94-8d84cb5d8ac9

	measure 'Lineas detalle' = COUNTROWS ( Fact_bitacora_documental )
		formatString: 0
		displayFolder: Detalle documental
		lineageTag: 567db425-36b5-4afd-8c82-37a53388c16a

	measure 'Documentos detalle' = COUNTROWS ( SUMMARIZE ( Fact_bitacora_documental, Fact_bitacora_documental[Tipo de documento], Fact_bitacora_documental[N° documento] ) )
		formatString: 0
		displayFolder: Detalle documental
		lineageTag: 61cc8449-ddad-4638-a373-ddfd0a2947d7

	measure '% consumo detalle' = DIVIDE ( [Consumo detalle], CALCULATE ( [Consumo detalle], REMOVEFILTERS ( Dim_subseco ) ) )
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: Detalle documental
		lineageTag: b06b5f98-3d5a-4614-871b-c600dcce28a2

	measure 'Titulo detalle' = VAR _sub = SELECTEDVALUE ( Dim_subseco[Descripción] ) VAR _dist = SELECTEDVALUE ( Dim_subseco[Distribución Costos] ) RETURN "Detalle documental · " & COALESCE ( _sub, _dist, "Todo el consumo" )
		displayFolder: Detalle documental
		lineageTag: be1df01f-5ced-4a4c-a019-947ff74fbb7c

	measure 'Ruta detalle' = VAR _sub = SELECTEDVALUE ( Dim_subseco[Descripción] ) VAR _cod = SELECTEDVALUE ( Dim_subseco[Subseco] ) VAR _dist = SELECTEDVALUE ( Dim_subseco[Distribución Costos] ) RETURN "Consumo por distribución de costos" & IF ( NOT ISBLANK ( _dist ), "  ›  " & _dist ) & IF ( NOT ISBLANK ( _sub ), "  ›  " & _cod & " · " & _sub )
		displayFolder: Detalle documental
		lineageTag: dbd73759-7b94-4812-9e94-98839d1704d7

	measure 'Etiqueta tarjeta detalle' = SWITCH ( TRUE (), NOT ISBLANK ( SELECTEDVALUE ( Dim_subseco[Descripción] ) ), "CONSUMO DEL SUBSECCO", NOT ISBLANK ( SELECTEDVALUE ( Dim_subseco[Distribución Costos] ) ), "CONSUMO DE LA DISTRIBUCIÓN", "CONSUMO TOTAL" )
		displayFolder: Detalle documental
		lineageTag: 2b4b8749-5ba8-455d-b1b0-7b9820329df8

	measure 'Resumen detalle' = VAR _l = [Lineas detalle] VAR _d = [Documentos detalle] RETURN FORMAT ( _l, "#,0" ) & IF ( _l = 1, " línea · ", " líneas · " ) & FORMAT ( _d, "#,0" ) & IF ( _d = 1, " documento · ", " documentos · " ) & FORMAT ( [% consumo detalle], "0.0%" ) & " del consumo"
		displayFolder: Detalle documental
		lineageTag: 960ec410-d7c8-4e35-9209-bfa195fead32

	measure '% etapa detalle' = DIVIDE ( [Consumo detalle], CALCULATE ( [Consumo detalle], REMOVEFILTERS ( Dim_etapa ) ) )
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: Detalle documental
		lineageTag: efafff4c-4f8d-441d-8e41-c2f89547bcdf

	measure 'Pie etapa detalle' = IF ( ISBLANK ( [Consumo detalle] ), "Sin documentos", FORMAT ( [% etapa detalle], "0.0%" ) & " del total" )
		displayFolder: Detalle documental
		lineageTag: 878f8098-e12d-4263-91ee-b64f7e3c902c

	partition _Medidas = m
		mode: import
		source =
				let
				    Origen = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Columna1 = _t]),
				    #"Tipo cambiado" = Table.TransformColumnTypes(Origen,{{"Columna1", type text}}),
				    #"Columnas quitadas" = Table.RemoveColumns(#"Tipo cambiado",{"Columna1"})
				in
				    #"Columnas quitadas"

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

