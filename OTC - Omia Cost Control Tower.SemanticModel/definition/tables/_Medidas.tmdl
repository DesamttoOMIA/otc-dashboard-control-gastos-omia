	measure 'Cantidad de lineas orden de compra cerrada' = CALCULATE(COUNTROWS(Fact_detalle_documental),Fact_detalle_documental[Tipo de documento] = "Orden de compra cerrada")
		formatString: 0
		displayFolder: Medidas tabla detalle documental
		lineageTag: 76f05297-9d29-4578-a1a1-4f37945fcb18

	measure 'Cantidad de orden de compra cerrada' = CALCULATE(DISTINCTCOUNT(Fact_detalle_documental[Número de documento]),Fact_detalle_documental[Tipo de documento] = "Orden de compra cerrada")
		formatString: 0
		displayFolder: Medidas tabla detalle documental
		lineageTag: 501334fe-63aa-4b08-abab-7b1a71f951ce

	measure 'Total solicitud de pedido abierta' = CALCULATE(SUM(Fact_detalle_documental[Total línea]),Fact_detalle_documental[Tipo de documento] = "Solicitud de pedido abierta")
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Medidas tabla detalle documental
		lineageTag: 7e50c20e-8e4f-4b42-822d-aed012e61eb1

		annotation PBI_FormatHint = {"currencyCulture":"es-US"}

	measure 'Cantidad de solicitud de pedido abierta' = CALCULATE(DISTINCTCOUNT(Fact_detalle_documental[Número de documento]),Fact_detalle_documental[Tipo de documento] = "Solicitud de pedido abierta")
		formatString: 0
		displayFolder: Medidas tabla detalle documental
		lineageTag: 62ac831d-d16a-45e5-bfd3-c2037d4e7974

	measure 'Cantidad de lineas solicitud de pedido abierta' = CALCULATE(COUNTROWS(Fact_detalle_documental),Fact_detalle_documental[Tipo de documento] = "Solicitud de pedido abierta")
		formatString: 0
		displayFolder: Medidas tabla detalle documental
		lineageTag: 0c5daba3-cec7-4ce8-9d7b-0a883ee38c0c

	measure 'Card HTML - Factura Conformada' =
			
			
			VAR ValorPrincipal =
			    FORMAT([Total factura conformada] / 1000000, "$ #,0.00") & " mill."
			
			VAR CantidadDocs =
			    FORMAT([Cantidad de facturas conformadas], "#,0")
			
			VAR FondoTarjeta = "#FFFFFF"
			VAR Borde = "#E5E7EB"
			VAR FondoSec = "#F3F4F6"
			
			VAR TextoTitulo = "#6B7280"
			VAR TextoPrincipal = "#111827"
			VAR TextoSec = "#374151"
			
			RETURN
			"
			<div style='
			    width:100%;
			    height:100%;
			    font-family: Segoe UI, Arial, sans-serif;
			    background:" & FondoTarjeta & ";
			    border:1px solid " & Borde & ";
			    border-radius:16px;
			    padding:12px 12px 10px 12px;
			    box-sizing:border-box;
			    box-shadow:0 2px 6px rgba(0,0,0,0.05);
			'>
			    <div style='
			        font-size:13px;
			        color:" & TextoTitulo & ";
			        font-weight:600;
			        margin-bottom:6px;
			    '>
			        Factura conformada
			    </div>
			
			    <div style='
			        font-size:26px;
			        font-weight:700;
			        color:" & TextoPrincipal & ";
			        line-height:1.05;
			        margin-bottom:10px;
			    '>
			        " & ValorPrincipal & "
			    </div>
			
			    <div style='
			        background:" & FondoSec & ";
			        border-radius:12px;
			        padding:10px 12px;
			        font-size:12px;
			        color:" & TextoSec & ";
			        line-height:1.5;
			        min-height:58px;
			        display:flex;
			        flex-direction:column;
			        justify-content:center;
			    '>
			        <div>Cantidad de documentos: " & CantidadDocs & "</div>
			    </div>
			</div>
			"
		displayFolder: Medidas tabla detalle documental
		lineageTag: bb2e5ff3-5cc9-427c-84d4-b47b6c318308

	measure 'Card HTML - ODC Cerradas' =
			
			
			VAR ValorPrincipal =
			    FORMAT([Total orden de compra cerrada] / 1000000, "$ #,0.00") & " mill."
			
			VAR CantidadDocs =
			    FORMAT([Cantidad de orden de compra cerrada], "#,0")
			
			VAR CantidadLineas =
			    FORMAT([Cantidad de lineas orden de compra cerrada], "#,0")
			
			VAR FondoTarjeta = "#FFFFFF"
			VAR Borde = "#E5E7EB"
			VAR FondoSec = "#F3F4F6"
			
			VAR TextoTitulo = "#6B7280"
			VAR TextoPrincipal = "#111827"
			VAR TextoSec = "#374151"
			
			RETURN
			"
			<div style='
			    width:100%;
			    height:100%;
			    font-family: Segoe UI, Arial, sans-serif;
			    background:" & FondoTarjeta & ";
			    border:1px solid " & Borde & ";
			    border-radius:16px;
			    padding:12px 12px 10px 12px;
			    box-sizing:border-box;
			    box-shadow:0 2px 6px rgba(0,0,0,0.05);
			'>
			    <div style='
			        font-size:13px;
			        color:" & TextoTitulo & ";
			        font-weight:600;
			        margin-bottom:6px;
			    '>
			        Órden de compra
			    </div>
			
			    <div style='
			        font-size:26px;
			        font-weight:700;
			        color:" & TextoPrincipal & ";
			        line-height:1.05;
			        margin-bottom:10px;
			    '>
			        " & ValorPrincipal & "
			    </div>
			
			    <div style='
			        background:" & FondoSec & ";
			        border-radius:12px;
			        padding:10px 12px;
			        font-size:12px;
			        color:" & TextoSec & ";
			        line-height:1.5;
			        min-height:58px;
			        display:flex;
			        flex-direction:column;
			        justify-content:center;
			    '>
			        <div>Cantidad de documentos: " & CantidadDocs & "</div>
			        <div>Cantidad de líneas: " & CantidadLineas & "</div>
			    </div>
			</div>
			"
		displayFolder: Medidas tabla detalle documental
		lineageTag: 8937480d-3d3f-484e-8918-ed65bb4d6c93

	measure 'Card HTML - SOLPED Abiertas' =
			
			
			VAR ValorPrincipal =
			    FORMAT([Total solicitud de pedido abierta] / 1000000, "$ #,0.00") & " mill."
			
			VAR CantidadDocs =
			    FORMAT([Cantidad de solicitud de pedido abierta], "#,0")
			
			VAR CantidadLineas =
			    FORMAT([Cantidad de lineas solicitud de pedido abierta], "#,0")
			
			VAR FondoTarjeta = "#FFFFFF"
			VAR Borde = "#E5E7EB"
			VAR FondoSec = "#F3F4F6"
			
			VAR TextoTitulo = "#6B7280"
			VAR TextoPrincipal = "#111827"
			VAR TextoSec = "#374151"
			
			RETURN
			"
			<div style='
			    width:100%;
			    height:100%;
			    font-family: Segoe UI, Arial, sans-serif;
			    background:" & FondoTarjeta & ";
			    border:1px solid " & Borde & ";
			    border-radius:16px;
			    padding:12px 12px 10px 12px;
			    box-sizing:border-box;
			    box-shadow:0 2px 6px rgba(0,0,0,0.05);
			'>
			    <div style='
			        font-size:13px;
			        color:" & TextoTitulo & ";
			        font-weight:600;
			        margin-bottom:6px;
			    '>
			        Solicitud de pedido
			    </div>
			
			    <div style='
			        font-size:26px;
			        font-weight:700;
			        color:" & TextoPrincipal & ";
			        line-height:1.05;
			        margin-bottom:10px;
			    '>
			        " & ValorPrincipal & "
			    </div>
			
			    <div style='
			        background:" & FondoSec & ";
			        border-radius:12px;
			        padding:10px 12px;
			        font-size:12px;
			        color:" & TextoSec & ";
			        line-height:1.5;
			        min-height:58px;
			        display:flex;
			        flex-direction:column;
			        justify-content:center;
			    '>
			        <div>Cantidad de documentos: " & CantidadDocs & "</div>
			        <div>Cantidad de líneas: " & CantidadLineas & "</div>
			    </div>
			</div>
			"
		displayFolder: Medidas tabla detalle documental
		lineageTag: 712e818d-f742-4e90-8eaa-789dbb9c3fc6

	measure '% Incidencia' =
			
			DIVIDE(
			    [Presupuesto total Visible],
			    CALCULATE(
			        [Presupuesto total Visible],
			        REMOVEFILTERS('Dim_categoria')
			    ),
			    0
			)
		displayFolder: Medidas tarjeta presupuesto total
		lineageTag: 3854fc2f-9265-438c-9874-fa6b060c03e0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Consumo SOLPED' = SUM('Fact_solicitud_de_pedido'[Total líneas])
		formatString: \$\ #,0.###############;-\$\ #,0.###############;\$\ #,0.###############
		displayFolder: Resumen Gerencial
		lineageTag: 7a100001-0001-4a00-8000-000000000001

		annotation PBI_FormatHint = {"currencyCulture":"es-CO"}

	measure 'Consumo ODC' = SUM('Fact_ordenes_de_compra'[Total Líneas OC $Cop])
		formatString: \$\ #,0.###############;-\$\ #,0.###############;\$\ #,0.###############
		displayFolder: Resumen Gerencial
		lineageTag: 7a100001-0002-4a00-8000-000000000002

		annotation PBI_FormatHint = {"currencyCulture":"es-CO"}

	measure 'Consumo Facturas' = SUM('Fact_facturas_conformadas'[Total líneas])
		formatString: \$\ #,0.###############;-\$\ #,0.###############;\$\ #,0.###############
		displayFolder: Resumen Gerencial
		lineageTag: 7a100001-0003-4a00-8000-000000000003

		annotation PBI_FormatHint = {"currencyCulture":"es-CO"}

	measure 'Total consumido' = [Consumo SOLPED] + [Consumo ODC] + [Consumo Facturas]
		formatString: \$\ #,0.###############;-\$\ #,0.###############;\$\ #,0.###############
		displayFolder: Resumen Gerencial
		lineageTag: 7a100001-0004-4a00-8000-000000000004

		annotation PBI_FormatHint = {"currencyCulture":"es-CO"}

	measure 'Presupuesto disponible' = [Presupuesto total] - [Total consumido]
		formatString: \$\ #,0.###############;-\$\ #,0.###############;\$\ #,0.###############
		displayFolder: Resumen Gerencial
		lineageTag: 7a100001-0005-4a00-8000-000000000005

		annotation PBI_FormatHint = {"currencyCulture":"es-CO"}

	measure '% consumido' = DIVIDE([Total consumido], [Presupuesto total])
		formatString: 0.0%
		displayFolder: Resumen Gerencial
		lineageTag: 7a100001-0006-4a00-8000-000000000006

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Card HTML - SOLPED' =
			
			VAR Activo = IF("SOLPED" IN VALUES('Dim_tipo documento'[Tipo documento]), 1, 0)
			VAR Consumo = IF(Activo = 1, [Consumo SOLPED], 0)
			VAR ValorNum = Consumo / 1000000
			VAR ValorTexto = FORMAT(ValorNum, SWITCH(TRUE(), ABS(ValorNum) >= 1000, "#,0", ABS(ValorNum) >= 100, "#,0.0", "#,0.00"))
			VAR FontValor = SWITCH(TRUE(), LEN(ValorTexto) >= 9, "20px", LEN(ValorTexto) >= 7, "24px", "28px")
			VAR Participacion = DIVIDE(Consumo, [Presupuesto total])
			VAR ParticipacionTexto = FORMAT(Participacion, "0.0%")
			VAR Cantidad = IF(Activo = 1, FORMAT(DISTINCTCOUNT('Fact_solicitud_de_pedido'[ID de documento interno]), "0"), "0")
			RETURN
			"
			<div style='font-family:Segoe UI,Arial,sans-serif;background:#FFFFFF;border:1px solid #E2E8F0;border-radius:10px;padding:12px 14px 11px;width:100%;height:100%;box-sizing:border-box;'>
			  <div style='display:flex;align-items:center;gap:8px;margin-bottom:10px;'><span style='width:20px;height:2px;background:#2679BA;display:inline-block;'></span><span style='font-size:10px;color:#575756;font-weight:500;letter-spacing:1.4px;text-transform:uppercase;'>SOLPED</span></div>
			  <div style='font-size:" & FontValor & ";color:#1E293B;font-weight:300;line-height:1;white-space:nowrap;overflow:hidden;margin-bottom:10px;'>$ " & ValorTexto & " <span style='font-size:12px;color:#575756;font-weight:400;'>mill.</span></div>
			  <div style='font-size:10px;color:#575756;font-weight:400;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-bottom:6px;'>" & ParticipacionTexto & " consumido del presupuesto general</div>
			  <div style='font-size:11px;color:#575756;font-weight:400;'><span style='color:#2679BA;'>" & Cantidad & "</span> solicitudes de pedido abiertas</div>
			</div>
			"
		displayFolder: Resumen Gerencial
		lineageTag: 7a100001-0008-4a00-8000-000000000008

	measure 'Card HTML - ODC' =
			
			VAR Activo = IF("ODC" IN VALUES('Dim_tipo documento'[Tipo documento]), 1, 0)
			VAR Consumo = IF(Activo = 1, [Consumo ODC], 0)
			VAR ValorNum = Consumo / 1000000
			VAR ValorTexto = FORMAT(ValorNum, SWITCH(TRUE(), ABS(ValorNum) >= 1000, "#,0", ABS(ValorNum) >= 100, "#,0.0", "#,0.00"))
			VAR FontValor = SWITCH(TRUE(), LEN(ValorTexto) >= 9, "20px", LEN(ValorTexto) >= 7, "24px", "28px")
			VAR Participacion = DIVIDE(Consumo, [Presupuesto total])
			VAR ParticipacionTexto = FORMAT(Participacion, "0.0%")
			VAR Cantidad = IF(Activo = 1, FORMAT(DISTINCTCOUNT('Fact_ordenes_de_compra'[Orden de Compra]), "0"), "0")
			RETURN
			"
			<div style='font-family:Segoe UI,Arial,sans-serif;background:#FFFFFF;border:1px solid #E2E8F0;border-radius:10px;padding:12px 14px 11px;width:100%;height:100%;box-sizing:border-box;'>
			  <div style='display:flex;align-items:center;gap:8px;margin-bottom:10px;'><span style='width:20px;height:2px;background:#F8AA00;display:inline-block;'></span><span style='font-size:10px;color:#575756;font-weight:500;letter-spacing:1.4px;text-transform:uppercase;'>ODC</span></div>
			  <div style='font-size:" & FontValor & ";color:#1E293B;font-weight:300;line-height:1;white-space:nowrap;overflow:hidden;margin-bottom:10px;'>$ " & ValorTexto & " <span style='font-size:12px;color:#575756;font-weight:400;'>mill.</span></div>
			  <div style='font-size:10px;color:#575756;font-weight:400;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-bottom:6px;'>" & ParticipacionTexto & " consumido del presupuesto general</div>
			  <div style='font-size:11px;color:#575756;font-weight:400;'><span style='color:#EE7600;'>" & Cantidad & "</span> órdenes de compra abiertas y cerradas</div>
			</div>
			"
		displayFolder: Resumen Gerencial
		lineageTag: 7a100001-0009-4a00-8000-000000000009

	measure 'Card HTML - Facturas' =
			
			VAR Activo = IF("Factura" IN VALUES('Dim_tipo documento'[Tipo documento]), 1, 0)
			VAR Consumo = IF(Activo = 1, [Consumo Facturas], 0)
			VAR ValorNum = Consumo / 1000000
			VAR ValorTexto = FORMAT(ValorNum, SWITCH(TRUE(), ABS(ValorNum) >= 1000, "#,0", ABS(ValorNum) >= 100, "#,0.0", "#,0.00"))
			VAR FontValor = SWITCH(TRUE(), LEN(ValorTexto) >= 9, "20px", LEN(ValorTexto) >= 7, "24px", "28px")
			VAR Participacion = DIVIDE(Consumo, [Presupuesto total])
			VAR ParticipacionTexto = FORMAT(Participacion, "0.0%")
			VAR Cantidad = IF(Activo = 1, FORMAT(DISTINCTCOUNT('Fact_facturas_conformadas'[Número interno]), "0"), "0")
			RETURN
			"
			<div style='font-family:Segoe UI,Arial,sans-serif;background:#FFFFFF;border:1px solid #E2E8F0;border-radius:10px;padding:12px 14px 11px;width:100%;height:100%;box-sizing:border-box;'>
			  <div style='display:flex;align-items:center;gap:8px;margin-bottom:10px;'><span style='width:20px;height:2px;background:#6156A1;display:inline-block;'></span><span style='font-size:10px;color:#575756;font-weight:500;letter-spacing:1.4px;text-transform:uppercase;'>FACTURAS</span></div>
			  <div style='font-size:" & FontValor & ";color:#1E293B;font-weight:300;line-height:1;white-space:nowrap;overflow:hidden;margin-bottom:10px;'>$ " & ValorTexto & " <span style='font-size:12px;color:#575756;font-weight:400;'>mill.</span></div>
			  <div style='font-size:10px;color:#575756;font-weight:400;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-bottom:6px;'>" & ParticipacionTexto & " consumido del presupuesto general</div>
			  <div style='font-size:11px;color:#575756;font-weight:400;'><span style='color:#6156A1;'>" & Cantidad & "</span> facturas conformadas abiertas y cerradas</div>
			</div>
			"
		displayFolder: Resumen Gerencial
		lineageTag: 7a100001-000a-4a00-8000-00000000000a

	measure 'Card HTML - Disponible' =
			
			VAR Disponible = [Presupuesto disponible]
			VAR ValorNum = Disponible / 1000000
			VAR ValorTexto = FORMAT(ValorNum, SWITCH(TRUE(), ABS(ValorNum) >= 1000, "#,0", ABS(ValorNum) >= 100, "#,0.0", "#,0.00"))
			VAR ColorDisp = IF(Disponible < 0, "#E7344C", "#71B73A")
			VAR PresuNum = [Presupuesto total] / 1000000
			VAR PresuTexto = FORMAT(PresuNum, SWITCH(TRUE(), ABS(PresuNum) >= 1000, "#,0", ABS(PresuNum) >= 100, "#,0.0", "#,0.00"))
			VAR FontCombinada = SWITCH(TRUE(), LEN(ValorTexto) + LEN(PresuTexto) >= 16, "15px", LEN(ValorTexto) + LEN(PresuTexto) >= 13, "17px", LEN(ValorTexto) + LEN(PresuTexto) >= 10, "19px", "22px")
			VAR DispDir = [Presupuesto directo] - [Consumo directo]
			VAR DispDirNum = DispDir / 1000000
			VAR DispDirTexto = FORMAT(ABS(DispDirNum), SWITCH(TRUE(), ABS(DispDirNum) >= 1000, "#,0", ABS(DispDirNum) >= 100, "#,0.0", "#,0.00"))
			VAR FilaDir = IF(
			    ISBLANK(DispDir),
			    "<div style='display:flex;justify-content:space-between;font-size:11px;color:#9CA3AF;margin-bottom:4px;'><span>Directo</span><span>—</span></div>",
			    "<div style='display:flex;justify-content:space-between;font-size:11px;margin-bottom:4px;'><span style='color:#575756;'>Directo</span><span style='color:" & IF(DispDir < 0, "#E7344C", "#71B73A") & ";font-weight:600;'>" & IF(DispDir < 0, "-$ ", "$ ") & DispDirTexto & " mill.</span></div>"
			)
			VAR DispInd = [Presupuesto indirecto] - [Consumo indirecto]
			VAR DispIndNum = DispInd / 1000000
			VAR DispIndTexto = FORMAT(ABS(DispIndNum), SWITCH(TRUE(), ABS(DispIndNum) >= 1000, "#,0", ABS(DispIndNum) >= 100, "#,0.0", "#,0.00"))
			VAR FilaInd = IF(
			    ISBLANK(DispInd),
			    "<div style='display:flex;justify-content:space-between;font-size:11px;color:#9CA3AF;margin-bottom:8px;'><span>Indirecto</span><span>—</span></div>",
			    "<div style='display:flex;justify-content:space-between;font-size:11px;margin-bottom:8px;'><span style='color:#575756;'>Indirecto</span><span style='color:" & IF(DispInd < 0, "#E7344C", "#71B73A") & ";font-weight:600;'>" & IF(DispInd < 0, "-$ ", "$ ") & DispIndTexto & " mill.</span></div>"
			)
			RETURN
			"
			<div style='font-family:Segoe UI,Arial,sans-serif;background:#F8FAFC;border:1px solid #E2E8F0;border-radius:10px;padding:12px 14px 11px;width:100%;height:100%;box-sizing:border-box;'>
			  <div style='font-size:10px;color:#575756;font-weight:500;letter-spacing:1.4px;text-transform:uppercase;margin-bottom:10px;'>DISPONIBLE</div>
			  <div style='font-size:" & FontCombinada & ";color:" & ColorDisp & ";font-weight:600;line-height:1;white-space:nowrap;overflow:hidden;margin-bottom:12px;'>$ " & ValorTexto & " <span style='font-size:11px;color:#575756;font-weight:400;'>mill.</span> <span style='font-size:12px;color:#575756;font-weight:400;'>de</span> <span style='color:#164379;'>$ " & PresuTexto & "</span> <span style='font-size:11px;color:#575756;font-weight:400;'>mill.</span></div>
			  " & FilaDir & "
			  " & FilaInd & "
			</div>
			"
		displayFolder: Resumen Gerencial
		lineageTag: 7a100001-000b-4a00-8000-00000000000b

	measure 'Consumo directo' = CALCULATE([Total consumido], LEFT(UPPER('Dim_categoria'[Tipo costo]), 3) = "DIR")
		formatString: \$\ #,0.###############;-\$\ #,0.###############;\$\ #,0.###############
		displayFolder: Resumen Gerencial
		lineageTag: 7a100001-000c-4a00-8000-00000000000c

	measure 'Consumo indirecto' = CALCULATE([Total consumido], LEFT(UPPER('Dim_categoria'[Tipo costo]), 3) = "IND")
		formatString: \$\ #,0.###############;-\$\ #,0.###############;\$\ #,0.###############
		displayFolder: Resumen Gerencial
		lineageTag: 7a100001-000d-4a00-8000-00000000000d

	measure 'Presupuesto directo' = CALCULATE([Presupuesto total], LEFT(UPPER('Dim_categoria'[Tipo costo]), 3) = "DIR")
		formatString: \$\ #,0.###############;-\$\ #,0.###############;\$\ #,0.###############
		displayFolder: Resumen Gerencial
		lineageTag: 7a100001-000e-4a00-8000-00000000000e

	measure 'Presupuesto indirecto' = CALCULATE([Presupuesto total], LEFT(UPPER('Dim_categoria'[Tipo costo]), 3) = "IND")
		formatString: \$\ #,0.###############;-\$\ #,0.###############;\$\ #,0.###############
		displayFolder: Resumen Gerencial
		lineageTag: 7a100001-000f-4a00-8000-00000000000f

	measure 'Subsecos sobre presupuesto' =
			
			COUNTROWS(
			    FILTER(
			        ADDCOLUMNS(
			            SUMMARIZE('Dim_subseco', 'Dim_subseco'[Id subseco], 'Dim_subseco'[Id categoria]),
			            "__Consumo", [Total consumido],
			            "__PresuCat", VAR CatActual = 'Dim_subseco'[Id categoria]
			                         RETURN CALCULATE([Presupuesto total], 'Dim_categoria'[Id categoria] = CatActual)
			        ),
			        [__PresuCat] > 0 && [__Consumo] > [__PresuCat]
			    )
			)
		formatString: 0
		displayFolder: Resumen Gerencial
		lineageTag: 7a100001-0010-4a00-8000-000000000010

	measure 'Fila HTML - Consumo subseco' =
			
			VAR Consumo = [Consumo por tipo documento]
			VAR Presupuesto = VAR CatActual = SELECTEDVALUE('Dim_subseco'[Id categoria])
			                  RETURN CALCULATE([Presupuesto total], 'Dim_categoria'[Id categoria] = CatActual)
			VAR PctReal = DIVIDE(Consumo, Presupuesto)
			VAR PctTexto = IF(ISBLANK(PctReal), "—", FORMAT(PctReal, "0%"))
			VAR Color = SWITCH(TRUE(), ISBLANK(PctReal), IF(COALESCE(Consumo, 0) > 0, "#E7344C", "#9CA3AF"), PctReal < 0.8, "#71B73A", PctReal < 1, "#EE7600", "#E7344C")
			VAR Width =
			    IF(
			        ISBLANK(PctReal),
			        IF(COALESCE(Consumo, 0) > 0, "100.0", "0.0"),
			        SUBSTITUTE(FORMAT(MIN(PctReal, 1) * 100, "0.0"), ",", ".")
			    )
			VAR Nombre = SELECTEDVALUE('Dim_subseco'[Descripción])
			VAR ConsumoTexto = FORMAT(Consumo / 1000000, "0.0")
			VAR TipoTexto = COALESCE(SELECTEDVALUE('Dim_subseco'[Distribución Costos]), "—")
			VAR Etiqueta =
			    IF(
			        PctReal > 0.85,
			        "<div style='position:absolute;top:50%;left:" & Width & "%;transform:translate(-100%,-50%);padding-right:6px;font-size:10px;font-weight:600;color:#FFFFFF;white-space:nowrap;'>$ " & ConsumoTexto & "M</div>",
			        "<div style='position:absolute;top:50%;left:" & Width & "%;transform:translateY(-50%);padding-left:6px;font-size:10px;font-weight:600;color:#164379;white-space:nowrap;'>$ " & ConsumoTexto & "M</div>"
			    )
			VAR Disp = Presupuesto - Consumo
			VAR DispTexto = FORMAT(ABS(Disp / 1000000), "0.0")
			VAR DispHTML =
			    IF(
			        ISBLANK(Presupuesto) || Presupuesto <= 0,
			        IF(
			            COALESCE(Consumo, 0) > 0,
			            "<div style='font-size:10px;color:#E7344C;font-weight:600;white-space:nowrap;'>⚠ sin presupuesto · $" & FORMAT(Consumo / 1000000, "0.0") & "M</div>",
			            "<div style='font-size:10px;color:#9CA3AF;white-space:nowrap;'>sin presup.</div>"
			        ),
			        IF(
			            Disp < 0,
			            "<div style='font-size:10px;color:#E7344C;font-weight:600;white-space:nowrap;'>-$ " & DispTexto & "M</div>",
			            "<div style='font-size:10px;color:#575756;white-space:nowrap;'>$ " & DispTexto & "M disp.</div>"
			        )
			    )
			RETURN
			"<div style='display:flex;align-items:center;gap:14px;padding:5px 0;'>
			  <div style='flex:0 0 240px;overflow:hidden;'>
			    <div style='font-size:12px;color:#1E293B;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;'>" & Nombre & "</div>
			    <div style='font-size:10px;color:#575756;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;'>" & TipoTexto & "</div>
			  </div>
			  <div style='flex:1;position:relative;height:14px;background:#EDF0F4;border-radius:999px;overflow:hidden;'>
			    <div style='height:100%;width:" & Width & "%;background:" & Color & ";border-radius:999px;'></div>
			    " & Etiqueta & "
			  </div>
			  <div style='flex:0 0 110px;text-align:right;'>
			    <div style='font-size:13px;color:" & Color & ";font-weight:700;'>" & PctTexto & "</div>
			    " & DispHTML & "
			  </div>
			</div>"
		formatString: 0
		displayFolder: Resumen Gerencial
		lineageTag: 7a100001-0011-4a00-8000-000000000011

	measure 'Card HTML - Consumo vs presupuesto' =
			
			VAR Base =
			    ADDCOLUMNS(
			        SUMMARIZE('Dim_subseco', 'Dim_subseco'[Id subseco], 'Dim_subseco'[Descripción], 'Dim_subseco'[Id categoria]),
			        "__Presu", VAR c = 'Dim_subseco'[Id categoria]
			                    RETURN CALCULATE([Presupuesto total], 'Dim_categoria'[Id categoria] = c),
			        "__Consumo", [Consumo por tipo documento],
			        "__Pct", [% consumido subseco]
			    )
			VAR ConPresu = FILTER(Base, [__Presu] > 0)
			VAR SinPresu = FILTER(Base, ([__Presu] <= 0 || ISBLANK([__Presu])) && [__Consumo] > 0)
			VAR HaySel = ISFILTERED('Dim_categoria')
			VAR CatSel = CALCULATETABLE(VALUES('Dim_categoria'[Id categoria]), ALL('Dim_subseco'))
			VAR EnSel = FILTER(Base, [Id categoria] IN CatSel)
			VAR FilasSin = CONCATENATEX(SinPresu, [Fila HTML - Consumo subseco], "", [__Consumo], DESC)
			VAR FilasTop = CONCATENATEX(TOPN(10, ConPresu, [__Pct], DESC), [Fila HTML - Consumo subseco], "", [__Pct], DESC)
			VAR Filas =
			    IF(
			        HaySel,
			        CONCATENATEX(EnSel, [Fila HTML - Consumo subseco], "", [__Pct], DESC),
			        FilasSin & FilasTop
			    )
			VAR ConsumoTotal = [Total consumido]
			VAR PresupuestoTotal = [Presupuesto total]
			VAR PctTotalReal = DIVIDE(ConsumoTotal, PresupuestoTotal)
			VAR PctTotal = FORMAT(PctTotalReal, "0%")
			RETURN
			"<div style='font-family:Segoe UI,Arial,sans-serif;background:#FFFFFF;border:1px solid #E2E8F0;border-radius:10px;padding:12px 16px 10px;width:100%;height:100%;box-sizing:border-box;display:flex;flex-direction:column;'>
			  <div style='display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;'>
			    <div style='display:flex;align-items:center;gap:8px;'><span style='width:20px;height:2px;background:#164379;display:inline-block;'></span><span style='font-size:16px;color:#164379;font-weight:600;'>Consumo vs presupuesto por subseco</span></div>
			    <span style='font-size:13px;color:#575756;font-weight:600;'>" & PctTotal & " del total</span>
			  </div>
			  <div style='flex:1;min-height:0;overflow-y:auto;'>" & Filas & "</div>
			</div>"
		formatString: 0
		displayFolder: Resumen Gerencial
		lineageTag: 7a100001-0012-4a00-8000-000000000012

	measure '% consumido subseco' =
			
			VAR CatActual = SELECTEDVALUE('Dim_subseco'[Id categoria])
			VAR PresuCat = CALCULATE([Presupuesto total], 'Dim_categoria'[Id categoria] = CatActual)
			RETURN DIVIDE([Consumo por tipo documento], PresuCat)
		formatString: 0.0%
		displayFolder: Resumen Gerencial
		lineageTag: 7a100001-0013-4a00-8000-000000000013

	measure 'Fila HTML - Consumo subseco (Lollipop)' =
			
			VAR Consumo = [Total consumido]
			VAR Presupuesto = VAR CatActual = SELECTEDVALUE('Dim_subseco'[Id categoria])
			                  RETURN CALCULATE([Presupuesto total], 'Dim_categoria'[Id categoria] = CatActual)
			VAR PctReal = DIVIDE(Consumo, Presupuesto)
			VAR PctTexto = FORMAT(PctReal, "0%")
			VAR Color = SWITCH(TRUE(), ISBLANK(PctReal), "#9CA3AF", PctReal < 0.8, "#71B73A", PctReal < 1, "#EE7600", "#E7344C")
			VAR DotLeft = SUBSTITUTE(FORMAT(MIN(COALESCE(PctReal, 0), 1) * 100, "0.0"), ",", ".")
			VAR Nombre = SELECTEDVALUE('Dim_subseco'[Descripción])
			VAR Disp = Presupuesto - Consumo
			VAR DispTexto = FORMAT(ABS(Disp / 1000000), "0.0")
			VAR DispHTML =
			    IF(
			        ISBLANK(Presupuesto) || Presupuesto <= 0,
			        "<div style='font-size:10px;color:#9CA3AF;white-space:nowrap;'>sin presup.</div>",
			        IF(
			            Disp < 0,
			            "<div style='font-size:10px;color:#E7344C;font-weight:600;white-space:nowrap;'>-$ " & DispTexto & "M</div>",
			            "<div style='font-size:10px;color:#575756;white-space:nowrap;'>$ " & DispTexto & "M disp.</div>"
			        )
			    )
			RETURN
			"<div style='display:flex;align-items:center;gap:14px;padding:5px 0;'>
			  <div style='flex:0 0 260px;overflow:hidden;'>
			    <div style='font-size:12px;color:#1E293B;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;'>" & Nombre & "</div>
			  </div>
			  <div style='flex:1;position:relative;height:20px;'>
			    <div style='position:absolute;top:50%;left:0;right:0;height:6px;transform:translateY(-50%);background:#EDF0F4;border-radius:999px;'></div>
			    <div style='position:absolute;top:50%;left:0;width:" & DotLeft & "%;height:3px;transform:translateY(-50%);background:" & Color & ";border-radius:999px;'></div>
			    <div style='position:absolute;top:50%;left:" & DotLeft & "%;transform:translate(-50%,-50%);width:14px;height:14px;border-radius:50%;background:" & Color & ";border:2px solid #FFFFFF;box-shadow:0 0 0 1px " & Color & ";'></div>
			  </div>
			  <div style='flex:0 0 110px;text-align:right;'>
			    <div style='font-size:13px;color:" & Color & ";font-weight:700;'>" & PctTexto & "</div>
			    " & DispHTML & "
			  </div>
			</div>"
		formatString: 0
		displayFolder: Resumen Gerencial
		lineageTag: 7a100001-0014-4a00-8000-000000000014

	measure 'Card HTML - Consumo vs presupuesto (Lollipop)' =
			
			VAR Base =
			    ADDCOLUMNS(
			        SUMMARIZE('Dim_subseco', 'Dim_subseco'[Id subseco], 'Dim_subseco'[Descripción], 'Dim_subseco'[Id categoria]),
			        "__Presu", VAR c = 'Dim_subseco'[Id categoria]
			                    RETURN CALCULATE([Presupuesto total], 'Dim_categoria'[Id categoria] = c),
			        "__Consumo", [Total consumido],
			        "__Pct", [% consumido subseco]
			    )
			VAR ConPresu = FILTER(Base, [__Presu] > 0)
			VAR SinPresu = FILTER(Base, ([__Presu] <= 0 || ISBLANK([__Presu])) && [__Consumo] > 0)
			VAR Filas =
			    CONCATENATEX(
			        TOPN(10, ConPresu, [__Pct], DESC),
			        [Fila HTML - Consumo subseco (Lollipop)],
			        "",
			        [__Pct],
			        DESC
			    )
			VAR NSP = COUNTROWS(SinPresu)
			VAR NombresSP = CONCATENATEX(SinPresu, 'Dim_subseco'[Descripción], " · ")
			VAR ConsumoSP = SUMX(SinPresu, [__Consumo])
			VAR FranjaSP =
			    IF(
			        NSP > 0,
			        "<div style='border-top:1px dashed #E2E8F0;padding-top:6px;margin-top:6px;'>
			          <div style='display:flex;align-items:center;gap:8px;font-size:10px;color:#E7344C;font-weight:600;'>
			            <span>&#9888;</span><span>SIN PRESUPUESTO ASIGNADO (" & FORMAT(NSP, "0") & ")</span>
			            <span style='color:#575756;font-weight:400;'>" & NombresSP & " — $" & FORMAT(ConsumoSP / 1000000, "0.0") & "M consumido</span>
			          </div>
			        </div>",
			        ""
			    )
			VAR ConsumoTotal = [Total consumido]
			VAR PresupuestoTotal = [Presupuesto total]
			VAR PctTotalReal = DIVIDE(ConsumoTotal, PresupuestoTotal)
			VAR PctTotal = FORMAT(PctTotalReal, "0%")
			VAR PctTotalWidth = SUBSTITUTE(FORMAT(MIN(COALESCE(PctTotalReal, 0), 1) * 100, "0.0"), ",", ".")
			VAR ColorTotal = SWITCH(TRUE(), ISBLANK(PctTotalReal), "#9CA3AF", PctTotalReal < 0.8, "#71B73A", PctTotalReal < 1, "#EE7600", "#E7344C")
			VAR DispTotal = PresupuestoTotal - ConsumoTotal
			VAR DispTotalTexto = FORMAT(ABS(DispTotal / 1000000), "0.0")
			VAR DispTotalHTML =
			    IF(
			        DispTotal < 0,
			        "<div style='font-size:10px;color:#E7344C;font-weight:600;white-space:nowrap;'>-$ " & DispTotalTexto & "M</div>",
			        "<div style='font-size:10px;color:#575756;white-space:nowrap;'>$ " & DispTotalTexto & "M disp.</div>"
			    )
			RETURN
			"<div style='font-family:Segoe UI,Arial,sans-serif;background:#FFFFFF;border:1px solid #E2E8F0;border-radius:10px;padding:12px 16px 10px;width:100%;height:100%;box-sizing:border-box;display:flex;flex-direction:column;'>
			  <div style='display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;'>
			    <div style='display:flex;align-items:center;gap:8px;'><span style='width:20px;height:2px;background:#164379;display:inline-block;'></span><span style='font-size:10px;color:#575756;font-weight:500;letter-spacing:1.4px;text-transform:uppercase;'>CONSUMO POR SUBSECO</span></div>
			    <div style='display:flex;gap:12px;font-size:9px;color:#575756;'><span><span style='color:#71B73A;font-weight:700;'>&#9679;</span> en rango</span><span><span style='color:#EE7600;font-weight:700;'>&#9679;</span> alerta</span><span><span style='color:#E7344C;font-weight:700;'>&#9679;</span> sobregasto</span></div>
			  </div>
			  <div style='display:flex;align-items:baseline;justify-content:space-between;margin-bottom:6px;'><span style='font-size:16px;color:#164379;font-weight:600;'>Consumo vs presupuesto por subseco</span><span style='font-size:13px;color:#575756;font-weight:600;'>" & PctTotal & " del total</span></div>
			  <div style='flex:1;overflow-y:auto;min-height:0;'>" & Filas & FranjaSP & "</div>
			  <div style='border-top:1px solid #E2E8F0;padding-top:8px;margin-top:6px;'>
			    <div style='display:flex;align-items:center;gap:14px;'>
			      <div style='flex:0 0 260px;overflow:hidden;'>
			        <div style='font-size:12px;color:#164379;font-weight:700;white-space:nowrap;'>TOTAL</div>
			        <div style='font-size:10px;color:#9CA3AF;white-space:nowrap;'>$ " & FORMAT(ConsumoTotal / 1000000, "0.0") & " mill. consumido</div>
			      </div>
			      <div style='flex:1;height:14px;background:#EDF0F4;border-radius:999px;overflow:hidden;'>
			        <div style='height:100%;width:" & PctTotalWidth & "%;background:" & ColorTotal & ";border-radius:999px;'></div>
			      </div>
			      <div style='flex:0 0 110px;text-align:right;'>
			        <div style='font-size:13px;color:" & ColorTotal & ";font-weight:700;'>" & PctTotal & "</div>
			        " & DispTotalHTML & "
			      </div>
			    </div>
			  </div>
			</div>"
		formatString: 0
		displayFolder: Resumen Gerencial
		lineageTag: 7a100001-0015-4a00-8000-000000000015

	measure 'Consumo por tipo documento' =
			
			VAR Tipos = VALUES('Dim_tipo documento'[Tipo documento])
			RETURN
			    IF("SOLPED" IN Tipos, [Consumo SOLPED])
			        + IF("ODC" IN Tipos, [Consumo ODC])
			        + IF("Factura" IN Tipos, [Consumo Facturas])
		formatString: \$\ #,0.###############;-\$\ #,0.###############;\$\ #,0.###############
		displayFolder: Resumen Gerencial
		lineageTag: 7a100001-0016-4a00-8000-000000000016

		annotation PBI_FormatHint = {"currencyCulture":"es-CO"}

	measure '% consumido directo' =
			
			VAR Consumo = COALESCE(CALCULATE([Consumo por tipo documento], LEFT(UPPER('Dim_categoria'[Tipo costo]), 3) = "DIR"), 0)
			VAR Presupuesto = [Presupuesto directo]
			RETURN
			IF(
			    ISBLANK(Presupuesto) || Presupuesto = 0,
			    IF(Consumo > 0, 1, 0),
			    DIVIDE(Consumo, Presupuesto)
			)
		formatString: 0.0%
		displayFolder: Resumen Gerencial
		lineageTag: 7a100001-0018-4a00-8000-000000000018

	measure '% consumido indirecto' =
			
			VAR Consumo = COALESCE(CALCULATE([Consumo por tipo documento], LEFT(UPPER('Dim_categoria'[Tipo costo]), 3) = "IND"), 0)
			VAR Presupuesto = [Presupuesto indirecto]
			RETURN
			IF(
			    ISBLANK(Presupuesto) || Presupuesto = 0,
			    IF(Consumo > 0, 1, 0),
			    DIVIDE(Consumo, Presupuesto)
			)
		formatString: 0.0%
		displayFolder: Resumen Gerencial
		lineageTag: 7a100001-0019-4a00-8000-000000000019

	measure 'Card HTML - Alertas' =
			
			VAR Base =
			    ADDCOLUMNS(
			        SUMMARIZE('Dim_subseco', 'Dim_subseco'[Id subseco], 'Dim_subseco'[Descripción], 'Dim_subseco'[Id categoria], 'Dim_subseco'[Distribución Costos]),
			        "__Presu", VAR c = 'Dim_subseco'[Id categoria]
			                    RETURN CALCULATE([Presupuesto total], 'Dim_categoria'[Id categoria] = c),
			        "__Consumo", [Total consumido],
			        "__Pct", VAR c = 'Dim_subseco'[Id categoria]
			                 RETURN DIVIDE([Total consumido], CALCULATE([Presupuesto total], 'Dim_categoria'[Id categoria] = c))
			    )
			VAR ConPresu = FILTER(Base, [__Presu] > 0)
			VAR SinPresu = FILTER(Base, ([__Presu] <= 0 || ISBLANK([__Presu])) && [__Consumo] > 0)
			VAR Sobre = COUNTROWS(FILTER(ConPresu, [__Pct] >= 1))
			VAR Alerta = COUNTROWS(FILTER(ConPresu, [__Pct] >= 0.75 && [__Pct] < 1))
			VAR NopSin = COUNTROWS(SinPresu)
			VAR Total = Sobre + Alerta + NopSin
			VAR MaxPct = COALESCE(MAXX(ConPresu, [__Pct]), 0)
			VAR MaxPctTexto = FORMAT(MaxPct, "0%")
			VAR TopFinal =
			    TOPN(
			        5,
			        UNION(
			            ADDCOLUMNS(SinPresu, "__Sev", 2),
			            ADDCOLUMNS(FILTER(ConPresu, [__Pct] >= 1), "__Sev", 2),
			            ADDCOLUMNS(FILTER(ConPresu, [__Pct] >= 0.75 && [__Pct] < 1), "__Sev", 1)
			        ),
			        [__Sev], DESC, [__Consumo], DESC
			    )
			VAR Filas =
			    CONCATENATEX(
			        TopFinal,
			        IF(
			            ISBLANK([__Pct]),
			            "<div style='display:flex;align-items:flex-start;justify-content:space-between;gap:8px;margin-bottom:8px;'><div style='flex:1;min-width:0;'><div style='font-size:11px;color:#E7344C;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;'>" & 'Dim_subseco'[Descripción] & "</div><div style='font-size:9px;color:#E7344C;font-weight:600;'>⚠ gasto " & FORMAT([__Consumo] / 1000000, SWITCH(TRUE(), [__Consumo] / 1000000 >= 1000, "#,0", [__Consumo] / 1000000 >= 100, "#,0.0", "#,0.00")) & " mill · SIN PRESUPUESTO · " & 'Dim_subseco'[Distribución Costos] & "</div></div><div style='flex:0 0 auto;text-align:right;white-space:nowrap;'><div style='font-size:13px;color:#E7344C;font-weight:700;'>—</div></div></div>",
			            "<div style='display:flex;align-items:flex-start;justify-content:space-between;gap:8px;margin-bottom:8px;'><div style='flex:1;min-width:0;'><div style='font-size:11px;color:#1E293B;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;'>" & 'Dim_subseco'[Descripción] & "</div><div style='font-size:9px;color:" & IF([__Pct] >= 1, "#E7344C", "#575756") & ";font-weight:400;'>" & IF([__Pct] >= 1, "sobregasto +$", "faltan $") & FORMAT(ABS([__Consumo] - [__Presu]) / 1000000, SWITCH(TRUE(), ABS([__Consumo] - [__Presu]) / 1000000 >= 1000, "#,0", ABS([__Consumo] - [__Presu]) / 1000000 >= 100, "#,0.0", "#,0.00")) & " mill · " & 'Dim_subseco'[Distribución Costos] & "</div></div><div style='flex:0 0 auto;text-align:right;white-space:nowrap;'><div style='font-size:13px;color:" & IF([__Pct] >= 1, "#E7344C", "#EE7600") & ";font-weight:700;'>" & FORMAT([__Pct], "0%") & "</div></div></div>"
			        ),
			        ""
			    )
			VAR Cuerpo =
			    IF(
			        Total = 0,
			        "<div style='font-size:13px;color:#71B73A;font-weight:700;margin-bottom:4px;'>SIN ALERTAS</div><div style='font-size:10px;color:#575756;font-weight:400;'>Máx consumo " & MaxPctTexto & "</div>",
			        Filas & "<div style='font-size:10px;color:#575756;font-weight:400;'>" & FORMAT(Sobre + NopSin, "0") & " sobregasto · " & FORMAT(Alerta, "0") & " en alerta" & IF(NopSin > 0, " · " & FORMAT(NopSin, "0") & " sin presupuesto", "") & "</div>"
			    )
			VAR ColorConteo = IF(Sobre + NopSin > 0, "#E7344C", IF(Alerta > 0, "#EE7600", "#71B73A"))
			VAR ColorFondo = IF(Sobre + NopSin > 0, "#FEF2F2", IF(Alerta > 0, "#FFF7ED", "#F0FDF4"))
			VAR ColorBorde = ColorConteo
			RETURN
			"<div style='font-family:Segoe UI,Arial,sans-serif;background:" & ColorFondo & ";border:1px solid " & ColorBorde & ";border-radius:10px;padding:12px 14px 11px;width:100%;height:100%;box-sizing:border-box;'>
			  <div style='display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;'>
			    <div style='display:flex;align-items:center;gap:8px;'><span style='width:20px;height:2px;background:#E7344C;display:inline-block;'></span><span style='font-size:10px;color:#575756;font-weight:500;letter-spacing:1.4px;text-transform:uppercase;'>ALERTAS</span></div>
			    <span style='font-size:12px;color:" & ColorConteo & ";font-weight:700;'>" & FORMAT(Total, "0") & "</span>
			  </div>
			  " & Cuerpo & "
			</div>"
		displayFolder: Resumen Gerencial
		lineageTag: 7a100001-0020-4a00-8000-000000000020

	measure 'Etiqueta de actualización' =
		VAR ref = NOW()
		VAR s = MAX('Fact_solicitud_de_pedido'[Fecha de creación])
		VAR o = MAX('Fact_ordenes_de_compra'[Fecha de contabilización])
		VAR f = MAX('Fact_facturas_conformadas'[Fecha de contabilización])
		RETURN "<div style='font-size:9px;color:#575756;white-space:nowrap;'>Actualizado: " & FORMAT(ref, "dd/mm/yyyy hh:mm") & " &nbsp;&#183;&nbsp; SAP al: SOLPED " & FORMAT(s, "dd/mm") & " &#183; OC " & FORMAT(o, "dd/mm") & " &#183; Fact " & FORMAT(f, "dd/mm") & "</div>"
		formatString: General
		displayFolder: Resumen Gerencial
		lineageTag: 7a100001-0021-4a00-8000-000000000021

	partition _Medidas = m
		mode: import
		source =
				let
				    Origen = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Columna1 = _t]),
				    #"Tipo cambiado" = Table.TransformColumnTypes(Origen,{{"Columna1", type text}}),
				    #"Columnas quitadas" = Table.RemoveColumns(#"Tipo cambiado",{"Columna1"})
				in
				    #"Columnas quitadas"

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

