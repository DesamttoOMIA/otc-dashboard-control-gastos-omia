table _Medidas
	lineageTag: 4083414b-79ed-4e5c-8305-daebc257801b

	measure 'Costo ejecutado' = ```
			
			    SUM('Fact_ordenes_de_compra'[Total Líneas OC $Cop]) +
			    SUM('Fact_facturas_conformadas'[Total líneas])
			```
		displayFolder: Medidas principales
		lineageTag: 670411b9-5073-45c2-ac7b-7b9f70fe0fbc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Costo comprometido' = SUM('Fact_solicitud_de_pedido'[Total líneas])
		formatString: \$\ #,0.###############;-\$\ #,0.###############;\$\ #,0.###############
		displayFolder: Medidas principales
		lineageTag: 115d40b4-d7a4-4b72-9a80-e2b510b714ac

		annotation PBI_FormatHint = {"currencyCulture":"es-CO"}

	measure 'Costo entrante' =
			
			// SUM('Facturas Conformadas'[Total líneas])
		displayFolder: Medidas principales
		lineageTag: 5c8612ec-d952-440c-b356-5c9eba9fd166

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Presupuesto remanente' = ```
			
			[Presupuesto total] 
			- [Costo ejecutado] 
			- [Costo comprometido] 
			// - [Costo entrante]
			```
		displayFolder: Medidas principales
		lineageTag: bc2eb378-484f-4c0b-9712-be1bceee3dfe

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% Ejecución' = ```
			
			DIVIDE(
			    [Costo ejecutado] + [Costo comprometido],
			    [Presupuesto total])
			
			```
		displayFolder: Medidas secundarias
		lineageTag: b719cd37-7b6e-45d0-ac6f-4c581759b5e4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Presupuesto total' = SUM(Fact_presupuesto[COP])
		formatString: \$\ #,0.###############;-\$\ #,0.###############;\$\ #,0.###############
		displayFolder: Medidas principales
		lineageTag: e2ff7bca-3189-4fe3-a6ae-59b2119d36f0

		annotation PBI_FormatHint = {"currencyCulture":"es-CO"}

	measure 'Presupuesto total Visible' =
			
			IF(
			    [Presupuesto total] = 0,
			    BLANK(),
			    [Presupuesto total]
			)
		formatString: \$\ #,0.###############;-\$\ #,0.###############;\$\ #,0.###############
		displayFolder: Medidas secundarias
		lineageTag: 626f53c3-c4b8-4592-aa0d-0badb3c1e9a7

		annotation PBI_FormatHint = {"currencyCulture":"es-CO"}

	measure 'Costo comprometido visible' = ```
			SUM(Fact_solicitud_de_pedido[Total líneas]	) 
			```
		formatString: \$\ #,0.###############;-\$\ #,0.###############;\$\ #,0.###############
		displayFolder: Medidas secundarias
		lineageTag: 9eb17a5d-0cf3-4b36-89a6-c9b965df2c3a

		annotation PBI_FormatHint = {"currencyCulture":"es-CO"}

	measure 'Costo ejecutado visible' = ```
			
			IF(
			    SUM('Fact_ordenes_de_compra'[Total Líneas OC $Cop]) +
			    SUM('Fact_facturas_conformadas'[Total líneas])
			    = 0,
			    BLANK(),
			     SUM('Fact_ordenes_de_compra'[Total Líneas OC $Cop]) +
			    SUM('Fact_facturas_conformadas'[Total líneas])
			
			)
			
			
			
			
			
			```
		formatString: \$\ #,0.###############;-\$\ #,0.###############;\$\ #,0.###############
		displayFolder: Medidas secundarias
		lineageTag: 42e48397-ba71-4b5b-af09-475f031c02c2

		annotation PBI_FormatHint = {"currencyCulture":"es-CO"}

	measure 'Presupuesto remanente visible > 0' =
			
			VAR pres = COALESCE([Presupuesto total], 0)
			VAR ejec = COALESCE([Costo ejecutado visible], 0)
			VAR comp = COALESCE([Costo comprometido visible], 0)
			
			VAR ejec_dentro = MIN(ejec, pres)
			VAR saldo_pres  = MAX(pres - ejec_dentro, 0)
			VAR comp_dentro = MIN(comp, saldo_pres)
			
			VAR rem = pres - ejec_dentro - comp_dentro
			RETURN
			IF(rem > 0, rem, BLANK())
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: Medidas secundarias
		lineageTag: eac8d59c-bedc-4539-b215-eb9418c55226

	measure 'Consumo total visible' =
			
			VAR ejec = [Costo ejecutado visible]
			VAR comp = [Costo comprometido visible]
			VAR total = ejec + comp
			RETURN
			IF(
			    ISBLANK(ejec) && ISBLANK(comp),
			    BLANK(),
			    total
			)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: Medidas secundarias
		lineageTag: 6e547628-15b6-4f9b-a25a-b8b9107c3b7e

	measure 'Sobrepresupuesto visible (>0)' =
			
			VAR pres = [Presupuesto total Visible]
			VAR cons = [Consumo total visible]
			VAR over = cons - pres
			RETURN
			IF(
			    ISBLANK(pres),
			    BLANK(),
			    IF(over > 0, over, BLANK())
			)
		displayFolder: Medidas secundarias
		lineageTag: 55b299d8-d4d1-4031-aa66-95c2cb5cccb0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Presupuesto remanente visible' =
			
			VAR pres = [Presupuesto total Visible]
			VAR ejec = [Costo ejecutado visible]
			VAR comp = [Costo comprometido visible]
			VAR rem  = pres - ejec - comp
			RETURN
			IF( ISBLANK(pres), BLANK(), rem )
		displayFolder: Medidas secundarias
		lineageTag: 565a15b8-7e54-4af9-a0d3-738d16a8d4ab

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Ejecutado dentro presupuesto' =
			
			VAR pres = COALESCE([Presupuesto total], 0)
			VAR ejec = COALESCE([Costo ejecutado visible], 0)
			VAR valor = MIN(ejec, pres)
			RETURN
			IF(valor = 0, BLANK(), valor)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 53fd3e7e-46ad-4128-b19a-9f70bad7305c

	measure 'Ejecutado excedente' =
			
			VAR pres = COALESCE([Presupuesto total], 0)
			VAR ejec = COALESCE([Costo ejecutado visible], 0)
			VAR exc  = MAX(ejec - pres, 0)
			RETURN
			IF(exc = 0, BLANK(), exc)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 1ce122ed-f800-46c0-bd70-cb22b07e29a4

	measure 'Comprometido dentro presupuesto' =
			
			VAR pres = COALESCE([Presupuesto total], 0)
			VAR ejec = COALESCE([Costo ejecutado visible], 0)
			VAR comp = COALESCE([Costo comprometido visible], 0)
			
			VAR ejec_dentro = MIN(ejec, pres)
			VAR saldo_pres  = MAX(pres - ejec_dentro, 0)
			VAR comp_dentro = MIN(comp, saldo_pres)
			
			RETURN
			IF(comp_dentro = 0, BLANK(), comp_dentro)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 515d5e0e-8a31-4934-b669-b244b0c73990

	measure 'Comprometido excedente' =
			
			VAR pres = COALESCE([Presupuesto total], 0)
			VAR ejec = COALESCE([Costo ejecutado visible], 0)
			VAR comp = COALESCE([Costo comprometido visible], 0)
			
			VAR ejec_dentro = MIN(ejec, pres)
			VAR saldo_pres  = MAX(pres - ejec_dentro, 0)
			VAR comp_exceso = MAX(comp - saldo_pres, 0)
			
			RETURN
			IF(comp_exceso = 0, BLANK(), comp_exceso)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: adc04a94-42e1-4705-b2b0-8e76862e8790

	measure 'Dentro presupuesto visual' =
			
			[Ejecutado dentro presupuesto] +
			[Comprometido dentro presupuesto]
		lineageTag: b2aef6cf-0969-485b-b772-dd79f020b8a4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Excedente visual' =
			
			[Ejecutado excedente] +
			[Comprometido excedente]
		lineageTag: 484eeb62-984a-4d9f-b552-5e476e3254f7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% Ejecución visible' =
			
			VAR pres = [Presupuesto total Visible]
			VAR cons = [Consumo total visible]
			RETURN
			IF(
			    ISBLANK(pres),
			    BLANK(),
			    DIVIDE(cons, pres)
			)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: a72059bb-46d7-4921-ac49-b5addbba55c0

	measure '% Consumo presupuesto' =
			
			VAR pres = [Presupuesto total Visible]
			VAR cons = [Consumo total visible]
			RETURN
			IF(
			    ISBLANK(pres) || pres = 0,
			    BLANK(),
			    DIVIDE(cons, pres)
			)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: Medidas secundarias
		lineageTag: d6a809fa-801f-4240-a638-fbef33775db1

	measure 'Consumo % visible' =
			
			VAR p = [% Consumo presupuesto]
			RETURN
			IF(
			    ISBLANK(p),
			    BLANK(),
			    MIN(p, 1)
			)
		displayFolder: Medidas secundarias
		lineageTag: 8449ce62-de63-4639-85e9-db682947a93e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Restante % visible' =
			
			VAR p = [% Consumo presupuesto]
			RETURN
			IF(
			    ISBLANK(p),
			    BLANK(),
			    MAX(1 - p, 0)
			)
		displayFolder: Medidas secundarias
		lineageTag: 71aa4191-a648-4c06-9ece-4177f0d71467

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Exceso % visible' =
			
			VAR p = [% Consumo presupuesto]
			RETURN
			IF(
			    ISBLANK(p),
			    BLANK(),
			    MAX(p - 1, 0)
			)
		displayFolder: Medidas secundarias
		lineageTag: 5b82b356-1cae-4a4f-a72e-6a5c292cdf60

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% Consumo presupuesto texto' =
			
			VAR p = [% Consumo presupuesto]
			RETURN
			IF(
			    ISBLANK(p),
			    BLANK(),
			    FORMAT(p, "0.0%")
			)
		displayFolder: Medidas secundarias
		lineageTag: 8f282c86-7671-4441-a90d-0026d4da91e4

	measure 'Card HTML - Presupuesto Total' =
			
			
			VAR Titulo = "Presupuesto total"
			
			VAR ValorPrincipal =
			    FORMAT([Presupuesto total Visible] / 1000000, "$ #,0.00") & " mill."
			
			VAR ValorIncidencia =
			    FORMAT([% Incidencia], "0.0%")
			
			VAR TextoSalud = "No disponible"
			
			VAR ColorPrincipal = "#111827"
			VAR ColorTextoSec = "#6B7280"
			VAR FondoTarjeta = "#FFFFFF"
			VAR Borde = "#E5E7EB"
			VAR FondoBarra = "#D1D5DB"
			VAR FondoFooter = "#F3F4F6"
			VAR ColorSalud = "#9CA3AF"
			
			RETURN
			"
			<div style='
			    font-family: Segoe UI, Arial, sans-serif;
			    background:" & FondoTarjeta & ";
			    border:1px solid " & Borde & ";
			    border-radius:16px;
			    padding:10px 10px 8px 10px;
			    width:100%;
			    height:100%;
			    box-sizing:border-box;
			    box-shadow:0 2px 6px rgba(0,0,0,0.05);
			'>
			    <div style='font-size:13px; color:" & ColorTextoSec & "; font-weight:600; margin-bottom:5px;'>
			        " & Titulo & "
			    </div>
			
			    <div style='font-size:24px; color:" & ColorPrincipal & "; font-weight:700; line-height:1.05; margin-bottom:8px;'>
			        " & ValorPrincipal & "
			    </div>
			
			    <div style='margin-bottom:4px;'>
			        <div style='font-size:12px; color:" & ColorTextoSec & "; margin-bottom:1px;'>
			            Participación del presupuesto: " & ValorIncidencia & "
			        </div>
			    </div>
			
			    <div style='margin-bottom:8px;'>
			        <div style='font-size:12px; color:" & ColorTextoSec & "; margin-bottom:1px;'>
			            &nbsp;
			        </div>
			    </div>
			
			    <div style='
			        background:" & FondoFooter & ";
			        border-radius:10px;
			        padding:6px 8px;
			    '>
			        <div style='
			            display:flex;
			            justify-content:space-between;
			            align-items:center;
			            margin-bottom:4px;
			            font-size:10px;
			            color:" & ColorTextoSec & ";
			            font-weight:600;
			        '>
			            <span>Salud del presupuesto</span>
			            <span>" & TextoSalud & "</span>
			        </div>
			
			        <div style='
			            width:100%;
			            height:8px;
			            background:" & FondoBarra & ";
			            border-radius:999px;
			            overflow:hidden;
			            display:flex;
			        '>
			            <div style='
			                width:0%;
			                background:" & ColorSalud & ";
			                height:100%;
			                border-radius:999px;
			            '></div>
			        </div>
			    </div>
			</div>
			"
		displayFolder: Medidas tarjeta presupuesto total
		lineageTag: c3d164ed-9722-4d23-9205-f62c3530d51a

	measure 'Sobrecosto visible' =
			
			VAR v = [Consumo total visible] - [Presupuesto total Visible]
			RETURN
			IF(v > 0, v, 0)
		displayFolder: Medidas tarjeta presupuesto remanente
		lineageTag: d1e21020-978a-4bed-b344-4d87c0dd869d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% Sobrecosto' =
			
			VAR pres = [Presupuesto total Visible]
			VAR over = [Sobrecosto visible]
			RETURN
			DIVIDE(over, pres)
		displayFolder: Medidas tarjeta presupuesto remanente
		lineageTag: 2a3d5546-7a6c-43fe-8080-5ed40dd05ff5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% Sobrecosto texto' =
			
			FORMAT([% Sobrecosto], "0.0%")
		displayFolder: Medidas tarjeta presupuesto remanente
		lineageTag: 56ddc1b5-1442-41a7-b3dd-72039dcc4a9e

	measure 'Presupuesto remanente visible tarjeta' =
			
			VAR v = [Presupuesto total Visible] - [Consumo total visible]
			RETURN
			IF(v > 0, v, 0)
		displayFolder: Medidas tarjeta presupuesto remanente
		lineageTag: 48f5938e-a1df-4a90-bc07-0f7bd324f555

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Card HTML - Presupuesto disponible' =
			
			
			VAR Titulo = "Presupuesto disponible"
			
			VAR ValorPrincipal =
			    FORMAT([Presupuesto remanente visible tarjeta] / 1000000, "$ #,0.00") & " mill."
			
			VAR ValorSobrecosto =
			    FORMAT([Sobrecosto visible] / 1000000, "$ #,0.00") & " mill."
			
			VAR Porcentaje = [% Sobrecosto]
			VAR PorcentajeTexto = FORMAT(Porcentaje, "0.0%")
			
			VAR BarraWidth =
			    SUBSTITUTE(FORMAT(MIN(Porcentaje * 100, 100), "0.0"), ",", ".")
			
			VAR ColorPrincipal = "#111827"
			VAR ColorTextoSec = "#6B7280"
			VAR FondoTarjeta = "#FFFFFF"
			VAR Borde = "#E5E7EB"
			VAR FondoBarra = "#D1D5DB"
			VAR FondoFooter = "#F3F4F6"
			VAR ColorSobrecosto = "#DC2626"
			
			RETURN
			"
			<div style='
			    font-family: Segoe UI, Arial, sans-serif;
			    background:" & FondoTarjeta & ";
			    border:1px solid " & Borde & ";
			    border-radius:16px;
			    padding:10px 10px 8px 10px;
			    width:100%;
			    height:100%;
			    box-sizing:border-box;
			    box-shadow:0 2px 6px rgba(0,0,0,0.05);
			'>
			    <div style='font-size:13px; color:" & ColorTextoSec & "; font-weight:600; margin-bottom:5px;'>
			        " & Titulo & "
			    </div>
			
			    <div style='font-size:24px; color:" & ColorPrincipal & "; font-weight:700; line-height:1.05; margin-bottom:8px;'>
			        " & ValorPrincipal & "
			    </div>
			
			    <div style='margin-bottom:4px;'>
			        <div style='font-size:12px; color:" & ColorTextoSec & "; margin-bottom:1px;'>
			            Sobrepresupuesto: " & ValorSobrecosto & "
			        </div>
			    </div>
			
			    <div style='margin-bottom:7px;'>
			        <div style='font-size:12px; color:" & ColorTextoSec & "; margin-bottom:1px;'>
			            &nbsp;
			        </div>
			    </div>
			
			    <div style='
			        background:" & FondoFooter & ";
			        border-radius:10px;
			        padding:6px 8px;
			    '>
			        <div style='
			            display:flex;
			            justify-content:space-between;
			            align-items:center;
			            margin-bottom:4px;
			            font-size:10px;
			            color:" & ColorTextoSec & ";
			            font-weight:600;
			        '>
			            <span>Nivel sobrepresupuesto</span>
			            <span>" & PorcentajeTexto & "</span>
			        </div>
			
			        <div style='
			            width:100%;
			            height:8px;
			            background:" & FondoBarra & ";
			            border-radius:999px;
			            overflow:hidden;
			            display:flex;
			        '>
			            <div style='
			                width:" & BarraWidth & "%;
			                background:" & ColorSobrecosto & ";
			                height:100%;
			                border-radius:999px;
			            '></div>
			        </div>
			    </div>
			</div>
			"
		displayFolder: Medidas tarjeta presupuesto remanente
		lineageTag: 9436ad94-2aaa-4091-aa85-adb105f8546a

	measure 'Cantidad ODC cerradas' = DISTINCTCOUNT(Fact_ordenes_de_compra[Orden de Compra])
		formatString: 0
		displayFolder: Medidas tarjeta consumo total
		lineageTag: fdc76a9b-8a93-4fca-9e9e-a260a31b8231

	measure 'Cantidad NFC' = DISTINCTCOUNT(Fact_facturas_conformadas[Número interno])
		formatString: 0
		displayFolder: Medidas tarjeta consumo total
		lineageTag: 3166b530-c97a-4920-9ddc-b4a06e59078a

	measure 'Cantidad SOLPED abiertas' = DISTINCTCOUNT(Fact_solicitud_de_pedido[ID de documento interno])
		formatString: 0
		displayFolder: Medidas tarjeta consumo total
		lineageTag: 7fa18ca8-3eab-42e5-8717-1137940d358f

	measure 'Card HTML - Consumo Total' =
			
			VAR Titulo = "Consumo total"
			
			VAR Ejecutado = [Costo ejecutado visible]
			VAR Comprometido = [Costo comprometido visible]
			VAR ConsumoTotal = Ejecutado + Comprometido
			
			VAR ValorPrincipal =
			    FORMAT(ConsumoTotal / 1000000, "$ #,0.00") & " mill."
			
			VAR ValorEjecutado =
			    FORMAT(Ejecutado / 1000000, "$ #,0.00") & " mill."
			
			VAR ValorComprometido =
			    FORMAT(Comprometido / 1000000, "$ #,0.00") & " mill."
			
			VAR PorcentajeReal = [% Consumo presupuesto]
			VAR Porcentaje = MIN(PorcentajeReal, 1)
			VAR PorcentajeTexto = FORMAT(Porcentaje, "0.0%")
			
			VAR ConsumoWidth = MIN(Porcentaje,1) * 100
			VAR RestanteWidth = MAX(1 - Porcentaje,0) * 100
			VAR ExcesoWidth = MAX(Porcentaje - 1,0) * 100
			
			VAR WidthConsumo = SUBSTITUTE(FORMAT(ConsumoWidth,"0.0"), ",", ".")
			VAR WidthRestante = SUBSTITUTE(FORMAT(RestanteWidth,"0.0"), ",", ".")
			VAR WidthExceso = SUBSTITUTE(FORMAT(MIN(ExcesoWidth,100),"0.0"), ",", ".")
			
			VAR ColorPrincipal = "#111827"
			VAR ColorTextoSec = "#6B7280"
			VAR FondoTarjeta = "#FFFFFF"
			VAR Borde = "#E5E7EB"
			VAR FondoBarra = "#EEF2F7"
			VAR FondoFooter = "#F3F4F6"
			
			VAR ColorConsumo =
			    SWITCH(
			        TRUE(),
			        Porcentaje < 0.8, "#16A34A",   -- verde
			        Porcentaje < 1, "#F59E0B",     -- amarillo
			        "#DC2626"                      -- rojo SOLO en 100%
			    )
			
			VAR ColorRestante = "#D1D5DB"
			VAR ColorExceso = "#DC2626"
			
			RETURN
			"
			<div style='
			    font-family: Segoe UI, Arial, sans-serif;
			    background:" & FondoTarjeta & ";
			    border:1px solid " & Borde & ";
			    border-radius:16px;
			    padding:10px 10px 8px 10px;
			    width:100%;
			    height:100%;
			    box-sizing:border-box;
			    box-shadow:0 2px 6px rgba(0,0,0,0.05);
			'>
			    <div style='font-size:13px; color:" & ColorTextoSec & "; font-weight:600; margin-bottom:5px;'>
			        " & Titulo & "
			    </div>
			
			    <div style='font-size:24px; color:" & ColorPrincipal & "; font-weight:700; line-height:1.05; margin-bottom:8px;'>
			        " & ValorPrincipal & "
			    </div>
			
			    <div style='margin-bottom:4px;'>
			        <div style='font-size:12px; color:" & ColorPrincipal & "; font-weight:600; margin-bottom:1px;'>
			            Costo ejecutado&nbsp;&nbsp;&nbsp;&nbsp;" & ValorEjecutado & "
			        </div>
			    </div>
			
			    <div style='margin-bottom:8px;'>
			        <div style='font-size:12px; color:" & ColorPrincipal & "; font-weight:600; margin-bottom:1px;'>
			            Costo comprometido&nbsp;" & ValorComprometido & "
			        </div>
			    </div>
			
			    <div style='
			        background:" & FondoFooter & ";
			        border-radius:10px;
			        padding:6px 8px;
			    '>
			        <div style='
			            display:flex;
			            justify-content:space-between;
			            align-items:center;
			            margin-bottom:4px;
			            font-size:10px;
			            color:" & ColorTextoSec & ";
			            font-weight:600;
			        '>
			            <span>Consumo del presupuesto</span>
			            <span>" & PorcentajeTexto & "</span>
			        </div>
			
			        <div style='
			            width:100%;
			            height:8px;
			            background:" & FondoBarra & ";
			            border-radius:999px;
			            overflow:hidden;
			            display:flex;
			        '>
			            <div style='width:" & WidthConsumo & "%; background:" & ColorConsumo & "; height:100%; border-radius:999px;'></div>
			            <div style='width:" & WidthRestante & "%; background:" & ColorRestante & ";'></div>
			        </div>
			    </div>
			</div>
			"
