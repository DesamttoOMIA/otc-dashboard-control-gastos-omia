		lineageTag: 3f2d1a87-6f11-4d12-acbc-0441157448ec

	measure 'Notif gestion html' =
			
			VAR _t =
			    FILTER (
			        'Notificaciones gestion',
			        'Notificaciones gestion'[Proyecto] IN VALUES ( Dim_proyecto[Código de proyecto] )
			    )
			VAR _n = COUNTROWS ( _t ) + 0
			VAR _bell = "<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#1B4379' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9'/><path d='M13.7 21a2 2 0 0 1-3.4 0'/></svg>"
			VAR _cab =
			    "<div style='display:flex;align-items:center;gap:8px;margin-bottom:8px'>" & _bell
			        & "<span style='font-size:14px;font-weight:700;color:#1B2433'>Notificaciones de gestión</span>"
			        & "<span style='font-size:13px;color:#5A6475'>· " & _n & IF ( _n = 1, " notificación", " notificaciones" ) & "</span></div>"
			VAR _tarjetas =
			    CONCATENATEX (
			        _t,
			        VAR _o = 'Notificaciones gestion'[Orden]
			        VAR _det = 'Notificaciones gestion'[Detalle] & ""
			        VAR _v = 'Notificaciones gestion'[Valor]
			        VAR _d = 'Notificaciones gestion'[Días]
			        VAR _tag =
			            SWITCH (
			                _o,
			                1, "SOLPED sin OC",
			                2, IF ( CONTAINSSTRING ( _det, "sobre" ), "SOLPED · línea sobrepresup.", "SOLPED · línea sin ppto" ),
			                3, "OC más cara que SOLPED",
			                4, "Factura conformada",
			                5, "EM sin factura",
			                6, IF ( LEFT ( _det, 7 ) = "Vencida", "Factura vencida", "Factura por vencer" )
			            )
			        VAR _pref = SWITCH ( _o, 1, "SOLPED ", 2, "SOLPED ", 3, "OC ", 4, "FC ", 5, "EM ", 6, "Factura " )
			        VAR _val =
			            IF ( _v >= 1E6, "$ " & FORMAT ( _v / 1E6, "#,##0.0" ) & " M", "$ " & FORMAT ( _v, "#,##0" ) )
			        VAR _prov =
			            SUBSTITUTE ( SUBSTITUTE ( 'Notificaciones gestion'[Proveedor / descripción] & "", "&", "&amp;" ), "<", "&lt;" )
			        VAR _ree = 'Notificaciones gestion'[Línea REE] & ""
			        VAR _detH = SUBSTITUTE ( SUBSTITUTE ( _det, "&", "&amp;" ), "<", "&lt;" )
			        VAR _pillDias =
			            IF (
			                ISBLANK ( _d ) || _o = 6,
			                "",
			                "<span style='font-size:10.5px;font-weight:600;color:#3A4352;background:#EEF1F5;border-radius:999px;padding:0 7px;white-space:nowrap'>" & _d & " d</span>"
			            )
			        RETURN
			            "<div style='background:#FFFFFF;border:1px solid #DCE1E8;border-left:3px solid #2B79BA;border-radius:6px;padding:6px 10px;margin-bottom:6px'>"
			                & "<div style='display:flex;justify-content:space-between;align-items:center;gap:8px'>"
			                & "<div style='display:flex;align-items:center;gap:6px;min-width:0'>"
			                & "<span style='font-size:10px;font-weight:700;color:#1B4379;background:#EAF1F8;border-radius:4px;padding:1px 6px;white-space:nowrap'>" & _tag & "</span>"
			                & "<span style='font-size:12.5px;font-weight:700;color:#1B2433;white-space:nowrap'>" & _pref & 'Notificaciones gestion'[Documento] & "</span></div>"
			                & "<span style='font-size:12.5px;font-weight:700;color:#1B2433;white-space:nowrap'>" & _val & "</span></div>"
			                & "<div style='display:flex;justify-content:space-between;align-items:center;gap:8px;margin-top:2px'>"
			                & "<span style='font-size:11.5px;color:#3A4352;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>" & _detH & "</span>" & _pillDias & "</div>"
			                & "<div style='font-size:11px;color:#5A6475;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>" & _prov & " · " & _ree & "</div>"
			                & "</div>",
			        "",
			        'Notificaciones gestion'[Orden], ASC,
			        'Notificaciones gestion'[Días], DESC,
			        'Notificaciones gestion'[Valor], DESC
			    )
			VAR _vacio =
			    "<div style='font-size:12px;color:#5A6475;padding:12px;border:1px dashed #C9D1DC;border-radius:6px'>Sin notificaciones de gestión en este corte.</div>"
			RETURN
			    "<div style='font-family:Segoe UI,sans-serif;height:100%;overflow-y:auto;padding-right:4px'>"
			        & _cab & IF ( _n = 0, _vacio, _tarjetas ) & "</div>"
		lineageTag: 06c58a44-0d3d-4534-a8b6-cdaa7939c69a

	measure '% Presupuesto tarjeta' =
			
			DIVIDE (
			    [Presupuesto vista],
			    CALCULATE ( [Presupuesto vista], REMOVEFILTERS ( Dim_categoria ), REMOVEFILTERS ( Dim_subseco ) )
			)
		lineageTag: fcc923e6-725b-4559-9bc6-ce7962e9921a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% Consumo tarjeta' =
			
			DIVIDE ( [Consumo vista], [Presupuesto vista] )
		lineageTag: 503ddc8c-055d-4b44-93d8-eef6763bb916

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'SVG Presupuesto tarjeta' =
			
			VAR _p = [% Presupuesto tarjeta]
			VAR _arc = ROUND ( MIN ( MAX ( _p, 0 ), 1 ) * 100, 0 )
			VAR _txt = FORMAT ( ROUND ( _p * 100, 0 ), "0" ) & "%25"
			RETURN
			    IF (
			        NOT ISBLANK ( _p ),
			        "data:image/svg+xml;utf8,"
			            & "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'>"
			            & "<circle cx='50' cy='50' r='40' fill='none' stroke='white' stroke-opacity='0.25' stroke-width='9'/>"
			            & "<circle cx='50' cy='50' r='40' fill='none' stroke='white' stroke-width='9' pathLength='100' stroke-dasharray='" & _arc & " 100' transform='rotate(-90 50 50)'/>"
			            & "<text x='50' y='51' text-anchor='middle' dominant-baseline='central' font-family='Segoe UI, Arial' font-weight='700' font-size='22' fill='white'>" & _txt & "</text>"
			            & "</svg>"
			    )
		lineageTag: 178f8981-0c9b-43df-b2ce-130af68d80fb
		dataCategory: ImageUrl

	measure 'SVG Consumo tarjeta' =
			
			VAR _c = [Consumo vista]
			VAR _b = [Presupuesto vista]
			VAR _sinPpto = NOT ( _b > 0 ) && _c > 0
			VAR _p = [% Consumo tarjeta]
			VAR _arc = IF ( _sinPpto, 100, ROUND ( MIN ( MAX ( _p, 0 ), 1 ) * 100, 0 ) )
			VAR _txt = IF ( _sinPpto, "s/ppto", FORMAT ( ROUND ( _p * 100, 0 ), "0" ) & "%25" )
			VAR _fs = IF ( _sinPpto, 17, 22 )
			VAR _col = IF ( _sinPpto || _p >= 1, "%23E7344C", IF ( _p >= 0.8, "%23F8AC06", "white" ) )
			RETURN
			    IF (
			        _sinPpto || NOT ISBLANK ( _p ),
			        "data:image/svg+xml;utf8,"
			            & "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'>"
			            & "<circle cx='50' cy='50' r='40' fill='none' stroke='white' stroke-opacity='0.25' stroke-width='9'/>"
			            & "<circle cx='50' cy='50' r='40' fill='none' stroke='" & _col & "' stroke-width='9' pathLength='100' stroke-dasharray='" & _arc & " 100' transform='rotate(-90 50 50)'/>"
			            & "<text x='50' y='51' text-anchor='middle' dominant-baseline='central' font-family='Segoe UI, Arial' font-weight='700' font-size='" & _fs & "' fill='white'>" & _txt & "</text>"
			            & "</svg>"
			    )
		lineageTag: 89493fe2-a415-43b7-8788-6ee31c532e85
		dataCategory: ImageUrl

	measure 'Valor etapa' =
			
			VAR _o = SELECTEDVALUE ( Dim_etapa[Orden etapa] )
			RETURN
			    SWITCH (
			        _o,
			        1, [SOLPED pendiente por ordenar],
			        2, [OC pendiente por recibir],
			        3, [FC pendiente por facturar],
			        4, [EM pendiente por facturar],
			        5, [FP pendiente por pagar],
			        6, [Pago efectuado]
			    )
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 91a1fe49-b3ee-4e36-a7e4-1d827c0ca9da

	measure 'Consumo vista' =
			
			IF (
			    ISFILTERED ( Dim_etapa ),
			    SUMX ( VALUES ( Dim_etapa[Orden etapa] ), [Valor etapa] ),
			    [Consumo Total]
			)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 80de75a4-9e3c-4c50-9288-1331afed932e

	measure 'Presupuesto Contrato' =
			
			SUMX (
			    VALUES ( Dim_proyecto[Id proyecto] ),
			    VAR _mensual = CALCULATE ( SUM ( Fact_presupuesto_final[COP] ) )
			    VAR _plazo   = COALESCE ( CALCULATE ( MAX ( Dim_proyecto[Plazo meses] ) ), 12 )
			    RETURN _mensual * _plazo
			)
		formatString: \$\ #,0.###############;-\$\ #,0.###############;\$\ #,0.###############
		displayFolder: Vista general
		lineageTag: 5c6a8f06-0fb0-4a29-90cc-c439628fe1c1

		annotation PBI_FormatHint = {"currencyCulture":"es-CO"}

	measure 'Presupuesto Anual' =
			
			SUMX (
			    VALUES ( Dim_proyecto[Id proyecto] ),
			    CALCULATE ( SUM ( Fact_presupuesto_final[COP] ) ) * 12
			)
		formatString: \$\ #,0.###############;-\$\ #,0.###############;\$\ #,0.###############
		displayFolder: Vista general
		lineageTag: b9ea4c4f-117d-41f8-9bda-bed4305413fe

		annotation PBI_FormatHint = {"currencyCulture":"es-CO"}

	measure 'Texto horizonte' =
			
			VAR _proy  = SELECTEDVALUE ( Dim_proyecto[Nombre de proyecto], "Varios proyectos" )
			VAR _ini   = MIN ( Dim_proyecto[FechaInicioContrato] )
			VAR _fin   = MAX ( Dim_proyecto[FechaFinContrato] )
			VAR _plazo = MAX ( Dim_proyecto[Plazo meses] )
			RETURN
			    IF (
			        NOT ISBLANK ( _ini ),
			        _proy & " · Contrato " & _plazo & " meses · " & FORMAT ( _ini, "mmm yyyy" ) & " a " & FORMAT ( _fin, "mmm yyyy" ),
			        _proy & " · Montos acumulados del contrato"
			    )
		displayFolder: Vista general
		lineageTag: ad289f34-18f3-4a66-a77d-ecfc6dbd4068

	measure 'Texto contrato' = VAR _p = SELECTEDVALUE ( Dim_proyecto[Nombre de proyecto] ) VAR _ini = MIN ( Dim_proyecto[FechaInicioContrato] ) VAR _fin = MAX ( Dim_proyecto[FechaFinContrato] ) VAR _pl = MAX ( Dim_proyecto[Plazo meses] ) RETURN "Contrato " & _p & " · " & _pl & " meses · " & FORMAT ( _ini, "d mmm yyyy" ) & " a " & FORMAT ( _fin, "d mmm yyyy" )
		lineageTag: de3286a3-8ae6-4ffc-8dfe-2625d54a5d76

	measure 'Texto periodo' =
			
			VAR _ini = CALCULATE ( MIN ( Fact_solicitud_de_pedido[Fecha de documento] ),
			    REMOVEFILTERS ( Dim_categoria ), REMOVEFILTERS ( Dim_subseco ),
			    REMOVEFILTERS ( Dim_reembolsable ), REMOVEFILTERS ( Dim_etapa ) )
			VAR _fin = CALCULATE ( MAX ( Fact_solicitud_de_pedido[Fecha de documento] ),
			    REMOVEFILTERS ( Dim_categoria ), REMOVEFILTERS ( Dim_subseco ),
			    REMOVEFILTERS ( Dim_reembolsable ), REMOVEFILTERS ( Dim_etapa ) )
			RETURN "Periodo analizado — " & FORMAT ( _ini, "d mmm yyyy" ) & " a " & FORMAT ( _fin, "d mmm yyyy" )
		lineageTag: 028bb6a0-5e1f-4b1d-8231-7c477544418e

	measure 'Texto actualizado' = "Actualizado — " & FORMAT ( MAX ( Actualizacion[Fecha] ), "d mmm yyyy · hh:mm" ) & " · diario"
		lineageTag: c6dc712c-8ad9-468c-a78b-abb6ac01eb4c

	measure 'Alertas texto' = VAR _n = COUNTROWS ( FILTER ( ALL ( Dim_categoria ), UPPER ( Dim_categoria[TieneHijos] & "" ) = "FALSE" && NOT ISBLANK ( [Estado alerta] ) ) ) RETURN FORMAT ( _n + 0, "0" )
		lineageTag: 3ac0bb75-a183-467b-9398-84cdb996796d

	measure 'Presupuesto mensual' = SUM ( Fact_presupuesto_final[COP] )
		formatString: \$\ #,0.###############;-\$\ #,0.###############;\$\ #,0.###############
		displayFolder: Vista general
		lineageTag: 020e385e-2748-4f3a-981e-39905f3201cc

		annotation PBI_FormatHint = {"currencyCulture":"es-CO"}

	measure 'Mes contrato' =
			
			VAR _ini = MIN ( Dim_proyecto[FechaInicioContrato] )
			VAR _hoy = MAX ( Actualizacion[Fecha] )
			VAR _pl  = MAX ( Dim_proyecto[Plazo meses] )
			VAR _m   = INT ( DIVIDE ( _hoy - _ini, 30.4375 ) ) + 1
			RETURN MIN ( _pl, MAX ( 0, _m ) )
		formatString: 0
		displayFolder: Vista general
		lineageTag: 931ee7f7-8fef-4228-ae66-9b28fc1bd24b

	measure 'Texto mes contrato' = [Mes contrato] & " de " & MAX ( Dim_proyecto[Plazo meses] )
		displayFolder: Vista general
		lineageTag: acca5c27-7f6c-47ad-a6ab-88f615afbb7b

	measure 'Meses restantes' = MAX ( Dim_proyecto[Plazo meses] ) - [Mes contrato] + 1
		formatString: 0
		displayFolder: Vista general
		lineageTag: 41be1640-1477-4ffb-b97e-a8d5799d0061

	measure 'En gestión SOLPED' = CALCULATE ( [Valor etapa], Dim_etapa[Orden etapa] = 1 )
		displayFolder: Vista general
		lineageTag: 5cfabd4c-5f6a-42ad-89db-e86a2b9310d9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Ya comprometido' = [Consumo vista] - [En gestión SOLPED]
		displayFolder: Vista general
		lineageTag: a0baee07-dfbb-4afd-84bf-2157f4d21951

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Disponible por mes' = DIVIDE ( [Disponible Anual], [Meses restantes] )
		displayFolder: Vista general
		lineageTag: 39b228c9-efc1-4031-a23b-92b18156264b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'SVG Disponible tarjeta' = VAR _b = [Presupuesto vista] VAR _c = [Consumo vista] VAR _p = DIVIDE ( _b - _c, _b ) VAR _arc = ROUND ( MIN ( MAX ( _p, 0 ), 1 ) * 100, 0 ) VAR _txt = FORMAT ( ROUND ( _p * 100, 0 ), "0" ) & "%25" VAR _col = IF ( _p <= 0, "%23E7344C", IF ( _p <= 0.2, "%23F8AC06", "%23252423" ) ) RETURN IF ( _b > 0, "data:image/svg+xml;utf8," & "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'>" & "<circle cx='50' cy='50' r='40' fill='none' stroke='%23252423' stroke-opacity='0.15' stroke-width='9'/>" & "<circle cx='50' cy='50' r='40' fill='none' stroke='" & _col & "' stroke-width='9' pathLength='100' stroke-dasharray='" & _arc & " 100' transform='rotate(-90 50 50)'/>" & "<text x='50' y='51' text-anchor='middle' dominant-baseline='central' font-family='Segoe UI, Arial' font-weight='700' font-size='22' fill='%23252423'>" & _txt & "</text>" & "</svg>" )
		lineageTag: cdd976cf-41f2-44a3-8bd6-84a253c0f490
		dataCategory: ImageUrl

	measure 'Color badge alertas' = IF ( VALUE ( [Alertas texto] ) > 0, "#E7344C", "#FFFFFF00" )
		lineageTag: 5a0cec3d-0497-4098-b54d-099055345135

	partition _Medidas = m
		mode: import
		source =
				let
				    Origen = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Columna1 = _t]),
				    #"Tipo cambiado" = Table.TransformColumnTypes(Origen,{{"Columna1", type text}}),
				    #"Columnas quitadas" = Table.RemoveColumns(#"Tipo cambiado",{"Columna1"})
				in
				    #"Columnas quitadas"

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

