	measure 'Card HTML - Factura Conformada' =
			
			
			VAR ValorPrincipal =
			    FORMAT([Total factura conformada] / 1000000, "$ #,0.00") & " mill."
			
			VAR CantidadDocs =
			    FORMAT([Cantidad de facturas conformadas], "#,0")
			
			VAR FondoTarjeta = "#FFFFFF"
			VAR Borde = "#E5E7EB"
			VAR FondoSec = "#F3F4F6"
			
			VAR TextoTitulo = "#6B7280"
			VAR TextoPrincipal = "#111827"
			VAR TextoSec = "#374151"
			
			RETURN
			"
			<div style='
			    width:100%;
			    height:100%;
			    font-family: Segoe UI, Arial, sans-serif;
			    background:" & FondoTarjeta & ";
			    border:1px solid " & Borde & ";
			    border-radius:16px;
			    padding:12px 12px 10px 12px;
			    box-sizing:border-box;
			    box-shadow:0 2px 6px rgba(0,0,0,0.05);
			'>
			    <div style='
			        font-size:13px;
			        color:" & TextoTitulo & ";
			        font-weight:600;
			        margin-bottom:6px;
			    '>
			        Factura conformada
			    </div>
			
			    <div style='
			        font-size:26px;
			        font-weight:700;
			        color:" & TextoPrincipal & ";
			        line-height:1.05;
			        margin-bottom:10px;
			    '>
			        " & ValorPrincipal & "
			    </div>
			
			    <div style='
			        background:" & FondoSec & ";
			        border-radius:12px;
			        padding:10px 12px;
			        font-size:12px;
			        color:" & TextoSec & ";
			        line-height:1.5;
			        min-height:58px;
			        display:flex;
			        flex-direction:column;
			        justify-content:center;
			    '>
			        <div>Cantidad de documentos: " & CantidadDocs & "</div>
			    </div>
			</div>
			"
		displayFolder: Medidas tabla detalle documental
		lineageTag: bb2e5ff3-5cc9-427c-84d4-b47b6c318308

	measure 'Card HTML - ODC Cerradas' =
			
			
