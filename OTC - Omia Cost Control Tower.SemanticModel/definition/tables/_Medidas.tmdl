		lineageTag: d138c16b-ca15-4e87-9d78-dcbb8220e467

		annotation PBI_FormatHint = {"currencyCulture":"es-CO"}

	measure 'Cantidad de facturas conformadas' = CALCULATE(DISTINCTCOUNT(Fact_detalle_documental[Número de documento]),Fact_detalle_documental[Tipo de documento] = "Factura conformada")
		formatString: 0
