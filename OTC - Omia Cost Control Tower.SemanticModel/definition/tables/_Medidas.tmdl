		displayFolder: Medidas tabla detalle documental
		lineageTag: 8937480d-3d3f-484e-8918-ed65bb4d6c93

	measure 'Card HTML - SOLPED Abiertas' =
			
			
			VAR ValorPrincipal =
			    FORMAT([Total solicitud de pedido abierta] / 1000000, "$ #,0.00") & " mill."
			
			VAR CantidadDocs =
