	column jerarquia = ```
			
			VAR Codigo = LEFT('Presupuesto'[Categoria de costos], 3)
			
			RETURN
			SWITCH(
			    Codigo,
			    "1.1", "1.1  Materiales y/o repuestos",
			    "1.2", "1.2  Remuneraciones",
			    "1.5", "1.5  Herramientas, Instrumentos y Consumibles",
			    "1.6", "1.6  Equipos Directos",
			    "1.7", "1.7  Fletes y Transportes:",
			    "2.1", "2.1  Remuneraciones",
			    "2.2", "2.2  Equipos Indirectos",
			    -- Si NO es un grupo azul (ej. 1.3, 1.4, 1.8, 1.9, 2.3), 
			    -- devuelve su propio nombre para que quede alineado correctamente:
			    'Presupuesto'[Categoria de costos] 
			)
			```
		lineageTag: 318e67ce-3c07-488c-953f-c439626dd519
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

