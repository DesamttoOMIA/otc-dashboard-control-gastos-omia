	partition Fact_bitacora_documental = m
		mode: import
		source =
				let
				    Origen = Table.Combine({stg_solicitud_de_pedido, stg_orden_de_compra, stg_entrada_de_mercancia_factura_conformada, stg_solped_oc_fc_em_fp_pe}),
