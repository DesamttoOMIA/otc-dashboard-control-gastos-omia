table Dim_Subseco
	lineageTag: 4c475b82-8f87-4c8d-a5a6-066999bfbd9f

	column 'Distribución Costos' =
			
			SWITCH(
			    TRUE(),
			    'Dim_Subseco'[Subseco] IN {"121", "122", "131", "132", "133", "135", "136", "137", "138", "211", "212"}, "Mano de Obra",
			    'Dim_Subseco'[Subseco] IN {"161", "162", "163", "221", "222", "223"}, "Equipos",
			    'Dim_Subseco'[Subseco] IN {"111", "112", "113", "151", "152", "153"}, "Materiales & Suministros",
			    'Dim_Subseco'[Subseco] IN {"141", "181"}, "Subcontratos",
			    'Dim_Subseco'[Subseco] IN {"171", "182", "231", "232", "321", "331", "341", "351", "361", "371"}, "Otros Costos",
			    'Dim_Subseco'[Subseco] IN {"134", "191", "381"}, "Contingencia",
			    "No Categorizado" -- Valor por defecto si no coincide con ninguno
			)
		lineageTag: 5c624feb-c0a4-48bc-8a07-2afa107673d9
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Subseco
		lineageTag: f13b1f93-ffa6-4c22-899b-bc4979674584
		summarizeBy: none
		isNameInferred
		sourceColumn: [Subseco]

		annotation SummarizationSetBy = Automatic

	column Descripción
		lineageTag: 2a8c63e1-10d3-4228-b52e-048ccf9bf85f
		summarizeBy: none
		isNameInferred
		sourceColumn: [Descripción]

		annotation SummarizationSetBy = Automatic

	column Equivalencia =
			
			VAR Codigo = 'Dim_Subseco'[Subseco]
			VAR Distribucion = 'Dim_Subseco'[Distribución Costos]
			RETURN
			SWITCH(
			    TRUE(),
			    -- REGLA: Si es Contingencia o pertenece a la serie 300 (Imprevistos/Impuestos), dejar en BLANCO
			    Distribucion = "Contingencia" || LEFT(Codigo, 1) = "3", "",
			
			    -- 1.1 Materiales y/o repuestos
			    Codigo = "111", "1.1.1 Materiales de Mantenimiento",
			    Codigo = "112", "1.1.2 Materiales de Operación",
			    Codigo = "113", "1.1.3 Combustibles y Lubricantes del Cliente",
			
			    -- 1.2 Remuneraciones
			    Codigo = "121", "1.2.1 Mano de Obra Directa",
			    Codigo = "122", "1.2.2 Cargas Sociales Mano de Obra Directa",
			
			    -- 1.3 Gastos de Personal
			    Codigo IN {"131", "132", "133", "135", "136", "137", "138"}, "1.3 Gastos de Personal",
			
			    -- 1.4 Sub-Contratos
			    Codigo IN {"141", "181"}, "1.4 Sub-Contratos",
			
			    -- 1.5 Herramientas, Instrumentos y Consumibles
			    Codigo = "151", "1.5.1 Herramientas",
			    Codigo = "152", "1.5.2 Instrumentos",
			    Codigo = "153", "1.5.2 Consumibles",
			
			    -- 1.6 Equipos Directos
			    Codigo IN {"161", "162"}, "1.6.2 Vehiculos alquilados a terceros",
			    Codigo = "163", "1.6.3 Mantenimiento",
			
			    -- 1.7 Fletes y Transportes
			    Codigo = "171", "1.7.1 De materiales y repuestos",
			
			    -- 1.8 Gastos Varios Directos (Solo el 182 que pertenece a esta categoría)
			    Codigo = "182", "1.8 Gastos Varios Directos",
			
			    -- 2.1 Remuneraciones Indirectas
			    Codigo = "211", "2.1.1 Mano de Obra Indirecta",
			    Codigo = "212", "2.1.2 Cargas Sociales Mano de Obra Indirecta",
			
			    -- 2.2 Equipos Indirectos
			    Codigo = "221", "2.2.2 Vehiculos Alquilados a terceros",
			    Codigo = "222", "2.2.2 Combustible vehiculos Propios/Alquilados Indirectos",
			    Codigo = "223", "2.2.3 Mantenimiento",
			
			    -- 2.3 Gastos varios Indirectos
			    Codigo IN {"231", "232"}, "2.3 Gastos varios Indirectos",
			
			    -- Valor por defecto para cualquier otro caso no contemplado
			    ""
			)
		lineageTag: fc10e10a-3617-4cdf-8e57-8ced4fdd2734
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Tipo de Costo' = ```
			
			VAR Equiv = 'Dim_Subseco'[Equivalencia]
			RETURN
			IF(
			    Equiv = "", 
			    "", 
			    IF(
			        LEFT(Equiv, 2) = "1.", 
			        "Directo", 
			        IF(
			            LEFT(Equiv, 2) = "2.", 
			            "Indirecto", 
			            ""
			        )
			    )
			)
			```
		lineageTag: 48779b7d-c8b7-4dfd-a726-d0839a46f1d0
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

