DEFINE
MEASURE '_Medidas'[Alertas franja html] =
VAR _t =
    ADDCOLUMNS (
        FILTER ( ALL ( Dim_categoria ), UPPER ( Dim_categoria[TieneHijos] & "" ) = "FALSE" ),
        "@c", [Consumo Total],
        "@p", [Presupuesto Anual]
    )
VAR _e =
    ADDCOLUMNS (
        _t,
        "@e", IF ( [@p] > 0 && [@c] >= [@p], "S", IF ( [@p] > 0 && [@c] >= 0.8 * [@p], "C", "" ) )
    )
VAR _a = FILTER ( _e, [@e] <> "" )
VAR _k = ADDCOLUMNS ( _a, "@k", IF ( [@e] = "S", 1E13 + [@c] - [@p], DIVIDE ( [@c], [@p] ) ) )
VAR _nS = COUNTROWS ( FILTER ( _k, [@e] = "S" ) ) + 0
VAR _nC = COUNTROWS ( FILTER ( _k, [@e] = "C" ) ) + 0
VAR _top = TOPN ( 3, _k, [@k], DESC )
VAR _cards =
    CONCATENATEX (
        _top,
        VAR _s = [@e] = "S"
        VAR _col = IF ( _s, "#C62828", "#9A6700" )
        VAR _bg = IF ( _s, "#FBEAEA", "#FEF4DC" )
        RETURN
            "<div style='flex:1 1 0;min-width:0;background:" & _bg & ";border-radius:6px;padding:5px 12px'>"
            & "<div style='display:flex;justify-content:space-between;gap:8px'>"
            & "<span style='font-weight:700;font-size:13px;color:#1B2433;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>" & TRIM ( Dim_categoria[Descripción] ) & "</span>"
            & "<span style='font-weight:700;font-size:13px;color:" & _col & "'>" & FORMAT ( DIVIDE ( [@c], [@p] ), "0%" ) & "</span></div>"
            & "<div style='font-size:11.5px;color:#5A6475'>" & Dim_categoria[Tipo costo] & " › " & TRIM ( Dim_categoria[Desc_N2] ) & "</div>"
            & "<div style='font-size:11.5px;font-weight:600;color:" & _col & "'>"
            & IF ( _s,
                "+$ " & FORMAT ( ( [@c] - [@p] ) / 1E6, "#,##0.0" ) & " mill. sobre el presupuesto",
                "Disponible $ " & FORMAT ( ( [@p] - [@c] ) / 1E6, "#,##0.0" ) & " mill." )
            & "</div></div>",
        "",
        [@k], DESC
    )
VAR _bell = "<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#C62828' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9'/><path d='M13.7 21a2 2 0 0 1-3.4 0'/></svg>"
VAR _txt =
    IF ( _nS > 0, _nS & IF ( _nS = 1, " línea del REE sobre el presupuesto", " líneas del REE sobre el presupuesto" ), "" )
    & IF ( _nS > 0 && _nC > 0, " · ", "" )
    & IF ( _nC > 0, _nC & " cerca del límite", "" )
RETURN
    "<div style='font-family:Segoe UI,sans-serif;padding-top:0'>"
    & IF (
        _nS + _nC = 0,
        "<div style='font-size:13px;color:#2F7A17;font-weight:600'>Sin alertas de presupuesto: ninguna línea del REE supera el 80% de su presupuesto anual.</div>",
        "<div style='display:flex;align-items:center;gap:8px;margin-bottom:6px'>" & _bell
            & "<span style='font-size:14px;font-weight:700;color:#1B2433'>Alertas de presupuesto</span>"
            & "<span style='font-size:13px;color:#5A6475'>· " & _txt & "</span></div>"
            & "<div style='display:flex;gap:10px'>" & _cards & "</div>"
    )
    & "</div>"

MEASURE '_Medidas'[Alertas cantidad] =
VAR _t =
    ADDCOLUMNS (
        FILTER ( ALL ( Dim_categoria ), UPPER ( Dim_categoria[TieneHijos] & "" ) = "FALSE" ),
        "@c", [Consumo Total],
        "@p", [Presupuesto Anual]
    )
RETURN
    COUNTROWS ( FILTER ( _t, ( [@p] > 0 && [@c] >= 0.8 * [@p] ) || ( NOT ( [@p] > 0 ) && [@c] > 0 ) ) ) + 0

MEASURE '_Medidas'[Alertas centro html] =
VAR _t =
    ADDCOLUMNS (
        FILTER ( ALL ( Dim_categoria ), UPPER ( Dim_categoria[TieneHijos] & "" ) = "FALSE" ),
        "@c", [Consumo Total],
        "@p", [Presupuesto Anual]
    )
VAR _e =
    ADDCOLUMNS (
        _t,
        "@e",
            IF ( [@p] > 0 && [@c] >= [@p], "S",
                IF ( [@p] > 0 && [@c] >= 0.8 * [@p], "C",
                    IF ( NOT ( [@p] > 0 ) && [@c] > 0, "P", "" ) ) )
    )
VAR _a = FILTER ( _e, [@e] <> "" )
VAR _k =
    ADDCOLUMNS (
        _a,
        "@x", IF ( [@e] = "S", [@c] - [@p], IF ( [@e] = "P", [@c], 0 ) ),
        "@k", IF ( [@e] = "S", 1E13 + [@c] - [@p], IF ( [@e] = "P", 1E13 + [@c], DIVIDE ( [@c], [@p] ) ) )
    )
VAR _nS = COUNTROWS ( FILTER ( _k, [@e] = "S" ) ) + 0
VAR _nP = COUNTROWS ( FILTER ( _k, [@e] = "P" ) ) + 0
VAR _nC = COUNTROWS ( FILTER ( _k, [@e] = "C" ) ) + 0
VAR _vS = SUMX ( FILTER ( _k, [@e] = "S" ), [@x] ) + 0
VAR _vP = SUMX ( FILTER ( _k, [@e] = "P" ), [@x] ) + 0
VAR _vC = SUMX ( FILTER ( _k, [@e] = "C" ), [@p] - [@c] ) + 0
VAR _m = "#,##0.0"
VAR _box = "border:1px solid #E3E8EF;border-radius:6px;padding:12px 16px;flex:1 1 0"
VAR _cont =
    "<div style='display:flex;gap:14px;margin-bottom:16px'>"
    & "<div style='" & _box & ";border-top:4px solid #C62828'><div style='font-size:13px;color:#5A6475'>Sobrepresupuestadas</div>"
    & "<div><span style='font-size:28px;font-weight:700;color:#C62828'>" & _nS & "</span>"
    & "<span style='font-size:13px;color:#5A6475;margin-left:10px'>$ " & FORMAT ( _vS / 1E6, _m ) & " mill. sobre el presupuesto</span></div></div>"
    & "<div style='" & _box & ";border-top:4px solid #7B1E3A'><div style='font-size:13px;color:#5A6475'>Sin presupuesto y gastando</div>"
    & "<div><span style='font-size:28px;font-weight:700;color:#7B1E3A'>" & _nP & "</span>"
    & "<span style='font-size:13px;color:#5A6475;margin-left:10px'>$ " & FORMAT ( _vP / 1E6, _m ) & " mill. sin presupuesto asignado</span></div></div>"
    & "<div style='" & _box & ";border-top:4px solid #F8AA00'><div style='font-size:13px;color:#5A6475'>Cerca del límite (80% – 99%)</div>"
    & "<div><span style='font-size:28px;font-weight:700;color:#9A6700'>" & _nC & "</span>"
    & "<span style='font-size:13px;color:#5A6475;margin-left:10px'>"
    & IF ( _nC = 0, "Sin líneas en este rango", "$ " & FORMAT ( _vC / 1E6, _m ) & " mill. disponibles" )
    & "</span></div></div></div>"
VAR _th = "<th style='text-align:left;padding:9px 10px;font-weight:600;white-space:nowrap'>"
VAR _thr = "<th style='text-align:right;padding:9px 10px;font-weight:600;white-space:nowrap'>"
VAR _td = "<td style='padding:10px;border-bottom:1px solid #E3E8EF;vertical-align:top'>"
VAR _tdr = "<td style='padding:10px;border-bottom:1px solid #E3E8EF;text-align:right;white-space:nowrap;vertical-align:top'>"
VAR _rows =
    CONCATENATEX (
        _k,
        VAR _st = [@e]
        VAR _col = SWITCH ( _st, "S", "#C62828", "P", "#7B1E3A", "#9A6700" )
        VAR _lab = SWITCH ( _st, "S", "Sobrepresupuestada", "P", "Sin presupuesto", "Cerca del límite" )
        VAR _id = Dim_categoria[Id categoria]
        VAR _nom = TRIM ( Dim_categoria[Descripción] )
        VAR _ruta =
            Dim_categoria[Tipo costo] & " › " & TRIM ( Dim_categoria[Desc_N2] )
            & IF ( Dim_categoria[Nivel] = 3, " › " & _nom, "" )
        VAR _docs =
            CALCULATETABLE (
                ADDCOLUMNS (
                    SUMMARIZE ( Fact_bitacora_documental, Fact_bitacora_documental[Tipo de documento], Fact_bitacora_documental[N° documento] ),
                    "@v", [Consumo detalle]
                ),
                REMOVEFILTERS ( Dim_categoria ),
                Dim_subseco[Id categoria] = _id
            )
        VAR _nd = COUNTROWS ( _docs ) + 0
        VAR _drv =
            MAXX (
                TOPN ( 1, _docs, [@v], DESC ),
                Fact_bitacora_documental[Tipo de documento] & " " & Fact_bitacora_documental[N° documento]
                    & " · $ " & FORMAT ( [@v] / 1E6, _m ) & " mill."
            )
        RETURN
            "<tr>"
            & _td & "<span style='display:inline-flex;align-items:center;gap:6px;font-weight:600;color:" & _col & ";white-space:nowrap'>"
            & "<span style='width:9px;height:9px;border-radius:50%;background:" & _col & ";display:inline-block'></span>" & _lab & "</span></td>"
            & _td & "<b>" & Dim_categoria[Codigo] & " " & _nom & "</b></td>"
            & _td & "<span style='color:#5A6475'>" & _ruta & "</span></td>"
            & _tdr & "$ " & FORMAT ( [@c] / 1E6, _m ) & " mill.</td>"
            & _tdr & "<span style='color:#6156A1'>$ " & FORMAT ( [@p] / 1E6, _m ) & " mill.</span></td>"
            & _tdr & "<b style='color:" & _col & "'>" & IF ( _st = "P", "—", FORMAT ( DIVIDE ( [@c], [@p] ), "0%" ) ) & "</b></td>"
            & _tdr & "<b style='color:" & _col & "'>" & IF ( _st = "C", "Disponible $ " & FORMAT ( ( [@p] - [@c] ) / 1E6, _m ) & " mill.", "+$ " & FORMAT ( [@x] / 1E6, _m ) & " mill." ) & "</b></td>"
            & _td & IF ( _nd = 0, "<span style='color:#5A6475'>Sin documentos en la bitácora</span>",
                    _drv & "<br><span style='color:#5A6475;font-size:12px'>Mayor de " & _nd & IF ( _nd = 1, " documento", " documentos" ) & "</span>" ) & "</td>"
            & "</tr>",
        "",
        [@k], DESC
    )
VAR _tabla =
    "<table style='width:100%;border-collapse:collapse;font-size:13px;color:#1B2433'>"
    & "<thead><tr style='background:#164479;color:#FFFFFF'>"
    & _th & "Estado</th>" & _th & "Línea REE</th>" & _th & "Ruta en la gráfica</th>"
    & _thr & "Consumo</th>" & _thr & "Presupuesto</th>" & _thr & "%</th>" & _thr & "Por fuera del ppto</th>"
    & _th & "Lo explica</th></tr></thead><tbody>" & _rows & "</tbody></table>"
RETURN
    "<div style='font-family:Segoe UI,sans-serif;color:#1B2433'>" & _cont
    & IF ( _nS + _nP + _nC = 0,
        "<div style='font-size:14px;color:#2F7A17;font-weight:600;padding:16px'>Sin alertas de presupuesto en este corte.</div>",
        _tabla
        & "<div style='font-size:12px;color:#5A6475;margin-top:10px'>Ordenadas por el monto que está por fuera del presupuesto. La ruta es el camino en la gráfica &quot;Consumo presupuesto por categoría REE&quot; para llegar a la barra en rojo.</div>" )
    & "</div>"

EVALUATE ROW ( "cant", [Alertas cantidad], "franja", LEN ( [Alertas franja html] ), "centro", LEN ( [Alertas centro html] ) )
